@namespace GoldEx.Calculator.Client.Components
@using GoldEx.Calculator.Client.ViewModels
@inherits GoldExComponentBase

<MudCard Elevation="@Elevation" Class="@($"pa-4 {Class}")">
    <MudGrid Spacing="3">
        <!-- پنل تنظیم نرخ بازار و پله‌های خرید -->
        <MudItem xs="12" lg="7">
            <MudPaper Outlined="true" Class="pa-4 h-100 rounded-lg">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3 pb-2 border-b">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">پله‌های خرید و سرمایه‌گذاری طلا</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">ثبت خریدهای مختلف در قیمت‌های متفاوت جهت محاسبه میانگین قیمت تمام‌شده</MudText>
                        </div>
                    </div>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddPurchaseItem">
                        افزودن پله جدید
                    </MudButton>
                </div>

                <div class="d-flex align-center gap-3 mb-3 pa-2 rounded-lg" style="background: rgba(0, 0, 0, 0.03);">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.LiveGramPrice"
                                     Label="نرخ روز هر گرم طلای ۱۸"
                                     Format="#,##0.##"
                                     HideSpinButtons="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.End"
                                     AdornmentText="تومان"
                                     dir="ltr"
                                     Class="flex-grow-1" />

                    <MudNumericField T="decimal"
                                     @bind-Value="_model.SalesFeePercent"
                                     Label="کارمزد فروش (%)"
                                     Format="0.###"
                                     HideSpinButtons="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.End"
                                     AdornmentText="%"
                                     dir="ltr"
                                     Style="max-width: 140px;" />
                </div>

                <div class="d-flex flex-column gap-2 overflow-y-auto" style="max-height: 380px;">
                    @for (var i = 0; i < _model.Purchases.Count; i++)
                    {
                        var item = _model.Purchases[i];
                        var index = i;

                        <div class="d-flex align-center gap-2 flex-wrap pa-2 border rounded-lg" style="background: rgba(0, 0, 0, 0.02);">
                            <MudTextField @bind-Value="item.Title"
                                          Label="عنوان پله"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="max-width: 150px;" />

                            <MudNumericField T="decimal"
                                             @bind-Value="item.WeightGrams"
                                             Label="وزن (گرم)"
                                             Format="0.###"
                                             HideSpinButtons="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Adornment="Adornment.End"
                                             AdornmentText="گرم"
                                             dir="ltr"
                                             Style="max-width: 130px;" />

                            <MudNumericField T="decimal"
                                             @bind-Value="item.BuyGramPrice"
                                             Label="قیمت خرید هر گرم"
                                             Format="#,##0.##"
                                             HideSpinButtons="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Adornment="Adornment.End"
                                             AdornmentText="تومان"
                                             dir="ltr"
                                             Class="flex-grow-1" />

                            <div class="d-flex flex-column justify-center px-1">
                                <span style="font-size: 0.72rem; color: #71717a;">کل پرداخت:</span>
                                <span class="font-weight-bold" style="font-size: 0.82rem; direction: ltr;">@item.TotalCost.ToString("N0")</span>
                            </div>

                            @if (_model.Purchases.Count > 1)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="() => RemovePurchaseItem(index)" />
                            }
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- پنل تحلیل سود/زیان و نقطه سربه سر -->
        <MudItem xs="12" lg="5">
            <MudPaper Outlined="true" Class="pa-4 h-100 d-flex flex-column justify-space-between rounded-lg">
                <div>
                    <div class="d-flex align-center gap-2 mb-3 pb-2 border-b">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Success" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">تحلیل بازدهی و نقطه سر‌به‌سر</MudText>
                    </div>

                    <!-- کارت سود / زیان اصلی -->
                    @{
                        var isProfitable = _model.NetProfitLossAmount >= 0;
                    }
                    <div class="pa-3 rounded-lg mb-3 text-center" style="background: @(isProfitable ? "rgba(16, 185, 129, 0.12)" : "rgba(239, 68, 68, 0.12)"); border: 1px solid @(isProfitable ? "rgba(16, 185, 129, 0.4)" : "rgba(239, 68, 68, 0.4)");">
                        <span style="font-size: 0.85rem; color: #71717a;">سود / زیان کل پورتفوی طلا:</span>
                        <div class="d-flex justify-center align-center gap-2 my-1">
                            <MudIcon Icon="@(isProfitable ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                     Color="@(isProfitable ? Color.Success : Color.Error)" />
                            <span class="font-weight-black" style="font-size: 1.4rem; color: @(isProfitable ? "#10b981" : "#ef4444"); direction: ltr;">
                                @(isProfitable ? "+" : "")@_model.NetProfitLossAmount.ToString("N0") تومان
                            </span>
                        </div>
                        <span class="font-weight-bold" style="font-size: 0.95rem; color: @(isProfitable ? "#10b981" : "#ef4444");">
                            بازدهی: @(isProfitable ? "+" : "")@_model.NetProfitLossPercent.ToString("0.##")%
                        </span>
                    </div>

                    <div class="d-flex flex-column gap-2 mb-3" style="font-size: 0.88rem;">
                        <div class="d-flex justify-space-between align-center pa-2 border-b">
                            <span class="text-secondary">کل وزن طلای اندوخته:</span>
                            <span class="font-weight-bold">@_model.TotalWeight.ToString("0.###") گرم</span>
                        </div>

                        <div class="d-flex justify-space-between align-center pa-2 border-b">
                            <span class="text-secondary">کل سرمایه‌گذاری شده:</span>
                            <span class="font-weight-bold">@_model.TotalInvested.ToString("N0") تومان</span>
                        </div>

                        <div class="d-flex justify-space-between align-center pa-2 border-b">
                            <span class="text-secondary">میانگین موزون قیمت خرید:</span>
                            <span class="font-weight-black" style="color: var(--mud-palette-primary);">
                                @_model.WeightedAverageBuyPrice.ToString("N0") تومان
                            </span>
                        </div>

                        <div class="d-flex justify-space-between align-center pa-2 border-b">
                            <span class="text-secondary">ارزش روز دارایی:</span>
                            <span class="font-weight-bold">@_model.CurrentMarketValue.ToString("N0") تومان</span>
                        </div>

                        <div class="d-flex justify-space-between align-center pa-2 rounded-lg" style="background: rgba(212, 175, 55, 0.1);">
                            <span class="font-weight-bold text-secondary">قیمت سر‌به‌سر فروش (با کارمزد):</span>
                            <span class="font-weight-black" style="color: #d97706; font-size: 1.05rem;">
                                @_model.BreakEvenGramPrice.ToString("N0") تومان
                            </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-end mt-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.BookmarkAdd"
                               OnClick="SaveToHistoryAsync">
                        ذخیره در تاریخچه
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudCard>
