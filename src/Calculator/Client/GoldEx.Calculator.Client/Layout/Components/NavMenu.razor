@namespace GoldEx.Calculator.Client.Layout.Components
@inherits GoldExComponentBase

<MudNavMenu Bordered Margin="Margin.Dense" Color="Color.Primary">
    <MudNavLink Href="@ClientRoutes.Home.Index" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Calculate" IconColor="Color.Warning">
        طلا و جواهر
    </MudNavLink>

    <MudNavLink Href="@ClientRoutes.Calculator.TradeIn" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.SwapHorizontalCircle" IconColor="Color.Primary">
        تعویض طلا
    </MudNavLink>

    <MudNavLink Href="@ClientRoutes.Calculator.CoinBubble" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.MonetizationOn" IconColor="Color.Success">
        حباب سکه
    </MudNavLink>

    <MudNavLink Href="@ClientRoutes.Calculator.Assay" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Science" IconColor="Color.Info">
        عیارسنجی و ۷۵۰
    </MudNavLink>

    <MudNavLink Href="@ClientRoutes.Calculator.Dca" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.TrendingUp" IconColor="Color.Secondary">
        میانگین خرید
    </MudNavLink>

    <MudNavLink Href="@ClientRoutes.Calculator.Reverse" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.SwapHoriz" IconColor="Color.Success">
        ارز به طلا
    </MudNavLink>

    <MudNavLink Href="@ClientRoutes.Calculator.Currency" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.CurrencyExchange" IconColor="Color.Error">
        تبدیل ارز
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="@ClientRoutes.Invoices.Index" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.LibraryBooks" IconColor="Color.Primary">
                فاکتورها
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <MudNavLink Href="@ClientRoutes.About.Index" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Info" IconColor="Color.Tertiary">
        درباره ما
    </MudNavLink>
</MudNavMenu>

@code
{
    [Parameter] public EventCallback<bool> OnNavigate { get; set; }
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await OnNavigate.InvokeAsync(false);
        StateHasChanged();
    }

    public override ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        return base.DisposeAsync();
    }
}
