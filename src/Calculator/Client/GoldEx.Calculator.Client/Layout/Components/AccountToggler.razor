@using GoldEx.Shared.Routings
@using ClientRoutes = GoldEx.Shared.Routings.ClientRoutes

@inherits GoldExComponentBase

@if (_loggedIn)
{
    <MudTooltip Text="خروج از حساب کاربری" Arrow="true">
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Color="Color.Inherit"
                       Title="خروج از حساب"
                       Href="@ApiUrls.Account.Logout(_currentUrl)" />
    </MudTooltip>
}
else
{
    <MudTooltip Text="ورود به حساب کاربری" Arrow="true">
        <MudIconButton Icon="@Icons.Material.Filled.Login"
                       Color="Color.Inherit"
                       Title="ورود به حساب"
                       Href="@ClientRoutes.Accounts.Login" />
    </MudTooltip>
}

@code {
    private bool _loggedIn;
    private string? _currentUrl;

    [Parameter] public string? Class { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _loggedIn = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated is true;

        AuthenticationStateProvider.AuthenticationStateChanged += async (task) =>
        {
            var authState = await task;
            _loggedIn = authState.User.Identity?.IsAuthenticated is true;
            StateHasChanged();
        };

        await base.OnInitializedAsync();
    }

    protected override void OnInitialized()
    {
        _currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = Navigation.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
}