@inherits GoldExComponentBase

@if (!IsBusy && !_items.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" ContentAlignment="HorizontalAlignment.Start">نرخی برای نمایش ثبت نشده است.</MudAlert>
}
else
{
    <div class="dash-market-grid" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
        @if (IsBusy)
        {
            @for (var i = 0; i < 8; i++)
            {
                <PriceCardSkeleton />
            }
        }
        else
        {
            @foreach (var item in _items)
            {
                <PriceCard @key="item.Id"
                           Id="@item.Id"
                           Title="@item.Title"
                           ImageUrl="@(ApiUrls.Icons.Get(IconType.Price, item.Id))"
                           ChangePercent="@ExtractPercentChange(item.Change)"
                           Price="@item.Value"
                           PriceUnit="@item.Unit"
                           DateTime="@item.LastUpdate" />
            }
        }
    </div>
}
