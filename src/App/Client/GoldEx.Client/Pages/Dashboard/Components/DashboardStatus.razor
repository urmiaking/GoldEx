@if (Loading)
{
    <div class="dash-loading" role="status" aria-label="در حال دریافت آمار">
        <MudSkeleton Width="36%" Height="30px" />
        <MudSkeleton Width="100%" Height="150px" />
    </div>
}
else
{
    <div class="dash-empty" role="status">
        <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
        <span>اطلاعات این بخش دریافت نشد.</span>
        <MudButton OnClick="Retry" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh">تلاش دوباره</MudButton>
    </div>
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
}
