@using GoldEx.Shared.DTOs.CheckPayments
@using GoldEx.Shared.Enums
@using GoldEx.Shared.Helpers
@inherits GoldExComponentBase
<section class="finance-directory" aria-label="مدیریت چک‌ها">
 <header class="finance-heading">
  <div><h1>مدیریت چک‌ها <span class="finance-count">@(_loading ? "…" : $"{_total:N0} چک")</span></h1>
   <p>پیگیری سررسید، وصول و برگشت چک‌های بانکی</p></div>
 </header>
 <div class="finance-filters"><div class="finance-toolbar">
  <MudTextField T="string" Value="_searchString" ValueChanged="OnSearch" Immediate="true" DebounceInterval="450" Clearable="true"
                Label="جستجوی چک" Placeholder="شماره چک، شناسه صیادی یا نام صادرکننده"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
  <MudButton Variant="Variant.Outlined" Class="finance-filter-button" StartIcon="@Icons.Material.Outlined.Tune"
             Color="@(ActiveFilterCount > 0 ? Color.Primary : Color.Default)" OnClick="OpenMobileFilters" aria-label="فیلتر چک‌ها">
   <span class="finance-filter-label">فیلترها</span>
   @if(ActiveFilterCount > 0){<span class="finance-filter-count">@ActiveFilterCount</span>}
  </MudButton>
  <MudSelect T="string" Class="finance-sort" Label="مرتب‌سازی بر اساس" Value="_sortLabel"
             Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ValueChanged="OnSortChanged">
   <MudSelectItem Value="@("DueDate")">تاریخ سررسید</MudSelectItem>
   <MudSelectItem Value="@("Amount")">مبلغ چک</MudSelectItem>
   <MudSelectItem Value="@("IssuerFullName")">صادرکننده</MudSelectItem>
   <MudSelectItem Value="@("Number")">شماره چک</MudSelectItem>
  </MudSelect>
  <div class="finance-sort-direction"><MudIconButton Icon="@(_sortDescending ? Icons.Material.Filled.South : Icons.Material.Filled.North)"
                   OnClick="ToggleSortDirection" aria-label="تغییر جهت مرتب‌سازی" /></div>
 </div></div>
 <div class="finance-results" aria-busy="@_loading">
  @if(_loading)
  {
   <div class="finance-skeleton" role="status" aria-label="در حال بارگذاری">@for(var i=0;i<5;i++){<span></span>}</div>
  }
  else if(_loadFailed || _items.Count == 0)
  {
   <div class="finance-empty">
    <MudIcon Icon="@(_loadFailed ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.Receipt)" />
    <strong>@(_loadFailed ? "دریافت چک‌ها انجام نشد" : "چکی با این مشخصات یافت نشد")</strong>
    <p>@(_loadFailed ? "اتصال را بررسی کنید." : "جستجو یا فیلتر را تغییر دهید.")</p>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(_loadFailed ? LoadAsync : ResetFilters)">
     @(_loadFailed ? "تلاش دوباره" : "پاک کردن فیلترها")
    </MudButton>
   </div>
  }
  else
  {
   <div class="finance-desktop"><table class="finance-table">
    <thead><tr><th>صادرکننده</th><th>شماره چک</th><th>صیادی</th><th>سررسید</th><th>مبلغ</th><th>فاکتور</th><th>وضعیت</th><th>عملیات</th></tr></thead>
    <tbody>
     @foreach(var item in _items)
     {
      <tr @key="item.Id" class="@(IsOverdue(item) ? "finance-overdue" : "")">
       <td><div class="finance-person"><strong>@item.IssuerFullName</strong><small>@item.IssuerPhoneNumber</small></div></td>
       <td><span class="finance-number">@item.Number</span></td>
       <td>@item.SayadiCode</td>
       <td>@item.DueDate.ToShortDateString()</td>
       <td><strong class="finance-money">@item.Amount.ToCurrencyFormat(item.PriceUnit)</strong></td>
       <td>@item.InvoiceNumber <small>@item.InvoiceType.GetDisplayName()</small></td>
       <td><span class="finance-status @StatusClass(item.CurrentStatus)">@item.CurrentStatus.GetDisplayName()</span></td>
       <td><div class="finance-actions">
        <button type="button" title="جزئیات چک" aria-label="جزئیات چک" @onclick="() => OnViewCheck(item)"><ShellIcon Name="eye" /></button>
        @if(item.CurrentStatus == CheckPaymentStatus.Pending)
        {
         <button type="button" class="is-success" title="وصول چک" aria-label="وصول چک" @onclick="() => OnAcceptCheck(item)"><ShellIcon Name="check" /></button>
         <button type="button" class="is-danger" title="برگشت چک" aria-label="برگشت چک" @onclick="() => OnReturnCheck(item)"><ShellIcon Name="close" /></button>
        }
       </div></td>
      </tr>
     }
    </tbody>
   </table></div>
   <div class="finance-mobile">
    @foreach(var item in _items)
    {
     <article class="finance-card @(IsOverdue(item) ? "finance-overdue" : "")" @key="item.Id">
      <header><span class="finance-number">چک @item.Number</span><time>سررسید @item.DueDate.ToShortDateString()</time>
       <span class="finance-status @StatusClass(item.CurrentStatus)">@item.CurrentStatus.GetDisplayName()</span></header>
      <div class="finance-card-main">
       <div class="finance-person"><small>صادرکننده</small><strong>@item.IssuerFullName</strong></div>
       <strong class="finance-money">@item.Amount.ToCurrencyFormat(item.PriceUnit)</strong>
      </div>
      <div class="finance-card-meta">
       <span>صیادی: @item.SayadiCode</span>
       @if(item.InvoiceNumber > 0){ <span>فاکتور @item.InvoiceNumber</span> }
      </div>
      <footer><span>@item.IssuerFinancialAccountName</span><div class="finance-actions">
       <button type="button" title="جزئیات چک" aria-label="جزئیات چک" @onclick="() => OnViewCheck(item)"><ShellIcon Name="eye" /></button>
       @if(item.CurrentStatus == CheckPaymentStatus.Pending)
       {
        <button type="button" class="is-success" title="وصول چک" aria-label="وصول چک" @onclick="() => OnAcceptCheck(item)"><ShellIcon Name="check" /></button>
        <button type="button" class="is-danger" title="برگشت چک" aria-label="برگشت چک" @onclick="() => OnReturnCheck(item)"><ShellIcon Name="close" /></button>
       }
      </div></footer>
     </article>
    }
   </div>
  }
 </div>
 <footer class="finance-pagination">
  <label>تعداد ردیف<select value="@_pageSize" @onchange="ChangePageSize" aria-label="تعداد چک در صفحه">
   <option value="10">۱۰</option><option value="25">۲۵</option><option value="50">۵۰</option>
  </select></label>
  <nav><button type="button" disabled="@(_loading || _pageIndex == 0)" @onclick="() => ChangePage(-1)">قبلی</button>
   <span>@(_pageIndex + 1) از @PageCount</span>
   <button type="button" disabled="@(_loading || _pageIndex + 1 >= PageCount)" @onclick="() => ChangePage(1)">بعدی</button>
  </nav>
 </footer>
</section>