@using GoldEx.Client.Components.Components.Dialogs
@using GoldEx.Shared.Enums
@using GoldEx.Shared.Helpers
@inherits GoldExComponentBase
<EditorDialogFrame>
 <DialogContent><div class="gex-directory-filter-form">
  <MudGrid Spacing="3">
   <MudItem xs="12" sm="6">
    <MudDateRangePicker DateRange="_dateRange" DateRangeChanged="@(r => _dateRange = r)" Label="تاریخ سررسید"
      Variant="Variant.Outlined" Margin="Margin.Dense" DisplayMonths="1" MaxMonthColumns="1" ShowToolbar="false"
      Adornment="Adornment.Start" Clearable="true" Class="w-100 gex-filter-date-range" />
   </MudItem>
   <MudItem xs="12" sm="6">
    <MudSelect T="CheckPaymentStatus?" Label="وضعیت چک" Value="_paymentStatus" ValueChanged="@(s => _paymentStatus = s)"
       Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@GetPaymentStatusIcon(_paymentStatus)" Class="w-100">
     <MudSelectItem T="CheckPaymentStatus?" Value="@(null as CheckPaymentStatus?)">همه چک‌ها</MudSelectItem>
     <MudSelectItem T="CheckPaymentStatus?" Value="@((CheckPaymentStatus?)CheckPaymentStatus.Pending)">@CheckPaymentStatus.Pending.GetDisplayName()</MudSelectItem>
     <MudSelectItem T="CheckPaymentStatus?" Value="@((CheckPaymentStatus?)CheckPaymentStatus.Accepted)">@CheckPaymentStatus.Accepted.GetDisplayName()</MudSelectItem>
     <MudSelectItem T="CheckPaymentStatus?" Value="@((CheckPaymentStatus?)CheckPaymentStatus.Returned)">@CheckPaymentStatus.Returned.GetDisplayName()</MudSelectItem>
    </MudSelect>
   </MudItem>
   <MudItem xs="12" sm="6" Class="gex-filter-mobile-sort">
    <MudSelect T="string" Label="مرتب‌سازی بر اساس" Value="_sortLabel" ValueChanged="@(s => _sortLabel = s)"
       Variant="Variant.Outlined" Margin="Margin.Dense">
     <MudSelectItem Value="@("DueDate")">تاریخ سررسید</MudSelectItem>
     <MudSelectItem Value="@("Amount")">مبلغ چک</MudSelectItem>
     <MudSelectItem Value="@("IssuerFullName")">صادرکننده</MudSelectItem>
     <MudSelectItem Value="@("Number")">شماره چک</MudSelectItem>
    </MudSelect>
   </MudItem>
   <MudItem xs="12" sm="6" Class="gex-filter-mobile-sort">
    <MudSelect T="bool" Label="ترتیب نمایش" @bind-Value="_descending" Variant="Variant.Outlined" Margin="Margin.Dense">
     <MudSelectItem T="bool" Value="true">نزولی</MudSelectItem>
     <MudSelectItem T="bool" Value="false">صعودی</MudSelectItem>
    </MudSelect>
   </MudItem>
  </MudGrid>
 </div></DialogContent>
 <DialogActions>
  <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Delete" OnClick="Clear">بازنشانی</MudButton>
  <MudSpacer /><MudButton Variant="Variant.Outlined" OnClick="Cancel">انصراف</MudButton>
  <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" OnClick="Apply">اعمال فیلترها</MudButton>
 </DialogActions>
</EditorDialogFrame>