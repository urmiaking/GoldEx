@using GoldEx.Shared.DTOs.CustomerTransfers
@using GoldEx.Shared.Helpers
@inherits GoldExComponentBase

<section @ref="_directory" class="transfer-directory" aria-label="حواله‌های بین مشتریان">
    <header class="transfer-heading">
        <div><h1>حواله‌های بین مشتریان <span class="transfer-count">@(_loading ? "…" : $"{_totalItems:N0} حواله")</span></h1>
            <p>مدیریت حواله‌های وجه و طلا بین مشتریان</p></div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="transfer-create"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OnCreate">حواله جدید</MudButton>
    </header>
    <div @ref="_filterBar" class="transfer-filters">
        <div class="transfer-toolbar">
            <div class="transfer-search">
                <MudTextField T="string" Value="SearchQuery" ValueChanged="OnSearch" Immediate="true"
                              DebounceInterval="450" Clearable="true" Label="جستجوی حواله"
                              Placeholder="شماره حواله، نام مشتری یا شرح"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudButton Class="transfer-filter-button" Variant="Variant.Outlined"
                       Color="@(ActiveFilterCount > 0 ? Color.Primary : Color.Default)"
                       StartIcon="@Icons.Material.Outlined.Tune" OnClick="OpenFilters"
                       aria-label="فیلتر حواله‌ها">
                <span class="transfer-filter-label">فیلترها</span>
                @if (ActiveFilterCount > 0) { <span class="transfer-filter-count">@ActiveFilterCount</span> }
            </MudButton>
            <div class="transfer-sort">
                <MudSelect T="string" Label="مرتب‌سازی بر اساس" Value="_sortLabel" ValueChanged="OnSortChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="@("TransferDate")">تاریخ حواله</MudSelectItem>
                    <MudSelectItem Value="@("VoucherNumber")">شماره حواله</MudSelectItem>
                    <MudSelectItem Value="@("Amount")">مبلغ / وزن</MudSelectItem>
                </MudSelect>
            </div>
            <MudTooltip Text="@(_sortDescending ? "مرتب‌سازی صعودی" : "مرتب‌سازی نزولی")">
                <MudIconButton Icon="@(_sortDescending ? Icons.Material.Filled.South : Icons.Material.Filled.North)"
                               Class="transfer-sort-direction" OnClick="ToggleSortDirection" aria-label="تغییر جهت مرتب‌سازی" />
            </MudTooltip>
        </div>
    </div>
    <div class="transfer-results" aria-busy="@(_loading ? "true" : "false")">
        @if (_loading)
        {
            <div class="transfer-loading" role="status" aria-label="در حال بارگیری حواله‌ها">
                @for (var i = 0; i < 5; i++)
                { <div class="transfer-skeleton"><span></span><span></span><span></span><span></span></div> }
            </div>
        }
        else if (_loadFailed)
        {
            <div class="transfer-empty" role="alert">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
                <strong>دریافت حواله‌ها انجام نشد</strong>
                <p>اتصال را بررسی کنید و دوباره تلاش کنید.</p>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReloadAsync">تلاش دوباره</MudButton>
            </div>
        }
        else if (_items.Count == 0)
        {
            <div class="transfer-empty" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" Size="Size.Large" />
                <strong>حواله‌ای با این مشخصات پیدا نشد</strong>
                <p>جستجو یا فیلترها را تغییر دهید.</p>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ResetFilters">نمایش همه حواله‌ها</MudButton>
            </div>
        }
        else
        {
            <div class="transfer-desktop">
                <table class="transfer-table">
                    <thead><tr>
                        <th><button type="button" @onclick='() => ChangeSort("VoucherNumber")'>شماره <span>@SortIndicator("VoucherNumber")</span></button></th>
                        <th><button type="button" @onclick='() => ChangeSort("TransferDate")'>تاریخ <span>@SortIndicator("TransferDate")</span></button></th>
                        <th>فرستنده / گیرنده</th>
                        <th><button type="button" @onclick='() => ChangeSort("Amount")'>مبلغ / وزن <span>@SortIndicator("Amount")</span></button></th>
                        <th>فاکتورهای مرتبط</th>
                        <th>شرح</th>
                        <th>عملیات</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr @key="item.Id">
                                <td><span class="transfer-number">#@item.VoucherNumber</span></td>
                                <td><time title="@($"تاریخ ثبت: {item.CreatedAt:yyyy/MM/dd}")">@item.TransferDate.ToShortDateString()</time></td>
                                <td><div class="transfer-parties">
                                    <div class="transfer-party is-source"><MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" /><span>@item.SourceCustomerName</span></div>
                                    <div class="transfer-party is-destination"><MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" /><span>@item.DestinationCustomerName</span></div>
                                </div></td>
                                <td><strong class="transfer-amount">@item.Amount.ToCurrencyFormat(item.PriceUnitTitle)</strong></td>
                                <td><div class="transfer-invoices">
                                    @if (item.SourceInvoiceNumber.HasValue) { <span>مبدأ #@item.SourceInvoiceNumber</span> }
                                    @if (item.DestinationInvoiceNumber.HasValue) { <span>مقصد #@item.DestinationInvoiceNumber</span> }
                                    @if (!item.SourceInvoiceNumber.HasValue && !item.DestinationInvoiceNumber.HasValue) { <span>حواله مستقیم</span> }
                                </div></td>
                                <td><span class="transfer-description" title="@item.Description">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</span></td>
                                <td><div class="transfer-actions">
                                    <button type="button" class="is-edit" title="ویرایش حواله" aria-label="ویرایش حواله" @onclick="() => OnEdit(item)"><ShellIcon Name="edit" /></button>
                                    <button type="button" class="is-delete" title="حذف حواله" aria-label="حذف حواله" @onclick="() => OnDelete(item)"><ShellIcon Name="trash" /></button>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="transfer-mobile">
                @foreach (var item in _items)
                {
                    <article class="transfer-card" @key="item.Id">
                        <header class="transfer-card-top">
                            <div class="transfer-card-identity"><span class="transfer-number">#@item.VoucherNumber</span><time>@item.TransferDate.ToShortDateString()</time></div>
                            <strong class="transfer-card-money">@item.Amount.ToCurrencyFormat(item.PriceUnitTitle)</strong>
                        </header>
                        <div class="transfer-card-route" aria-label="فرستنده و گیرنده حواله">
                            <div class="transfer-card-party"><small>از</small><span>@item.SourceCustomerName</span></div>
                            <span class="transfer-card-route-divider" aria-hidden="true">/</span>
                            <div class="transfer-card-party"><small>به</small><span>@item.DestinationCustomerName</span></div>
                        </div>
                        @if (item.SourceInvoiceNumber.HasValue || item.DestinationInvoiceNumber.HasValue)
                        {
                            <div class="transfer-card-related">
                                @if (item.SourceInvoiceNumber.HasValue) { <span>فاکتور مبدأ #@item.SourceInvoiceNumber</span> }
                                @if (item.DestinationInvoiceNumber.HasValue) { <span>فاکتور مقصد #@item.DestinationInvoiceNumber</span> }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="transfer-card-note" title="@item.Description">@item.Description</p> }
                        <footer class="transfer-card-bottom">
                            <span>حواله بین مشتریان</span>
                            <div class="transfer-actions">
                                <button type="button" class="is-edit" title="ویرایش حواله" aria-label="ویرایش حواله" @onclick="() => OnEdit(item)"><ShellIcon Name="edit" /></button>
                                <button type="button" class="is-delete" title="حذف حواله" aria-label="حذف حواله" @onclick="() => OnDelete(item)"><ShellIcon Name="trash" /></button>
                            </div>
                        </footer>
                    </article>
                }
            </div>
        }
    </div>
    <footer class="transfer-pagination">
        <label>تعداد ردیف
            <select value="@_pageSize" @onchange="ChangePageSize" disabled="@_loading" aria-label="تعداد حواله در صفحه">
                <option value="10">۱۰</option><option value="25">۲۵</option><option value="50">۵۰</option>
            </select>
        </label>
        <nav aria-label="صفحه‌بندی حواله‌ها">
            <button type="button" disabled="@(_loading || _pageIndex <= 0)" @onclick="() => ChangePage(-1)"><ShellIcon Name="previous" /> قبلی</button>
            <span>@(_pageIndex + 1) از @PageCount</span>
            <button type="button" disabled="@(_loading || _pageIndex + 1 >= PageCount)" @onclick="() => ChangePage(1)">بعدی <ShellIcon Name="next" /></button>
        </nav>
    </footer>
</section>