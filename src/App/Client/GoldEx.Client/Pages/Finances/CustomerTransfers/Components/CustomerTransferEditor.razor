@using GoldEx.Client.Components.Components.Dialogs
@using GoldEx.Shared.DTOs.PriceUnits
@using GoldEx.Shared.DTOs.Invoices
@using GoldEx.Shared.Helpers
@using GoldEx.Shared.Routings
@using GoldEx.Shared.Enums
@inherits GoldExComponentBase

<MudForm Model="Model" @ref="@_form" Validation="@(Validator.ValidateValue)" ValidationDelay="0">
    <EditorDialogFrame>
        <DialogContent>
            <div class="transfer-editor-form">
            <MudGrid Spacing="3">
                <!-- Accounting Flow Preview Card -->
                <MudItem xs="12">
                    <MudPaper Class="transfer-editor-preview pa-3" Elevation="0">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Outlined.Preview" Size="Size.Small" />
                                پیش‌نمایش جریان سند و مانده حساب مشتریان
                            </MudText>
                        </div>
                        <MudGrid AlignItems="Center" Spacing="2">
                            <MudItem xs="12" sm="5">
                                <MudPaper Class="transfer-editor-account transfer-editor-account--source pa-3" Elevation="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">فرستنده (حواله‌دهنده / بدهکار)</MudText>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">
                                        @(Model.SourceCustomer?.FullName ?? "انتخاب نشده")
                                    </MudText>
                                    
                                    @if (Model.SourceCustomer != null)
                                    {
                                        <div class="mt-2 text-start px-2 py-1 rounded" style="background: rgba(0,0,0,0.03); font-size: 0.8rem;">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <span style="color: var(--mud-palette-text-secondary);">@(IsEditMode ? "مانده قبل از این حواله:" : "مانده فعلی:")</span>
                                                @if (_loadingSourceBalance)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width: 14px; height: 14px;" />
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="@GetBalanceColor(SourceBaseBalance)" Style="font-weight: 600;">
                                                        @GetBalanceLabel(SourceBaseBalance)
                                                    </MudText>
                                                }
                                            </div>
                                            <div class="d-flex justify-space-between align-center">
                                                <span style="color: var(--mud-palette-text-secondary);">@(IsEditMode ? "پس از ویرایش حواله:" : "پس از ثبت حواله:")</span>
                                                <MudText Typo="Typo.caption" Color="@GetBalanceColor(SourceProjectedBalance)" Style="font-weight: bold;">
                                                    @GetBalanceLabel(SourceProjectedBalance)
                                                </MudText>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="mt-1">
                                            کاهش طلب ما از مشتری
                                        </MudChip>
                                    }
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="2" Class="text-center">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Size="Size.Medium" />
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: bold;">
                                        @(Model.Amount > 0 ? Model.Amount.ToCurrencyFormat(Model.PriceUnit?.Title) : "مبلغ / وزن")
                                    </MudText>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" sm="5">
                                <MudPaper Class="transfer-editor-account transfer-editor-account--destination pa-3" Elevation="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">گیرنده (دریافت‌کننده / بستانکار)</MudText>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">
                                        @(Model.DestinationCustomer?.FullName ?? "انتخاب نشده")
                                    </MudText>

                                    @if (Model.DestinationCustomer != null)
                                    {
                                        <div class="mt-2 text-start px-2 py-1 rounded" style="background: rgba(0,0,0,0.03); font-size: 0.8rem;">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <span style="color: var(--mud-palette-text-secondary);">@(IsEditMode ? "مانده قبل از این حواله:" : "مانده فعلی:")</span>
                                                @if (_loadingDestBalance)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width: 14px; height: 14px;" />
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="@GetBalanceColor(DestBaseBalance)" Style="font-weight: 600;">
                                                        @GetBalanceLabel(DestBaseBalance)
                                                    </MudText>
                                                }
                                            </div>
                                            <div class="d-flex justify-space-between align-center">
                                                <span style="color: var(--mud-palette-text-secondary);">@(IsEditMode ? "پس از ویرایش حواله:" : "پس از ثبت حواله:")</span>
                                                <MudText Typo="Typo.caption" Color="@GetBalanceColor(DestProjectedBalance)" Style="font-weight: bold;">
                                                    @GetBalanceLabel(DestProjectedBalance)
                                                </MudText>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="mt-1">
                                            کاهش بدهی ما به مشتری
                                        </MudChip>
                                    }
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- Customers Selection -->
                <MudItem xs="12"><div class="transfer-editor-section"><MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" /><span>طرف‌های حواله</span></div></MudItem>
                <MudItem xs="12" md="6">
                    <div class="d-flex align-center gap-2">
                        <MudAutocomplete T="CustomerVm"
                                         Value="Model.SourceCustomer"
                                         ValueChanged="OnSourceCustomerChanged"
                                         Text="@Model.SourceCustomer?.FullName"
                                         For="@(() => Model.SourceCustomer!)"
                                         Placeholder="جستجوی فرستنده..."
                                         Label="مشتری فرستنده (حواله‌دهنده) *"
                                         ToStringFunc="@(c => c != null ? $"{c.FullName} - {c.CustomerType.GetDisplayName()}" : null)"
                                         Margin="Margin.Dense"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                         Variant="Variant.Outlined"
                                         SearchFunc="@SearchCustomers"
                                         ResetValueOnEmptyText="true"
                                         ShowProgressIndicator="false" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" OnClick='() => OnAddCustomer("فرستنده")' Size="Size.Medium" />
                    </div>
                </MudItem>

                <MudItem xs="12" md="6">
                    <div class="d-flex align-center gap-2">
                        <MudAutocomplete T="CustomerVm"
                                         Value="Model.DestinationCustomer"
                                         ValueChanged="OnDestCustomerChanged"
                                         Text="@Model.DestinationCustomer?.FullName"
                                         For="@(() => Model.DestinationCustomer!)"
                                         Placeholder="جستجوی گیرنده..."
                                         Label="مشتری گیرنده (دریافت‌کننده) *"
                                         ToStringFunc="@(c => c != null ? $"{c.FullName} - {c.CustomerType.GetDisplayName()}" : null)"
                                         Margin="Margin.Dense"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.PersonAddAlt1"
                                         Variant="Variant.Outlined"
                                         SearchFunc="@SearchCustomers"
                                         ResetValueOnEmptyText="true"
                                         ShowProgressIndicator="false" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" OnClick='() => OnAddCustomer("گیرنده")' Size="Size.Medium" />
                    </div>
                </MudItem>

                <!-- Asset Unit, Amount & Transfer Date -->
                <MudItem xs="12"><div class="transfer-editor-section"><MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" /><span>مشخصات حواله</span></div></MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="GetPriceUnitTitleResponse?"
                               Value="Model.PriceUnit"
                               ValueChanged="OnPriceUnitChanged"
                               Label="نوع دارایی / واحد قیمت *"
                               For="() => Model.PriceUnit"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined">
                        @foreach (var item in PriceUnits)
                        {
                            <MudSelectItem Value="item">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Small">
                                        <MudImage Src="@(ApiUrls.Icons.Get(IconType.PriceUnit, item.Id))" Alt="@item.Title" />
                                    </MudAvatar>
                                    <MudText>@item.Title</MudText>
                                </MudStack>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="@Model.Amount"
                                     dir="ltr"
                                     Immediate="true"
                                     Variant="Variant.Outlined"
                                     Label="مبلغ یا وزن حواله *"
                                     For="() => Model.Amount"
                                     Format="@(Model.PriceUnit?.IsGoldBased == true ? "#,##0.000" : "#,##0.##")"
                                     HideSpinButtons="true"
                                     Adornment="Adornment.End"
                                     AdornmentText="@Model.PriceUnit?.Title"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="@Model.TransferDate"
                                   Adornment="Adornment.Start"
                                   Class="transfer-editor-date w-100"
                                   Label="تاریخ حواله *"
                                   For="() => Model.TransferDate"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <!-- Optional Exchange Rate -->
                @if (Model.PriceUnit != null && PriceUnits.FirstOrDefault(x => x.IsDefault) != null && Model.PriceUnit.Id != PriceUnits.First(x => x.IsDefault).Id)
                {
                    <MudItem xs="12">
                        <MudNumericField T="decimal?"
                                         @bind-Value="@Model.ExchangeRate"
                                         dir="ltr"
                                         Variant="Variant.Outlined"
                                         Label="نرخ تبدیل به پایه"
                                         For="() => Model.ExchangeRate"
                                         Format="#,##0.##"
                                         HideSpinButtons="true"
                                         Adornment="Adornment.End"
                                         AdornmentText="@PriceUnits.FirstOrDefault(x => x.IsDefault)?.Title"
                                         Margin="Margin.Dense" />
                    </MudItem>
                }

                <!-- Optional Invoice Pickers -->
                <MudItem xs="12"><div class="transfer-editor-section"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" /><span>فاکتورهای مرتبط (اختیاری)</span></div></MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="GetTinyInvoiceResponse?"
                               @bind-Value="Model.SourceInvoice"
                               Label="فاکتور مبدا فرستنده (اختیاری جهت تسویه فاکتور)"
                               ToStringFunc="@(inv => inv != null ? $"فاکتور {inv.InvoiceType.GetDisplayName()} شماره {inv.InvoiceNumber} (مانده: {inv.Remaining.ToCurrencyFormat(inv.PriceUnit.Title)})" : null)"
                               Disabled="@(Model.SourceCustomer == null || _loadingInvoices)"
                               Clearable="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined">
                        @foreach (var inv in _sourceInvoices)
                        {
                            <MudSelectItem Value="inv">
                                فاکتور @inv.InvoiceType.GetDisplayName() شماره @inv.InvoiceNumber (مانده: @inv.Remaining.ToCurrencyFormat(inv.PriceUnit.Title))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="GetTinyInvoiceResponse?"
                               @bind-Value="Model.DestinationInvoice"
                               Label="فاکتور مقصد گیرنده (اختیاری جهت تسویه فاکتور)"
                               ToStringFunc="@(inv => inv != null ? $"فاکتور {inv.InvoiceType.GetDisplayName()} شماره {inv.InvoiceNumber} (مانده: {inv.Remaining.ToCurrencyFormat(inv.PriceUnit.Title)})" : null)"
                               Disabled="@(Model.DestinationCustomer == null || _loadingInvoices)"
                               Clearable="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined">
                        @foreach (var inv in _destInvoices)
                        {
                            <MudSelectItem Value="inv">
                                فاکتور @inv.InvoiceType.GetDisplayName() شماره @inv.InvoiceNumber (مانده: @inv.Remaining.ToCurrencyFormat(inv.PriceUnit.Title))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Description Field -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="@Model.Description"
                                  Label="شرح و توضیحات حواله"
                                  For="() => Model.Description"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            </div>
        </DialogContent>

        <DialogActions>
            <MudButton Color="Color.Default"
                       OnClick="Cancel"
                       StartIcon="@Icons.Material.Filled.Close"
                       Variant="Variant.Outlined">
                انصراف
            </MudButton>

            <MudButton
                       Color="Color.Primary"
                       Disabled="@_processing"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SubmitAsync"
                       Variant="Variant.Filled">
                @if (_processing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">در حال ذخیره</MudText>
                }
                else
                {
                    <MudText>ذخیره</MudText>
                }
            </MudButton>
        </DialogActions>
    </EditorDialogFrame>
</MudForm>