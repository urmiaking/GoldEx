@using GoldEx.Client.Components.Components.Dialogs
@using GoldEx.Shared.DTOs.FinancialAccounts
@using GoldEx.Shared.DTOs.PriceUnits
@inherits GoldExComponentBase

<MudForm Model="_model" @ref="_form" Validation="@(_validator.ValidateValue)" ValidationDelay="0">
    <EditorDialogFrame>
        <DialogContent>
            <div class="payment-editor-content">
                @if (_loading)
                {
                    <div class="payment-editor-status" role="status">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                        در حال آماده‌سازی فرم
                    </div>
                }
                else if (Id.HasValue && _model.Id != Id)
                {
                    <div class="payment-editor-status" role="alert">اطلاعات سند دریافت نشد. پنجره را ببندید و دوباره آن را باز کنید.</div>
                }
                else
                {
                    <fieldset class="payment-editor-fields" disabled="@_processing">
                        <section class="payment-editor-section payment-editor-amount" aria-label="پرداخت">
                            <h3><MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" /> پرداخت</h3>
                            <div class="payment-editor-amount-grid">
                                <MudNumericField T="decimal?"
                                                 @bind-Value="_model.Amount"
                                                 For="@(() => _model.Amount)"
                                                 dir="ltr"
                                                 InputMode="@(InputMode.@decimal)"
                                                 Min="0"
                                                 HideSpinButtons="true"
                                                 Format="#,##0.##########"
                                                 Immediate="true"
                                                 Label="@(_model.PriceUnit?.IsGoldBased == true ? "وزن پرداختی" : "مبلغ پرداختی")"
                                                 Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" />
                                <MudSelect T="GetPriceUnitTitleResponse?"
                                           Value="_model.PriceUnit"
                                           ValueChanged="OnPriceUnitChanged"
                                           Label="واحد پرداخت"
                                           For="() => _model.PriceUnit"
                                           ToStringFunc="@(unit => unit?.Title)"
                                           Disabled="@_refreshingAccounts"
                                           Margin="Margin.Dense"
                                           Variant="Variant.Outlined">
                                    @foreach (var unit in _priceUnits)
                                    {
                                        <MudSelectItem Value="unit">@unit.Title</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (_model.PriceUnit is { IsDefault: false })
                                {
                                    <div class="payment-editor-rate">
                                        <MudNumericField T="decimal?"
                                                         @bind-Value="_model.ExchangeRate"
                                                         For="() => _model.ExchangeRate"
                                                         dir="ltr"
                                                         InputMode="@(InputMode.@decimal)"
                                                         Label="نرخ تبدیل"
                                                         Format="#,##0.##################"
                                                         Immediate="true"
                                                         Disabled="@_refreshingAccounts"
                                                         HideSpinButtons="true"
                                                         Adornment="Adornment.End"
                                                         AdornmentText="@DefaultPriceUnit?.Title"
                                                         Margin="Margin.Dense"
                                                         Variant="Variant.Outlined" />
                                    </div>
                                }
                            </div>
                        </section>

                        <section class="payment-editor-section" aria-label="طرف حساب و حساب‌های مالی">
                            <h3><MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" Size="Size.Small" /> طرف حساب و حساب‌های مالی</h3>
                            <div class="payment-editor-picker">
                                <MudAutocomplete T="CustomerVm"
                                                 Value="_model.Customer"
                                                 ValueChanged="OnSupplierChanged"
                                                 For="@(() => _model.Customer!)"
                                                 Label="طرف حساب"
                                                 ToStringFunc="@(customer => customer?.FullName)"
                                                 SearchFunc="@SearchSuppliers"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Outlined.Search"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 ShowProgressIndicator="true"
                                                 MinCharacters="1"
                                                 Disabled="@_refreshingAccounts"
                                                 Margin="Margin.Dense"
                                                 Variant="Variant.Outlined">
                                    <ItemTemplate Context="customer">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">@customer.FullName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @customer.CustomerType.GetDisplayName()
                                                @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
                                                {
                                                    <span> · <bdi>@customer.PhoneNumber</bdi></span>
                                                }
                                            </MudText>
                                        </MudStack>
                                    </ItemTemplate>
                                    <NoItemsTemplate>
                                        <MudText Class="px-4 py-3" Typo="Typo.body2">طرف حسابی پیدا نشد.</MudText>
                                    </NoItemsTemplate>
                                </MudAutocomplete>
                                <MudIconButton Class="payment-editor-add"
                                               Icon="@Icons.Material.Outlined.PersonAdd"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Variant="Variant.Outlined"
                                               Disabled="@_refreshingAccounts"
                                               title="افزودن طرف حساب"
                                               aria-label="افزودن طرف حساب"
                                               OnClick="OnAddSupplier" />
                            </div>

                            @if (_model.Customer is { } selectedCustomer)
                            {
                                <details class="payment-editor-customer" @key="selectedCustomer.Id">
                                    <summary>
                                        <span>مشخصات طرف حساب</span>
                                        <span class="payment-editor-customer-type">@selectedCustomer.CustomerType.GetDisplayName()</span>
                                    </summary>
                                    <dl>
                                        <div><dt>شماره تماس</dt><dd><bdi>@selectedCustomer.PhoneNumber</bdi></dd></div>
                                        <div><dt>کد مشتری</dt><dd><bdi>@selectedCustomer.NationalId</bdi></dd></div>
                                        @if (!string.IsNullOrWhiteSpace(selectedCustomer.Address))
                                        {
                                            <div class="payment-editor-address"><dt>آدرس</dt><dd>@selectedCustomer.Address</dd></div>
                                        }
                                    </dl>
                                </details>
                            }

                            <div class="payment-editor-accounts" aria-busy="@(_refreshingAccounts ? "true" : "false")">
                                <div class="payment-editor-picker">
                                    <MudSelect T="GetFinancialAccountTitleResponse?"
                                               @bind-Value="_model.SourceFinancialAccount"
                                               Label="حساب پرداختی"
                                               For="() => _model.SourceFinancialAccount"
                                               ToStringFunc="@(account => account?.Title)"
                                               OuterClass="text-truncate"
                                               Disabled="@(_refreshingAccounts || _model.PriceUnit is null)"
                                               HelperText="@SourceAccountHint"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined">
                                        @foreach (var account in _sourceFinancialAccounts)
                                        {
                                            <MudSelectItem Value="account">@account.Title</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudIconButton Class="payment-editor-add"
                                                   Icon="@Icons.Material.Outlined.Add"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Outlined"
                                                   Disabled="@(_refreshingAccounts || _model.PriceUnit is null)"
                                                   title="افزودن حساب پرداختی"
                                                   aria-label="افزودن حساب پرداختی"
                                                   OnClick="() => OnAddFinancialAccount(true)" />
                                </div>

                                <div class="payment-editor-picker">
                                    <MudSelect T="GetFinancialAccountTitleResponse?"
                                               @bind-Value="_model.DestinationFinancialAccount"
                                               Label="حساب دریافتی (اختیاری)"
                                               For="() => _model.DestinationFinancialAccount"
                                               ToStringFunc="@(account => account?.Title)"
                                               OuterClass="text-truncate"
                                               Clearable="true"
                                               Disabled="@(_refreshingAccounts || _model.PriceUnit is null || _model.Customer is null)"
                                               HelperText="@DestinationAccountHint"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined">
                                        @foreach (var account in _destinationFinancialAccounts)
                                        {
                                            <MudSelectItem Value="account">@account.Title</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudIconButton Class="payment-editor-add"
                                                   Icon="@Icons.Material.Outlined.Add"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Outlined"
                                                   Disabled="@(_refreshingAccounts || _model.PriceUnit is null || _model.Customer is null)"
                                                   title="افزودن حساب دریافتی"
                                                   aria-label="افزودن حساب دریافتی"
                                                   OnClick="() => OnAddFinancialAccount(false)" />
                                </div>
                            </div>
                        </section>

                        <section class="payment-editor-section" aria-label="جزئیات سند">
                            <h3><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" /> جزئیات سند</h3>
                            <div class="payment-editor-document">
                                <div class="payment-editor-type">
                                    <MudSelect T="PaymentVoucherType"
                                               @bind-Value="_model.VoucherType"
                                               Label="نوع پرداخت"
                                               For="() => _model.VoucherType"
                                               ToStringFunc="@(type => type.GetDisplayName())"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined">
                                        @foreach (var type in Enum.GetValues<PaymentVoucherType>())
                                        {
                                            <MudSelectItem Value="type">@type.GetDisplayName()</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                                <MudDatePicker @bind-Date="_model.PaymentDate"
                                               Adornment="Adornment.Start"
                                               Editable="true"
                                               AnchorOrigin="Origin.TopCenter"
                                               TransformOrigin="Origin.BottomCenter"
                                               For="@(() => _model.PaymentDate)"
                                               Label="تاریخ پرداخت"
                                               Class="payment-editor-date"
                                               ImmediateText="true"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined" />
                                <MudNumericField T="long"
                                                 @bind-Value="_model.VoucherNumber"
                                                 For="@(() => _model.VoucherNumber)"
                                                 dir="ltr"
                                                 InputMode="InputMode.numeric"
                                                 HideSpinButtons="true"
                                                 Label="شماره سند"
                                                 Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" />
                                <div class="payment-editor-description">
                                    <MudTextField T="string"
                                                  @bind-Value="_model.Description"
                                                  For="@(() => _model.Description!)"
                                                  Label="شرح پرداخت"
                                                  MaxLength="150"
                                                  Counter="150"
                                                  Immediate="true"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined" />
                                </div>
                            </div>
                        </section>
                    </fieldset>
                }
            </div>
        </DialogContent>
        <DialogActions>
            <div class="payment-editor-actions">
                <MudButton Color="Color.Default"
                           Disabled="@_processing"
                           OnClick="Close"
                           Variant="Variant.Outlined">انصراف</MudButton>
                <MudButton Color="Color.Primary"
                           Disabled="@(!CanSubmit)"
                           OnClick="Submit"
                           Variant="Variant.Filled">
                    @if (_processing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span role="status">در حال ذخیره</span>
                    }
                    else
                    {
                        @(Id.HasValue ? "ذخیره تغییرات" : "ثبت سند پرداخت")
                    }
                </MudButton>
            </div>
        </DialogActions>
    </EditorDialogFrame>
</MudForm>
