@using GoldEx.Shared.Helpers
@inherits GoldExComponentBase
<section class="finance-directory" aria-label="اسناد پرداخت">
    <header class="finance-heading">
        <div><h1>اسناد پرداخت <span class="finance-count">@(_loading ? "…" : $"{_total:N0} سند")</span></h1>
            <p>مدیریت پرداخت‌ها و بازپرداخت‌های مشتریان</p></div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OnCreate" Class="finance-create">سند جدید</MudButton>
    </header>
    <div class="finance-filters">
        <div class="finance-toolbar">
            <MudTextField T="string" Value="SearchQuery" ValueChanged="OnSearch" Immediate="true" DebounceInterval="450"
                          Clearable="true" Label="جستجوی سند" Placeholder="شماره سند، نام طرف حساب"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Outlined" Class="finance-filter-button" StartIcon="@Icons.Material.Outlined.Tune" OnClick="OpenFilters"
                       Color="@(ActiveFilterCount > 0 ? Color.Primary : Color.Default)" aria-label="فیلتر اسناد پرداخت">
                <span class="finance-filter-label">فیلترها</span>
                @if (ActiveFilterCount > 0) { <span class="finance-filter-count">@ActiveFilterCount</span> }
            </MudButton>
            <MudSelect T="string" Class="finance-sort" Label="مرتب‌سازی بر اساس" Value="_sortLabel" ValueChanged="OnSortChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@("PaymentDate")">تاریخ پرداخت</MudSelectItem>
                <MudSelectItem Value="@("VoucherNumber")">شماره سند</MudSelectItem>
                <MudSelectItem Value="@("VoucherType")">نوع سند</MudSelectItem>
                <MudSelectItem Value="@("Customer.FullName")">طرف حساب</MudSelectItem>
            </MudSelect>
            <div class="finance-sort-direction"><MudIconButton Icon="@(_sortDescending ? Icons.Material.Filled.South : Icons.Material.Filled.North)"
                             OnClick="ToggleSortDirection" aria-label="تغییر جهت مرتب‌سازی" /></div>
        </div>
    </div>
    <div class="finance-results" aria-busy="@_loading">
        @if (_loading)
        {
            <div class="finance-skeleton" role="status" aria-label="در حال بارگذاری">
                @for(var i=0;i<5;i++){ <span></span> }
            </div>
        }
        else if (_loadFailed || _items.Count == 0)
        {
            <div class="finance-empty">
                <MudIcon Icon="@(_loadFailed ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.ReceiptLong)" />
                <strong>@(_loadFailed ? "دریافت اسناد پرداخت انجام نشد" : "سند پرداختی پیدا نشد")</strong>
                <p>@(_loadFailed ? "اتصال را بررسی کنید." : "جستجو یا فیلترها را تغییر دهید.")</p>
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(_loadFailed ? LoadAsync : ResetFilters)">
                    @(_loadFailed ? "تلاش دوباره" : "پاک کردن فیلترها")
                </MudButton>
            </div>
        }
        else
        {
            <div class="finance-desktop">
                <table class="finance-table">
                    <thead><tr><th>سند</th><th>تاریخ</th><th>طرف حساب</th><th>مبلغ</th><th>نوع پرداخت</th><th>حساب</th><th>عملیات</th></tr></thead>
                    <tbody>
                    @foreach(var item in _items)
                    {
                        <tr @key="item.Id">
                            <td><span class="finance-number">#@item.VoucherNumber</span></td>
                            <td>@item.PaymentDate.ToShortDateString()</td>
                            <td><div class="finance-person"><strong>@item.SupplierName</strong><small>@item.SupplierPhoneNumber</small></div></td>
                            <td><span class="finance-money">@item.Amount.ToCurrencyFormat(item.PriceUnit)</span></td>
                            <td>@item.VoucherType.GetDisplayName()</td>
                            <td>@item.FinancialAccountType.GetDisplayName()</td>
                            <td><div class="finance-actions">
                                @if(item.InvoiceId.HasValue)
                                { <button type="button" title="مشاهده فاکتور" aria-label="مشاهده فاکتور" @onclick="() => OnViewInvoice(item)"><ShellIcon Name="eye" /></button> }
                                else
                                {
                                    <button type="button" title="ویرایش سند" aria-label="ویرایش سند" @onclick="() => OnEdit(item)"><ShellIcon Name="edit" /></button>
                                    <button type="button" class="is-danger" title="حذف سند" aria-label="حذف سند" @onclick="() => OnRemove(item)"><ShellIcon Name="trash" /></button>
                                }
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="finance-mobile">
                @foreach(var item in _items)
                {
                    <article class="finance-card" @key="item.Id">
                        <header><span class="finance-number">#@item.VoucherNumber</span><time>@item.PaymentDate.ToShortDateString()</time><span class="finance-kind">@item.VoucherType.GetDisplayName()</span></header>
                        <div class="finance-card-main">
                            <div class="finance-person"><small>طرف حساب</small><strong>@item.SupplierName</strong></div>
                            <strong class="finance-money">@item.Amount.ToCurrencyFormat(item.PriceUnit)</strong>
                        </div>
                        <div class="finance-card-meta"><span>@item.FinancialAccountType.GetDisplayName()</span>
                            @if(!string.IsNullOrWhiteSpace(item.SupplierPhoneNumber)){ <span>@item.SupplierPhoneNumber</span> }
                        </div>
                        <footer><span>سند پرداخت</span><div class="finance-actions">
                            @if(item.InvoiceId.HasValue)
                            { <button type="button" title="مشاهده فاکتور" aria-label="مشاهده فاکتور" @onclick="() => OnViewInvoice(item)"><ShellIcon Name="eye" /></button> }
                            else
                            {
                                <button type="button" title="ویرایش سند" aria-label="ویرایش سند" @onclick="() => OnEdit(item)"><ShellIcon Name="edit" /></button>
                                <button type="button" class="is-danger" title="حذف سند" aria-label="حذف سند" @onclick="() => OnRemove(item)"><ShellIcon Name="trash" /></button>
                            }
                        </div></footer>
                    </article>
                }
            </div>
        }
    </div>
    <footer class="finance-pagination">
        <label>تعداد ردیف<select value="@_pageSize" @onchange="ChangePageSize" aria-label="تعداد سند در صفحه">
            <option value="10">۱۰</option><option value="25">۲۵</option><option value="50">۵۰</option>
        </select></label>
        <nav><button type="button" disabled="@(_loading || _pageIndex == 0)" @onclick="() => ChangePage(-1)">قبلی</button>
            <span>@(_pageIndex + 1) از @PageCount</span>
            <button type="button" disabled="@(_loading || _pageIndex + 1 >= PageCount)" @onclick="() => ChangePage(1)">بعدی</button>
        </nav>
    </footer>
</section>