@inherits GoldExComponentBase

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Info" />
            <MudText Typo="Typo.h6">@Model.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudSwitch @bind-Value="Model.ShowInVitrine"
                           Label="نمایش در ویترین"
                           Color="Color.Success"
                           T="bool" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch @bind-Value="Model.IsFeatured"
                           Label="نمایش در پیشنهادات ویژه"
                           Color="Color.Primary"
                           Disabled="@(!Model.ShowInVitrine)"
                           T="bool" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="Model.VitrineDescription"
                              Label="توضیحات معرفی قطعه (اختیاری)"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Margin="Margin.Dense"
                              Disabled="@(!Model.ShowInVitrine)"
                              Placeholder="توضیحات جذاب درباره ظرافت ساخت، تراش، درخشش یا برند قطعه..." />
            </MudItem>

            @if (_categoryAttributes.Any())
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1 d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Color="Color.Primary" />
                        مشخصات و ابعاد قطعه
                    </MudText>
                    <MudDivider Class="mb-3" />

                    <MudGrid Spacing="2">
                        @foreach (var attr in _categoryAttributes)
                        {
                            <MudItem xs="12" sm="6">
                                @if (attr.DataType == ProductAttributeDataType.Number)
                                {
                                    <MudTextField @bind-Value="attr.Value"
                                                  Label="@(attr.Title + (attr.IsRequired ? " *" : ""))"
                                                  Adornment="@(string.IsNullOrWhiteSpace(attr.Unit) ? Adornment.None : Adornment.End)"
                                                  AdornmentText="@attr.Unit"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Placeholder="@($"مثال: 3.5")"
                                                  Required="@attr.IsRequired"
                                                  RequiredError="@($"{attr.Title} الزامی است.")" />
                                }
                                else if (attr.DataType == ProductAttributeDataType.Select && !string.IsNullOrWhiteSpace(attr.Options))
                                {
                                    <MudSelect @bind-Value="attr.Value"
                                               Label="@(attr.Title + (attr.IsRequired ? " *" : ""))"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Clearable="true"
                                               Required="@attr.IsRequired"
                                               RequiredError="@($"{attr.Title} الزامی است.")"
                                               T="string">
                                        @foreach (var opt in attr.Options.Split(new[] { ',', '،' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <MudSelectItem Value="@opt">@opt</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudTextField @bind-Value="attr.Value"
                                                  Label="@(attr.Title + (attr.IsRequired ? " *" : ""))"
                                                  Adornment="@(string.IsNullOrWhiteSpace(attr.Unit) ? Adornment.None : Adornment.End)"
                                                  AdornmentText="@attr.Unit"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Required="@attr.IsRequired"
                                                  RequiredError="@($"{attr.Title} الزامی است.")" />
                                }
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>
            }

            @if (Model.ShowInVitrine && !string.IsNullOrWhiteSpace(PublicVitrineUrl))
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3 d-flex align-center justify-space-between flex-wrap gap-2"
                              Elevation="0"
                              Style="background: rgba(var(--mud-palette-info-rgb), 0.08); border: 1px solid rgba(var(--mud-palette-info-rgb), 0.3); border-radius: 10px;">
                        <div class="d-flex align-center gap-2" style="min-width: 0;">
                            <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Info" Size="Size.Small" />
                            <div style="min-width: 0;">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">لینک اختصاصی کالا در ویترین</MudText>
                                <MudText Typo="Typo.body2" Style="direction: ltr; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--mud-palette-info);">
                                    @PublicVitrineUrl
                                </MudText>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudButton StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Variant="Variant.Outlined"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="CopyVitrineUrlAsync">
                                کپی لینک
                            </MudButton>
                            <MudButton StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Variant="Variant.Filled"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       Target="_blank"
                                       Href="@PublicVitrineUrl">
                                مشاهده
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudItem>
            }

            <!-- Image Gallery Upload Section -->
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">تصاویر ویترین کالا</MudText>

                <div class="d-flex flex-wrap gap-3 mb-3">
                    @foreach (var img in Model.Images)
                    {
                        <div style="position: relative; width: 100px; height: 100px; border-radius: 12px; overflow: hidden; border: 2px solid @(img.IsMain ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)"); background: #000;">
                            <img src="@img.Url" style="width: 100%; height: 100%; object-fit: cover;" />
                            
                            @if (img.IsMain)
                            {
                                <span style="position: absolute; bottom: 4px; right: 4px; background: var(--mud-palette-primary); color: #fff; font-size: 0.65rem; font-weight: bold; padding: 2px 6px; border-radius: 4px;">
                                    شاخص
                                </span>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.StarBorder"
                                               Size="Size.Small"
                                               Style="position: absolute; bottom: 2px; right: 2px; background: rgba(0,0,0,0.6);"
                                               Color="Color.Primary"
                                               OnClick="() => SetMainImage(img)" />
                            }

                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Style="position: absolute; top: 2px; left: 2px; background: rgba(0,0,0,0.6);"
                                           Color="Color.Error"
                                           OnClick="() => RemoveImage(img)" />
                        </div>
                    }

                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.webp" FilesChanged="UploadImageAsync">
                        <CustomContent Context="ctx">
                            <div @onclick="ctx.OpenFilePickerAsync"
                                 style="width: 100px; height: 100px; border: 2px dashed var(--mud-palette-primary); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; color: var(--mud-palette-primary); background: rgba(var(--mud-palette-primary-rgb), 0.05);">
                                @if (_isUploading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Medium" />
                                    <span style="font-size: 0.75rem; margin-top: 4px;">افزودن عکس</span>
                                }
                            </div>
                        </CustomContent>
                    </MudFileUpload>
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2" />
            }
            ذخیره تنظیمات ویترین
        </MudButton>
    </DialogActions>
</MudDialog>
