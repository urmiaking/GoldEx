@using GoldEx.Client.Components.Components.Dialogs
@inherits GoldExComponentBase

<EditorDialogFrame>
    <DialogContent>
        <div class="gex-vitrine-editor">
            <header class="gex-vitrine-overview">
                <div class="gex-vitrine-overview-icon"><MudIcon Icon="@Icons.Material.Outlined.Storefront" /></div>
                <div class="gex-vitrine-overview-text">
                    <MudText Typo="Typo.body1">@Model.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">وضعیت نمایش، اطلاعات معرفی و تصاویر این جنس را مدیریت کنید.</MudText>
                </div>
                <span class="gex-vitrine-status @(Model.ShowInVitrine ? "is-live" : null)">
                    @(Model.ShowInVitrine ? "در ویترین" : "نمایش غیرفعال")
                </span>
            </header>

            <section class="gex-vitrine-section" aria-label="انتشار در ویترین">
                <div class="gex-vitrine-section-heading">
                    <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />
                    <MudText Typo="Typo.body1">نحوه نمایش</MudText>
                </div>
                <div class="gex-vitrine-switch-grid">
                    <div class="gex-vitrine-switch">
                        <div class="gex-vitrine-switch-copy">
                            <MudText Typo="Typo.body2">نمایش در ویترین آنلاین</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">مشتریان می‌توانند این جنس را در سایت ببینند.</MudText>
                        </div>
                        <MudSwitch @bind-Value="Model.ShowInVitrine" Color="Color.Success"
                                   T="bool" aria-label="نمایش در ویترین آنلاین" />
                    </div>
                    <div class="gex-vitrine-switch @(!Model.ShowInVitrine ? "is-disabled" : null)">
                        <div class="gex-vitrine-switch-copy">
                            <MudText Typo="Typo.body2">پیشنهاد ویژه</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">جنس را در بخش پیشنهادهای ویژه نمایش بده.</MudText>
                        </div>
                        <MudSwitch @bind-Value="Model.IsFeatured" Color="Color.Primary"
                                   Disabled="@(!Model.ShowInVitrine)" T="bool" aria-label="پیشنهاد ویژه" />
                    </div>
                </div>
                <MudTextField @bind-Value="Model.VitrineDescription"
                              Label="توضیحات معرفی جنس" Placeholder="درباره طراحی، ظرافت ساخت یا ویژگی‌های این جنس بنویسید..."
                              Variant="Variant.Outlined" Lines="3" Margin="Margin.Dense"
                              Disabled="@(!Model.ShowInVitrine)" />
            </section>

            @if (_categoryAttributes.Any())
            {
                <section class="gex-vitrine-section" aria-label="مشخصات جنس">
                    <div class="gex-vitrine-section-heading">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                        <MudText Typo="Typo.body1">ویژگی‌ها و ابعاد</MudText>
                    </div>
                    <MudGrid Spacing="2">
                        @foreach (var attr in _categoryAttributes)
                        {
                            <MudItem xs="12" sm="6">
                                @if (attr.DataType == ProductAttributeDataType.Number)
                                {
                                    <MudTextField @bind-Value="attr.Value"
                                                  Label="@(attr.Title + (attr.IsRequired ? " *" : ""))"
                                                  Adornment="@(string.IsNullOrWhiteSpace(attr.Unit) ? Adornment.None : Adornment.End)"
                                                  AdornmentText="@attr.Unit" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Placeholder="مثال: ۳٫۵"
                                                  Required="@attr.IsRequired" RequiredError="@($"{attr.Title} الزامی است.")" />
                                }
                                else if (attr.DataType == ProductAttributeDataType.Select && !string.IsNullOrWhiteSpace(attr.Options))
                                {
                                    <MudSelect @bind-Value="attr.Value"
                                               Label="@(attr.Title + (attr.IsRequired ? " *" : ""))"
                                               Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Clearable="true" Required="@attr.IsRequired"
                                               RequiredError="@($"{attr.Title} الزامی است.")" T="string">
                                        @foreach (var opt in attr.Options.Split(new[] { ',', '،' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <MudSelectItem Value="@opt">@opt</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudTextField @bind-Value="attr.Value"
                                                  Label="@(attr.Title + (attr.IsRequired ? " *" : ""))"
                                                  Adornment="@(string.IsNullOrWhiteSpace(attr.Unit) ? Adornment.None : Adornment.End)"
                                                  AdornmentText="@attr.Unit" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Required="@attr.IsRequired" RequiredError="@($"{attr.Title} الزامی است.")" />
                                }
                            </MudItem>
                        }
                    </MudGrid>
                </section>
            }

            @if (Model.ShowInVitrine && !string.IsNullOrWhiteSpace(PublicVitrineUrl))
            {
                <section class="gex-vitrine-section" aria-label="لینک عمومی جنس">
                    <div class="gex-vitrine-section-heading">
                        <MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" />
                        <MudText Typo="Typo.body1">لینک اختصاصی ویترین</MudText>
                    </div>
                    <div class="gex-vitrine-link">
                        <div class="gex-vitrine-link-text" dir="ltr" title="@PublicVitrineUrl">@PublicVitrineUrl</div>
                        <div class="gex-vitrine-link-actions">
                            <MudButton OnClick="CopyVitrineUrlAsync" StartIcon="@Icons.Material.Outlined.ContentCopy"
                                       Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">کپی لینک</MudButton>
                            <MudButton StartIcon="@Icons.Material.Outlined.OpenInNew" Variant="Variant.Outlined"
                                       Color="Color.Primary" Size="Size.Small" Target="_blank" Href="@PublicVitrineUrl">مشاهده</MudButton>
                        </div>
                    </div>
                </section>
            }

            <section class="gex-vitrine-section" aria-label="تصاویر ویترین">
                <div class="gex-vitrine-section-heading">
                    <MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary" Size="Size.Small" />
                    <MudText Typo="Typo.body1">تصاویر ویترین</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(Model.Images.Count) تصویر</MudText>
                </div>
                <div class="gex-vitrine-gallery">
                    @foreach (var img in Model.Images)
                    {
                        <div class="gex-vitrine-photo @(img.IsMain ? "is-main" : null)" @key="img.Url">
                            <img src="@img.Url" alt="@Model.Name" loading="lazy" />
                            @if (img.IsMain)
                            {
                                <span class="gex-vitrine-photo-badge">تصویر شاخص</span>
                            }
                            else
                            {
                                <button type="button" class="gex-vitrine-photo-action is-star" title="انتخاب به‌عنوان تصویر شاخص"
                                        aria-label="انتخاب تصویر شاخص" @onclick="() => SetMainImage(img)">
                                    <MudIcon Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small" />
                                </button>
                            }
                            <button type="button" class="gex-vitrine-photo-action is-remove" title="حذف تصویر"
                                    aria-label="حذف تصویر" @onclick="() => RemoveImage(img)">
                                <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                            </button>
                        </div>
                    }
                    <MudFileUpload T="IBrowserFile" Accept=".jpg,.jpeg,.png,.webp" FilesChanged="UploadImageAsync">
                        <CustomContent Context="ctx">
                            <button type="button" class="gex-vitrine-upload" disabled="@(_isUploading || _isSaving)"
                                    aria-label="افزودن تصویر جدید" @onclick="ctx.OpenFilePickerAsync">
                                @if (_isUploading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" Size="Size.Medium" />
                                    <span>افزودن تصویر</span>
                                }
                            </button>
                        </CustomContent>
                    </MudFileUpload>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    تصاویر را با فرمت JPG، PNG یا WebP انتخاب کنید. حجم هر تصویر حداکثر ۲۰ مگابایت است.
                </MudText>
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Close"
                   Variant="Variant.Outlined" Disabled="@(_isSaving || _isUploading)">انصراف</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save"
                   Variant="Variant.Filled" Disabled="@(_isSaving || _isUploading)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2" />
                <span>در حال ذخیره...</span>
            }
            else
            {
                <span>ذخیره تنظیمات</span>
            }
        </MudButton>
    </DialogActions>
</EditorDialogFrame>
