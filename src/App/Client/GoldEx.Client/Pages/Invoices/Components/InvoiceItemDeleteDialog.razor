@using GoldEx.Client.Components.Components.Dialogs
@inherits GoldExComponentBase
<EditorDialogFrame>
    <DialogContent>
        <div class="gex-delete-confirm">
            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Error" Size="Size.Large"/>
            <h3>حذف قلم از فاکتور</h3>
            <p>«@ItemTitle» از اقلام فاکتور حذف شود؟</p>
            <p>پس از حذف، مبلغ و مانده فاکتور دوباره محاسبه می‌شوند.</p>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="() => Session?.Cancel()">انصراف</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="() => Session?.Close(true)">حذف قلم</MudButton>
    </DialogActions>
</EditorDialogFrame>