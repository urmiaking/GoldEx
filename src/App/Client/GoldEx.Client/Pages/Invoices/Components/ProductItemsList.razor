@inherits GoldExComponentBase
<div class="invoice-line-list">
    <div class="invoice-line-toolbar">
        <div class="invoice-line-toolbar-info"><strong>طلا، جواهر و آب‌شده</strong><span>@Items.Count قلم</span></div>
        <div class="invoice-line-toolbar-actions">
            <MudTextField T="string" Value="_barcode" ValueChanged="@(s => OnBarcodeChanged.InvokeAsync(s))"
 Label="بارکد" Placeholder="اسکن یا ورود بارکد" Clearable="true"
 Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.QrCodeScanner"
 OnClearButtonClick="OnBarcodeCleared" />
            @if (InvoiceType == InvoiceType.Sell)
{ <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Inventory2"
             OnClick="OnOpenSelector">انتخاب از انبار</MudButton> }
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Outlined.Add" OnClick="OnAddItem">افزودن جنس</MudButton>
        </div>
    </div>
    @if (Items.Count == 0)
    {
        <div class="invoice-line-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
            <strong>هنوز قلمی در این گروه ثبت نشده</strong>
            <span>برای شروع، «افزودن جنس» را انتخاب کنید.</span>
        </div>
    }
    else
    {
        <div class="invoice-line-desktop">
            <table>
                <thead><tr>
            <th scope="col">ردیف</th>
            <th scope="col">نوع جنس</th>
            <th scope="col">عنوان</th>
            <th scope="col">تعداد</th>
            <th scope="col">عیار</th>
            <th scope="col">اجرت</th>
            <th scope="col">وزن</th>
            @if (Items.Any(x => x.StoneAmount > 0))
            {
                <th scope="col">ارزش سنگ</th>
            }
            <th scope="col">ارزش کل</th>
            <th scope="col">عملیات</th>
        </tr></thead>
                <tbody>
                    @foreach (var context in Items)
                    {
                        <tr @key="context">

            <td>@context.Index</td>
            <td>@context.Product.ProductType.GetDisplayName()</td>
            <td>@GetProductDisplayName(context.Product)</td>
            <td>@context.Quantity</td>
            <td>@context.Product.Fineness.ToString("G29")</td>
            <td>
                @{
                    @(context.Product.WageType switch
                    {
                        WageType.Fixed => $"{context.Product.Wage?.ToCurrencyFormat(context.Product.WagePriceUnitTitle)}",
                        WageType.Percent => context.Product.Wage?.ToString("G29") + " درصد",
                        _ => "ندارد"
                    })
                }
            </td>
            <td>@context.TotalWeight?.ToString("G29") @context.Product.GoldUnitType.GetDisplayName()</td>
            @if (Items.Any(x => x.StoneAmount > 0))
            {
                <td>@context.StoneAmount.ToCurrencyFormat(PriceUnit?.Title)</td>
            }
            <td>@context.FinalAmount.ToCurrencyFormat(PriceUnit?.Title)</td>
            <td>
                <div class="d-flex gap-2">
                    <MudTooltip Text="چاپ بارکد">
                        <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Variant="Variant.Outlined"
                                       Color="Color.Success" OnClick="() => OnPrintBarcode.InvokeAsync(context)"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="ویرایش جنس">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Outlined"
                                       Color="Color.Primary" OnClick="() => OnEditItem.InvokeAsync(context)"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="حذف جنس">
                        <MudIconButton OnClick="@(_ => OnRemoveItem.InvokeAsync(context))" Icon="@Icons.Material.Filled.Delete"
                                       Color="@Color.Error" Size="@Size.Small" Variant="Variant.Outlined" ></MudIconButton>
                    </MudTooltip>
                </div>
            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="invoice-line-mobile">
            @foreach (var item in Items)
            {
                <div class="invoice-line-card" @key="item">
<header><span class="invoice-line-kind">@item.Product.ProductType.GetDisplayName()</span><strong>@item.FinalAmount.ToCurrencyFormat(PriceUnit?.Title)</strong></header>
<h3>@GetProductDisplayName(item.Product)</h3>
<div class="invoice-line-facts">
<div><span>تعداد</span><strong>@item.Quantity</strong></div><div><span>وزن</span><strong>@item.TotalWeight?.ToString("G29") @item.Product.GoldUnitType.GetDisplayName()</strong></div>
<div><span>عیار</span><strong>@item.Product.Fineness.ToString("G29")</strong></div>
<div><span>اجرت</span><strong>@(item.Product.WageType switch { WageType.Fixed => item.Product.Wage?.ToCurrencyFormat(item.Product.WagePriceUnitTitle), WageType.Percent => item.Product.Wage?.ToString("G29") + " درصد", _ => "ندارد" })</strong></div>
</div>
<footer><MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => OnEditItem.InvokeAsync(item)">ویرایش</MudButton>
<MudIconButton Icon="@Icons.Material.Outlined.Print" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" aria-label="چاپ بارکد" OnClick="() => OnPrintBarcode.InvokeAsync(item)" />
<MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" aria-label="حذف قلم" OnClick="() => OnRemoveItem.InvokeAsync(item)" /></footer>
</div>
            }
        </div>
    }
</div>