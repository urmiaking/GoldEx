@using GoldEx.Client.Pages.FinancialAccounts.ViewModels
@using GoldEx.Shared.DTOs.Coins
@using GoldEx.Shared.DTOs.FinancialAccounts
@using GoldEx.Shared.DTOs.Invoices
@inherits GoldExComponentBase

<MudForm Model="Model" @ref="@_form" Validation="@(_paymentValidator.ValidateValue)" ValidationDelay="0">
    <MudDialog>
        <DialogContent>

            <div class="d-flex flex-wrap justify-center gap-3 my-3">
                <MudChipSet T="PaymentSide"
                            Class="align-center d-flex"
                            SelectionMode="SelectionMode.SingleSelection"
                            Variant="Variant.Outlined"
                            Size="Size.Medium"
                            CheckMark="true"
                            @bind-SelectedValue="Model.PaymentSide">
                    <MudChip Color="Color.Success"
                             Value="PaymentSide.Receive"
                             Size="@(Model.PaymentSide == PaymentSide.Receive ? Size.Large : Size.Medium)"
                             Variant="@(Model.PaymentSide == PaymentSide.Receive ? Variant.Text : Variant.Outlined)">@PaymentSide.Receive.GetDisplayName()</MudChip>
                    <MudChip Color="Color.Error"
                             Value="PaymentSide.Pay"
                             Size="@(Model.PaymentSide == PaymentSide.Pay ? Size.Large : Size.Medium)"
                             Variant="@(Model.PaymentSide == PaymentSide.Pay ? Variant.Text : Variant.Outlined)">@PaymentSide.Pay.GetDisplayName()</MudChip>
                </MudChipSet>
            </div>

            @if (Model.PaymentType is PaymentType.Coin && Model.CoinInstance is not null)
            {
                <div class="align-center d-flex flex-wrap gap-md-3 justify-center justify-md-space-between mb-1">
                    <div class="d-flex flex-wrap align-center gap-3 my-2">
                        <MudText Typo="Typo.body1" Class="d-none d-md-block">نوع ضرب سکه:</MudText>
                        <MudChipSet T="CoinMintType"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Variant="Variant.Outlined"
                                    Size="Size.Medium"
                                    CheckMark="true"
                                    SelectedValue="Model.CoinInstance.MintType"
                                    SelectedValueChanged="OnCoinMintTypeChanged">
                            <MudChip Color="Color.Success"
                                     Value="CoinMintType.Banking"
                                     Size="@(Model.CoinInstance.MintType == CoinMintType.Banking ? Size.Large : Size.Medium)"
                                     Variant="@(Model.CoinInstance.MintType == CoinMintType.Banking ? Variant.Text : Variant.Outlined)">@CoinMintType.Banking.GetDisplayName()</MudChip>
                            <MudChip Color="Color.Error"
                                     Value="CoinMintType.NonBanking"
                                     Size="@(Model.CoinInstance.MintType == CoinMintType.NonBanking ? Size.Large : Size.Medium)"
                                     Variant="@(Model.CoinInstance.MintType == CoinMintType.NonBanking ? Variant.Text : Variant.Outlined)">@CoinMintType.NonBanking.GetDisplayName()</MudChip>
                        </MudChipSet>
                    </div>
                    <div class="d-flex flex-wrap align-center gap-3 my-2">
                        <MudText Typo="Typo.body1" Class="d-none d-md-block">نوع بسته‌بندی:</MudText>
                        <MudChipSet T="CoinPackageType"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Variant="Variant.Outlined"
                                    Size="Size.Medium"
                                    CheckMark="true"
                                    SelectedValue="Model.CoinInstance.PackageType"
                                    SelectedValueChanged="OnCoinPackageTypeChanged">
                            <MudChip Color="Color.Success"
                                     Value="CoinPackageType.VacuumSealed"
                                     Size="@(Model.CoinInstance.PackageType == CoinPackageType.VacuumSealed ? Size.Large : Size.Medium)"
                                     Variant="@(Model.CoinInstance.PackageType == CoinPackageType.VacuumSealed ? Variant.Text : Variant.Outlined)">@CoinPackageType.VacuumSealed.GetDisplayName()</MudChip>
                            <MudChip Color="Color.Error"
                                     Value="CoinPackageType.Open"
                                     Size="@(Model.CoinInstance.PackageType == CoinPackageType.Open ? Size.Large : Size.Medium)"
                                     Variant="@(Model.CoinInstance.PackageType == CoinPackageType.Open ? Variant.Text : Variant.Outlined)">@CoinPackageType.Open.GetDisplayName()</MudChip>
                        </MudChipSet>
                    </div>
                </div>
            }

            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <div class="d-flex gap-2 align-items-center">
                        <MudNumericField @bind-Value="Model.Amount"
                                         T="decimal"
                                         HideSpinButtons="true"
                                         Format="#,##0.###"
                                         dir="ltr"
                                         DebounceInterval="1"
                                         Disabled="@(Model.Disabled || Model.PaymentType == PaymentType.Coin)"
                                         For="@(() => Model.Amount)"
                                         Label="@(Model.GetDisplayName(() => Model.Amount))"
                                         Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.End"
                                         AdornmentText="@Model.AmountAdornmentText"
                                         Class="flex-grow-1" />
                        @if (Model.PaymentType is PaymentType.InternalCash or PaymentType.CustomerTransfer or PaymentType.Check or PaymentType.Coin)
                        {
                            <MudMenu>
                                <ActivatorContent>
                                    <MudIconButton Icon="@Icons.Material.Filled.SyncAlt" Variant="Variant.Outlined" Color="Color.Primary" OnClick="context.ToggleAsync" />
                                </ActivatorContent>
                                <ChildContent>
                                    @foreach (var item in PriceUnits)
                                    {
                                        <MudMenuItem OnClick="() => SelectPriceUnit(item)">
                                            <div class="d-flex align-items-center gap-2">
                                                @if (item.HasIcon)
                                                {
                                                    <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                        <MudImage Src="@(ApiUrls.Icons.Get(IconType.PriceUnit, item.Id))"></MudImage>
                                                    </MudAvatar>
                                                }
                                                @item.Title
                                            </div>
                                        </MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                        }
                    </div>
                </MudItem>
                @if (Model.PriceUnit?.Id != BasePriceUnit.Id)
                {
                    <MudItem xs="12" md="6">
                        <MudNumericField T="decimal?"
                                         Value="Model.GetDisplayExchangeRate(BasePriceUnit)"
                                         ValueChanged="@(v => Model.SetFromDisplayExchangeRate(v, BasePriceUnit))"
                                         DebounceInterval="1"
                                         dir="ltr"
                                         Label="@Model.GetExchangeRateLabel(BasePriceUnit)"
                                         Margin="Margin.Dense"
                                         Disabled="Model.Disabled"
                                         HideSpinButtons="true"
                                         Variant="Variant.Outlined"
                                         Format="#,##0.########"
                                         Adornment="Adornment.End"
                                         AdornmentText="@Model.GetExchangeRateAdornment(BasePriceUnit)" />
                    </MudItem>
                }

                @switch (Model.PaymentType)
                {
                    case PaymentType.InternalCash:
                        <MudItem xs="12" md="6">
                            <div class="d-flex align-center gap-2">
                                <MudAutocomplete @bind-Value="@Model.FinancialAccount"
                                                 T="GetFinancialAccountTitleResponse ?"
                                                 For="@(() => Model.FinancialAccount)"
                                                 Label="@FinancialAccountLabelText"
                                                 Margin="Margin.Dense"
                                                 Disabled="Model.Disabled"
                                                 InputClass="text-truncate"
                                                 Variant="Variant.Outlined"
                                                 DebounceInterval="500"
                                                 Placeholder="جستجوی حساب مالی..."
                                                 MaxItems="100"
                                                 ToStringFunc="@(acc => acc?.Title)"
                                                 SearchFunc="SearchFinancialAccountsAsync"
                                                 ResetValueOnEmptyText="true" />
                                <MudIconButton Disabled="Model.Disabled" Icon="@Icons.Material.Filled.Add"
                                               Variant="Variant.Outlined" Color="Color.Primary" OnClick="OnAddFinancialAccount"></MudIconButton>
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="@(string.IsNullOrEmpty(Model.ExchangeRateLabel) ? 6 : 12)">
                            <MudTextField @bind-Value="@Model.ReferenceNumber"
                                          T="string"
                                          dir="ltr"
                                          For="@(() => Model.ReferenceNumber!)"
                                          Label="@(Model.GetDisplayName(() => Model.ReferenceNumber))"
                                          Margin="Margin.Dense"
                                          Disabled="Model.Disabled"
                                          AdornmentIcon="@Icons.Material.Filled.Numbers"
                                          Adornment="Adornment.End"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        break;
                    case PaymentType.CustomerTransfer:
                        <MudItem xs="12" md="6">
                            <div class="d-flex align-center gap-2">
                                <MudAutocomplete T="CustomerVm"
                                                 Value="Model.Endorser"
                                                 ValueChanged="OnEndorserChanged"
                                                 Text="@Model.Endorser?.FullName"
                                                 For="@(() => Model.Endorser!)"
                                                 Placeholder="جستجوی طرف حساب..."
                                                 Label="@(Model.GetDisplayName(() => Model.Endorser))"
                                                 ToStringFunc="@(customer => customer != null ? $"{customer.FullName}" : null)"
                                                 Margin="Margin.Dense"
                                                 FullWidth="true"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                                 Variant="Variant.Outlined"
                                                 SearchFunc="@SearchCustomers"
                                                 ResetValueOnEmptyText="true"
                                                 DebounceInterval="0"
                                                 ShowProgressIndicator="false">
                                </MudAutocomplete>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OnAddCustomer("طرف حساب"))" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudAutocomplete @bind-Value="@Model.TargetInvoice"
                                             T="GetTinyInvoiceResponse ?"
                                             For="@(() => Model.TargetInvoice)"
                                             Label="@Model.GetDisplayName(() => Model.TargetInvoice)"
                                             Margin="Margin.Dense"
                                             Disabled="@(Model.Endorser is null || Model.PaymentSide is PaymentSide.Receive)"
                                             Adornment="Adornment.End"
                                             AdornmentIcon="@Icons.Material.Outlined.ArrowDropDown"
                                             InputClass="text-truncate"
                                             Variant="Variant.Outlined"
                                             DebounceInterval="500"
                                             Placeholder="جستجوی فاکتور..."
                                             MaxItems="100"
                                             ToStringFunc="InvoiceToStringFunc"
                                             SearchFunc="SearchCustomerInvoicesAsync"
                                             ResetValueOnEmptyText="true" />
                        </MudItem>
                        break;
                    case PaymentType.UsedGoldInventory or PaymentType.MoltenGoldInventory:
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="@Model.GoldFineness"
                                          T="decimal?"
                                          Format="G29"
                                          dir="ltr"
                                          DebounceInterval="1"
                                          For="@(() => Model.GoldFineness!)"
                                          Label="@(Model.GetDisplayName(() => Model.GoldFineness))"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        break;
                    case PaymentType.Check:
                        <MudItem xs="12" md="6">
                            <div class="d-flex align-center gap-2">
                                <MudAutocomplete T="CustomerVm?"
                                                 Value="Model.CheckIssuer"
                                                 ValueChanged="OnCheckIssuerChanged"
                                                 Text="@Model.CheckIssuer?.FullName"
                                                 For="@(() => Model.CheckIssuer!)"
                                                 Placeholder="جستجوی صادر کننده چک..."
                                                 Label="@(Model.GetDisplayName(() => Model.CheckIssuer))"
                                                 ToStringFunc="@(customer => customer != null ? $"{customer.FullName}" : null)"
                                                 Margin="Margin.Dense"
                                                 FullWidth="true"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                                 Variant="Variant.Outlined"
                                                 SearchFunc="@SearchCustomers"
                                                 ResetValueOnEmptyText="true"
                                                 DebounceInterval="0"
                                                 ShowProgressIndicator="false">
                                </MudAutocomplete>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OnAddCustomer("صادر کننده چک"))" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <div class="d-flex align-center gap-2">
                                <div style="min-width: 0; flex: 1;">
                                    <MudSelect T="FinancialAccountVm"
                                               @bind-Value="Model.CheckIssuerFinancialAccount"
                                               Text="@Model.CheckIssuerFinancialAccount?.GetAccountTypeText()"
                                               For="@(() => Model.CheckIssuerFinancialAccount!)"
                                               Label="@(Model.GetDisplayName(() => Model.CheckIssuerFinancialAccount))"
                                               ToStringFunc="@(fa => fa != null ? $"{fa.GetAccountTypeText()}" : null)"
                                               Margin="Margin.Dense"
                                               FullWidth="true"
                                               Variant="Variant.Outlined"
                                               Disabled="@(Model.CheckIssuer == null)">
                                        @foreach (var item in _customerFinancialAccounts)
                                        {
                                            <MudSelectItem T="FinancialAccountVm" Value="@item">@item.GetAccountTypeText()</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary"
                                               Disabled="@(Model.CheckIssuer == null)"
                                               OnClick="@(() => OnAddCustomerFinancialAccount(Model.CheckIssuer!))" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="@Model.CheckNumber"
                                          T="string?"
                                          dir="ltr"
                                          For="@(() => Model.CheckNumber!)"
                                          Label="@(Model.GetDisplayName(() => Model.CheckNumber))"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.ConfirmationNumber"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="@Model.CheckSayadiCode"
                                          T="string?"
                                          dir="ltr"
                                          For="@(() => Model.CheckSayadiCode!)"
                                          Label="@(Model.GetDisplayName(() => Model.CheckSayadiCode))"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Numbers"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="Model.CheckDueDate"
                                           Color="Color.Secondary"
                                           Editable="true"
                                           dir="ltr"
                                           AnchorOrigin="Origin.TopCenter"
                                           TransformOrigin="Origin.BottomCenter"
                                           For="@(() => Model.CheckDueDate)"
                                           Label="@(Model.GetDisplayName(() => Model.CheckDueDate))"
                                           ImmediateText="true"
                                           Margin="Margin.Dense"
                                           Rounded="true"
                                           Variant="Variant.Outlined" />
                        </MudItem>
                        break;
                    case PaymentType.Coin when Model.CoinInstance is not null:
                        <MudItem xs="12" md="6">
                            <MudSelect T="GetCoinResponse?"
                                       Value="Model.CoinInstance.Coin"
                                       ValueChanged="OnCoinChanged"
                                       Label="@Model.GetDisplayName(() => Model.CoinInstance)"
                                       For="() => Model.CoinInstance.Coin"
                                       Margin="Margin.Dense"
                                       Variant="Variant.Outlined">
                                <MudSelectItem T="GetCoinResponse?" Value="null">انتخاب کنید...</MudSelectItem>
                                @foreach (var item in _coins)
                                {
                                    <MudSelectItem Value="item">@item.Title</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="decimal?"
                                             Value="Model.CoinUnitPrice"
                                             ValueChanged="OnCoinUnitPriceChanged"
                                             Label="@Model.GetDisplayName(() => Model.CoinUnitPrice)"
                                             For="() => Model.CoinUnitPrice"
                                             Format="#,##0.##"
                                             dir="ltr"
                                             DebounceInterval="1"
                                             HideSpinButtons="true"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             InputMode="InputMode.numeric"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Model.PriceUnit?.Title" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <div class="d-flex align-center gap-2">
                                <MudTooltip Arrow Color="Color.Primary" Text="کم کردن" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Variant="Variant.Outlined"
                                                   OnClick="@(() => DecreaseCoinQuantity())"
                                                   Disabled="@(Model.CoinQuantity <= 1)"
                                                   Color="Color.Primary" />
                                </MudTooltip>

                                <MudNumericField For="@(() => Model.CoinQuantity)"
                                                 Immediate="true"
                                                 dir="ltr"
                                                 Label="@Model.GetDisplayName(() => Model.CoinQuantity)"
                                                 Margin="Margin.Dense"
                                                 T="int?"
                                                 Min="1"
                                                 Value="Model.CoinQuantity"
                                                 ValueChanged="OnCoinQuantityChanged"
                                                 HideSpinButtons="true"
                                                 Variant="Variant.Outlined"
                                                 Style="flex: 1;" />

                                <MudTooltip Arrow Color="Color.Primary" Text="زیاد کردن" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined"
                                                   OnClick="@(() => IncreaseCoinQuantity())"
                                                   Color="Color.Primary" />
                                </MudTooltip>
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField Adornment="Adornment.End"
                                             AdornmentText="@GoldUnitType.Gram.GetDisplayName()"
                                             For="() => Model.CoinInstance.Weight"
                                             dir="ltr"
                                             Disabled="Model.CoinInstance.MintType == CoinMintType.Banking"
                                             Format="G29"
                                             DebounceInterval="1"
                                             HideSpinButtons="true"
                                             Margin="Margin.Dense"
                                             Label="@(Model.GetDisplayName(() => Model.CoinInstance.Weight))"
                                             T="decimal?"
                                             @bind-Value="Model.CoinInstance.Weight"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField For="@(() => Model.CoinInstance.Fineness)"
                                             Format="G29"
                                             DebounceInterval="1"
                                             dir="ltr"
                                             Label="@Model.GetDisplayName(() => Model.CoinInstance.Fineness)"
                                             Margin="Margin.Dense"
                                             Disabled="Model.CoinInstance.MintType == CoinMintType.Banking"
                                             T="decimal"
                                             @bind-Value="Model.CoinInstance.Fineness"
                                             HideSpinButtons="true"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        @if (Model.CoinInstance.PackageType is CoinPackageType.VacuumSealed && Model.CoinInstance.CoinPackage is not null)
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.body2" Class="mt-2 font-weight-bold">مشخصات بسته‌بندی وکیوم:</MudText>
                                <MudDivider Class="my-2" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudNumericField Adornment="Adornment.End"
                                                 AdornmentText="@GoldUnitType.Gram.GetDisplayName()"
                                                 For="() => Model.CoinInstance.CoinPackage.VacuumedWeight"
                                                 dir="ltr"
                                                 Format="G29"
                                                 DebounceInterval="1"
                                                 HideSpinButtons="true"
                                                 Margin="Margin.Dense"
                                                 Label="@(Model.GetDisplayName(() => Model.CoinInstance.CoinPackage.VacuumedWeight))"
                                                 T="decimal?"
                                                 @bind-Value="Model.CoinInstance.CoinPackage.VacuumedWeight"
                                                 Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="Model.CoinInstance.CoinPackage.StandardCode"
                                              For="() => Model.CoinInstance.CoinPackage.StandardCode!"
                                              Label="@Model.GetDisplayName(() => Model.CoinInstance.CoinPackage.StandardCode)"
                                              Margin="Margin.Dense"
                                              dir="ltr"
                                              T="string"
                                              Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <div class="d-flex flex-row align-center gap-2">
                                    <MudAutocomplete T="CustomerVm"
                                                     @bind-Value="Model.CoinInstance.CoinPackage.Issuer"
                                                     Text="@(Model.CoinInstance.CoinPackage.Issuer != null ? $"{Model.CoinInstance.CoinPackage.Issuer.FullName} ({Model.CoinInstance.CoinPackage.Issuer.NationalId})" : null)"
                                                     For="@(() => Model.CoinInstance.CoinPackage.Issuer!)"
                                                     Placeholder="جستجوی کارگاه..."
                                                     Label="@(Model.GetDisplayName(() => Model.CoinInstance.CoinPackage.Issuer))"
                                                     ToStringFunc="@(issuer => issuer != null ? $"{issuer.FullName} ({issuer.NationalId})" : null)"
                                                     Margin="Margin.Dense"
                                                     Adornment="Adornment.Start"
                                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                                     Variant="Variant.Outlined"
                                                     SearchFunc="@SearchWorkshopCustomers"
                                                     ResetValueOnEmptyText="true"
                                                     DebounceInterval="0"
                                                     ShowProgressIndicator="false">
                                    </MudAutocomplete>
                                    <MudTooltip Arrow Color="Color.Primary" Text="نمایندگی جدید" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary" OnClick="OnAddWorkshopCustomer" />
                                    </MudTooltip>
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <div class="d-flex flex-row align-center gap-2">
                                    <MudColorPicker @bind-Text="Model.CoinInstance.CoinPackage.CardColor"
                                                    @ref="_colorPicker"
                                                    Label="@Model.GetDisplayName(() => Model.CoinInstance.CoinPackage.CardColor)"
                                                    ColorPickerView="ColorPickerView.Palette"
                                                    TransformOrigin="Origin.TopRight"
                                                    AnchorOrigin="Origin.BottomCenter"
                                                    Palette="@_colorPalette"
                                                    Variant="Variant.Outlined"
                                                    Margin="Margin.Dense"
                                                    Elevation="24" />

                                    @if (!string.IsNullOrEmpty(Model.CoinInstance.CoinPackage.CardColor))
                                    {
                                        <div style="width: 30px; height: 30px; border-radius: 16px; border: 1px solid #ccc; background: @Model.CoinInstance.CoinPackage.CardColor; cursor: pointer;"
                                             @onclick="OpenColorPicker">
                                        </div>
                                    }
                                </div>
                            </MudItem>
                        }
                        <MudItem xs="12" md="6">
                            <MudDatePicker OpenTo="OpenTo.Year"
                                           FixMonth="1" FixDay="1"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           MinDate="@(GetCoinMinDate())"
                                           MaxDate="@(GetCoinMaxDate())"
                                           RelativeWidth="DropdownWidth.Relative"
                                           ShowToolbar="false"
                                           DateFormat="yyyy"
                                           dir="ltr"
                                           Label="@Model.GetDisplayName(() => Model.CoinInstance.MintYear)"
                                           @bind-Date="Model.CoinInstance.MintYear" />
                        </MudItem>
                        break;
                }

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="Model.PaymentDate"
                                   Color="Color.Secondary"
                                   Editable="true"
                                   dir="ltr"
                                   Disabled="Model.Disabled"
                                   AnchorOrigin="Origin.TopCenter"
                                   TransformOrigin="Origin.BottomCenter"
                                   For="@(() => Model.PaymentDate)"
                                   Label="@(Model.GetDisplayName(() => Model.PaymentDate))"
                                   ImmediateText="true"
                                   Margin="Margin.Dense"
                                   Rounded="true"
                                   Variant="Variant.Outlined" />
                </MudItem>

                @if (Model.PaymentType is PaymentType.Check)
                {
                    <MudItem xs="12" md="6">
                        <MudFileUpload T="IBrowserFile"
                                       @bind-Files="Model.CheckImageFile"
                                       For="@(() => Model.CheckImageFile!)"
                                       Accept="image/*"
                                       Style="margin-top: 9px;"
                                       OnFilesChanged="OnCheckImageChanged">
                            <CustomContent Context="ctx">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           OnClick="ctx.OpenFilePickerAsync"
                                           FullWidth="true">
                                    @(_checkImagePreviewUrl == null ? "بارگذاری تصویر چک" : "تغییر تصویر چک")
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>
                    </MudItem>
                }

                @if (_checkImagePreviewUrl != null)
                {
                    <MudItem xs="12">
                        <div class="image-fieldset rounded-5">
                            <fieldset>
                                <legend>تصویر چک</legend>
                                <div class="image-preview-container">
                                    <MudImage Src="@_checkImagePreviewUrl"
                                              Alt="تصویر چک"
                                              ObjectFit="ObjectFit.Cover"
                                              Class="rounded check-image" />
                                    <div class="image-overlay rounded-5">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                       Color="Color.Default"
                                                       Size="Size.Medium"
                                                       OnClick="@(() => JsRuntime.InvokeVoidAsync("openImageInNewTab", _checkImagePreviewUrl))" />
                                        <MudFileUpload T="IBrowserFile"
                                                       @bind-Files="Model.CheckImageFile"
                                                       For="@(() => Model.CheckImageFile!)"
                                                       Accept="image/*"
                                                       OnFilesChanged="OnCheckImageChanged">
                                            <CustomContent Context="ctx">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Color="Color.Default"
                                                               Size="Size.Medium"
                                                               OnClick="ctx.OpenFilePickerAsync" />
                                            </CustomContent>
                                        </MudFileUpload>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Default"
                                                       Size="Size.Medium"
                                                       OnClick="ClearCheckImage" />
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </MudItem>
                }


                <MudItem xs="12">
                    <MudTextField @bind-Value="@Model.Note"
                                  T="string"
                                  For="@(() => Model.Note!)"
                                  Label="@(Model.GetDisplayName(() => Model.Note))"
                                  Margin="Margin.Dense"
                                  AdornmentIcon="@Icons.Material.Filled.Notes"
                                  Adornment="Adornment.End"
                                  Lines="3"
                                  Disabled="Model.Disabled"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <div class="price-container d-flex align-center justify-content-between w-100 flex-wrap">
                <div class="d-flex gap-2 mr-md-4">
                    @if (Model.PriceUnit?.Id == BasePriceUnit.Id)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Primary" OnClick="ApplyTotalRemaining" Variant="Variant.Outlined" />
                    }
                    <MudText Class="price-text" Typo="Typo.h6" Color="@RemainingColor">
                        @RemainingLabel @(TotalRemainingCalculated != 0 ? Math.Abs(TotalRemainingCalculated).ToCurrencyFormat(BasePriceUnit.Title) : "")
                    </MudText>
                </div>

                <div class="button-group">
                    <MudButton Color="Color.Error"
                               OnClick="Close"
                               StartIcon="@Icons.Material.Filled.Close"
                               Variant="Variant.Filled">انصراف</MudButton>
                    <MudButton Class="m-2"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="Submit"
                               Variant="Variant.Filled">ذخیره</MudButton>
                </div>
            </div>
        </DialogActions>
    </MudDialog>
</MudForm>

<script>
    window.createObjectURL = async (streamRef) => {
        const buffer = await streamRef.arrayBuffer();
        const blob = new Blob([buffer], { type: "image/*" });
        return URL.createObjectURL(blob);
    };

    window.openImageInNewTab = (url) => {
        const newTab = window.open();
        newTab.document.body.innerHTML = `<img src="${url}" style="max-width: 100%; height: auto;" />`;
    };
</script>

<style>
    .mud-file-upload-files {
        display: none;
    }
</style>