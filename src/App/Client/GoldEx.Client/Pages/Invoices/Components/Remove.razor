@using GoldEx.Client.Components.Components.Dialogs
@inherits GoldExComponentBase
<EditorDialogFrame>
    <DialogContent>
        <div class="gex-delete-confirm">
            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Error" Size="Size.Large" />
            <h3>حذف فاکتور @InvoiceNumber</h3>
            <p>آیا از حذف این فاکتور اطمینان دارید؟</p>
            <p>این عملیات غیرقابل بازگشت است و ممکن است موجودی و مانده حساب را تغییر دهد.</p>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Outlined" Disabled="@IsBusy" OnClick="Cancel">انصراف</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@IsBusy"
                   StartIcon="@Icons.Material.Filled.Delete" OnClick="OnValidSubmit">
            @(IsBusy ? "در حال حذف…" : "حذف فاکتور")
        </MudButton>
    </DialogActions>
</EditorDialogFrame>