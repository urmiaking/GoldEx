@inherits GoldExComponentBase
<div class="invoice-line-list">
    <div class="invoice-line-toolbar">
        <div class="invoice-line-toolbar-info"><strong>طلای مستعمل</strong><span>@Items.Count قلم</span></div>
        <div class="invoice-line-toolbar-actions">


            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Outlined.Add" OnClick="OnAddItem">افزودن طلای مستعمل</MudButton>
        </div>
    </div>
    @if (Items.Count == 0)
    {
        <div class="invoice-line-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
            <strong>هنوز قلمی در این گروه ثبت نشده</strong>
            <span>برای شروع، «افزودن طلای مستعمل» را انتخاب کنید.</span>
        </div>
    }
    else
    {
        <div class="invoice-line-desktop">
            <table>
                <thead><tr>
            <th scope="col">ردیف</th>
            <th scope="col">عنوان</th>
            <th scope="col">کسری عیار</th>
            <th scope="col">وزن</th>
            <th scope="col">ارزش کالا</th>
            <th scope="col">مخارج جانبی</th>
            <th scope="col">ارزش کل</th>
            <th scope="col">عملیات</th>
        </tr></thead>
                <tbody>
                    @foreach (var context in Items)
                    {
                        <tr @key="context">

            <td>@context.Index</td>
            <td>
                <div class="d-flex gap-2">
                    @if (context.IsBroken)
                    {
                        <MudIcon Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.BrokenImage" />
                    }
                    else
                    {
                        <MudIcon Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" />
                    }
                    @context.Description
                </div>
            </td>
            <td>@context.FinenessDeductionRate.ToString("G29")</td>
            <td>@context.Weight?.ToString("G29") @context.UnitType.GetDisplayName()</td>
            <td>@context.ItemAmount.ToCurrencyFormat(PriceUnit?.Title)</td>
            <td>@context.ExtraCostsAmount?.ToCurrencyFormat(PriceUnit?.Title)</td>
            <td>@context.ItemFinalAmount.ToCurrencyFormat(PriceUnit?.Title)</td>
            <td>
                <div class="d-flex gap-2">
                    <MudTooltip Text="چاپ بارکد">
                        <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Variant="Variant.Outlined"
                                       Color="Color.Success" OnClick="() => OnPrintBarcode.InvokeAsync(context)"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="ویرایش جنس">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Outlined"
                                       Color="Color.Primary" OnClick="() => OnEditItem.InvokeAsync(context)"></MudIconButton>
                    </MudTooltip>
                    <MudTooltip Text="حذف جنس">
                        <MudIconButton OnClick="@(_ => OnRemoveItem.InvokeAsync(context))" ClickPropagation="true"
                                       Size="@Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Delete" Color="@Color.Error"></MudIconButton>
                    </MudTooltip>
                </div>
            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="invoice-line-mobile">
            @foreach (var item in Items)
            {
                <div class="invoice-line-card" @key="item">
<header><span class="invoice-line-kind">@(item.IsBroken ? "طلای شکسته" : "طلای مستعمل")</span><strong>@item.ItemFinalAmount.ToCurrencyFormat(PriceUnit?.Title)</strong></header><h3>@item.Description</h3>
<div class="invoice-line-facts"><div><span>وزن</span><strong>@item.Weight?.ToString("G29") @item.UnitType.GetDisplayName()</strong></div><div><span>کسری عیار</span><strong>@item.FinenessDeductionRate.ToString("G29")</strong></div><div><span>ارزش جنس</span><strong>@item.ItemAmount.ToCurrencyFormat(PriceUnit?.Title)</strong></div><div><span>مخارج</span><strong>@item.ExtraCostsAmount?.ToCurrencyFormat(PriceUnit?.Title)</strong></div></div>
<footer><MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => OnEditItem.InvokeAsync(item)">ویرایش</MudButton>
<MudIconButton Icon="@Icons.Material.Outlined.Print" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" aria-label="چاپ بارکد" OnClick="() => OnPrintBarcode.InvokeAsync(item)" />
<MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" aria-label="حذف مستعمل" OnClick="() => OnRemoveItem.InvokeAsync(item)" /></footer></div>
            }
        </div>
    }
</div>