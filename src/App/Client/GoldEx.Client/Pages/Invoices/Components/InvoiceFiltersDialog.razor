@inherits GoldExComponentBase
@using GoldEx.Client.Components.Components.Dialogs

<EditorDialogFrame>
    <DialogContent>
        <div class="gex-directory-filter-form">
            <p class="gex-filter-description mud-typography-body2">فاکتورها را بر اساس تاریخ، نوع معامله و وضعیت پرداخت محدود کنید.</p>
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudDateRangePicker DateRange="@_dateRange"
                                        DateRangeChanged="@(dr => _dateRange = dr)"
                                        Variant="Variant.Outlined" Label="تاریخ فاکتور"
                                        Margin="Margin.Dense" MaxMonthColumns="1"
                                        DisplayMonths="1" ShowToolbar="false"
                                        Adornment="Adornment.Start" Clearable Class="w-100 gex-desktop-filter-date" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="InvoiceType?" Variant="Variant.Outlined" Label="نوع فاکتور"
                               Value="@_invoiceType" ValueChanged="@(v => _invoiceType = v)"
                               Dense="true" Margin="Margin.Dense" Adornment="Adornment.Start"
                               AdornmentIcon="@GetInvoiceTypeIcon(_invoiceType)"
                               AdornmentColor="@GetInvoiceTypeColor(_invoiceType)" Class="w-100">
                        <MudSelectItem T="InvoiceType?" Value="@(null as InvoiceType?)">همه</MudSelectItem>
                        <MudSelectItem T="InvoiceType?" Value="@InvoiceType.Purchase">@InvoiceType.Purchase.GetDisplayName()</MudSelectItem>
                        <MudSelectItem T="InvoiceType?" Value="@InvoiceType.Sell">@InvoiceType.Sell.GetDisplayName()</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="TradeScale?" Variant="Variant.Outlined" Label="نوع معامله"
                               Value="@_tradeScale" ValueChanged="@(v => _tradeScale = v)"
                               Dense="true" Margin="Margin.Dense" Adornment="Adornment.Start"
                               AdornmentIcon="@GetTradeScaleIcon(_tradeScale)"
                               AdornmentColor="@GetTradeScaleColor(_tradeScale)" Class="w-100">
                        <MudSelectItem T="TradeScale?" Value="@(null as TradeScale?)">همه</MudSelectItem>
                        <MudSelectItem T="TradeScale?" Value="@TradeScale.Wholesale">@TradeScale.Wholesale.GetDisplayName()</MudSelectItem>
                        <MudSelectItem T="TradeScale?" Value="@TradeScale.Retail">@TradeScale.Retail.GetDisplayName()</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="InvoicePaymentStatus?" Variant="Variant.Outlined" Label="وضعیت پرداخت"
                               Value="@_paymentStatus" ValueChanged="@(v => _paymentStatus = v)"
                               Dense="true" Margin="Margin.Dense" Adornment="Adornment.Start"
                               AdornmentIcon="@GetPaymentStatusIcon(_paymentStatus)"
                               AdornmentColor="@GetPaymentStatusColor(_paymentStatus)" Class="w-100">
                        <MudSelectItem T="InvoicePaymentStatus?" Value="@(null as InvoicePaymentStatus?)">همه</MudSelectItem>
                        <MudSelectItem T="InvoicePaymentStatus?" Value="@InvoicePaymentStatus.HasDebt">@InvoicePaymentStatus.HasDebt.GetDisplayName()</MudSelectItem>
                        <MudSelectItem T="InvoicePaymentStatus?" Value="@InvoicePaymentStatus.Overdue">@InvoicePaymentStatus.Overdue.GetDisplayName()</MudSelectItem>
                        <MudSelectItem T="InvoicePaymentStatus?" Value="@InvoicePaymentStatus.Paid">@InvoicePaymentStatus.Paid.GetDisplayName()</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" Class="gex-filter-mobile-sort">
                    <div class="gex-filter-section-title"><ShellIcon Name="list" /><span>مرتب‌سازی نمایش</span></div>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Label="مرتب‌سازی بر اساس" @bind-Value="_sortLabel"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="@("InvoiceNumber")">شماره فاکتور</MudSelectItem>
                                <MudSelectItem Value="@("Customer.FullName")">نام مشتری</MudSelectItem>
                                <MudSelectItem Value="@("InvoiceType")">نوع فاکتور</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="bool" Label="ترتیب نمایش" @bind-Value="_sortDescending"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem T="bool" Value="false">صعودی</MudSelectItem>
                                <MudSelectItem T="bool" Value="true">نزولی</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Clear"
                   StartIcon="@Icons.Material.Filled.Delete">بازنشانی</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   OnClick="Cancel" StartIcon="@Icons.Material.Filled.Close">انصراف</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Apply" StartIcon="@Icons.Material.Filled.Check">اعمال فیلترها</MudButton>
    </DialogActions>
</EditorDialogFrame>
