@inherits GoldExComponentBase

<MudDialog Class="inventory-item-selector-dialog"
           ContentClass="inventory-item-selector-content">
    <DialogContent>
        <style>
            .inventory-item-selector-dialog .mud-dialog-content,
            .inventory-item-selector-content {
                max-height: 70vh !important;
                overflow-y: auto !important;
                overflow-x: auto !important;
            }
        </style>
        <InventoryStockList ItemStatus="ItemStatus" 
                            Elevation="0"
                            SelectableTypes="SelectableTypes"
                            ShowItemStatus="false"
                            Selectable="true" 
                            SelectedItemsChanged="OnSelectedItemsChanged">
        </InventoryStockList>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error"
                   OnClick="Close"
                   StartIcon="@Icons.Material.Filled.Close"
                   Variant="Variant.Filled">انصراف</MudButton>

        <MudButton Class="m-2"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="OnSubmit"
                   Variant="Variant.Filled">
            <MudText>ثبت</MudText>
        </MudButton>
    </DialogActions>
</MudDialog>