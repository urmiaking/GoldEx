@inherits GoldExComponentBase

<div class="invoice-adjustments-list">
    <div class="invoice-adjustments-toolbar">
        <span>ردیف‌های مخارج جانبی</span>
        <MudButton Class="invoice-adjustments-add" Color="Color.Primary" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Add" OnClick="AddItem">
            افزودن هزینه
        </MudButton>
    </div>
    <div class="invoice-adjustments-rows">
        @foreach (var item in Items)
        {
            <div class="invoice-adjustments-row" @key="item">
                <div class="invoice-adjustments-row-head">
                    <span>هزینه @(Items.IndexOf(item) + 1)</span>
                    <MudTooltip Text="حذف ردیف">
                        <MudIconButton Class="invoice-adjustments-delete"
                                       Icon="@Icons.Material.Outlined.DeleteOutline"
                                       Size="Size.Small" Color="Color.Error"
                                       OnClick="() => RemoveItem(item)" />
                    </MudTooltip>
                </div>
                <div class="invoice-adjustments-fields">
                    <div class="invoice-adjustments-money">
                        <MudNumericField T="decimal" @bind-Value="item.Amount"
                                         For="@(() => item.Amount)"
                                         Label="مبلغ هزینه" Format="#,##0.##"
                                         Margin="Margin.Dense" Variant="Variant.Outlined"
                                         Adornment="Adornment.End"
                                         AdornmentText="@item.AmountAdornmentText"
                                         HideSpinButtons="true" DebounceInterval="1" />
                        <MudMenu>
                            <ActivatorContent Context="menu">
                                <MudIconButton Class="invoice-adjustments-unit"
                                               Icon="@Icons.Material.Outlined.CurrencyExchange"
                                               Color="Color.Primary" Variant="Variant.Outlined"
                                               aria-label="انتخاب واحد هزینه" OnClick="menu.ToggleAsync" />
                            </ActivatorContent>
                            <ChildContent>
                                @foreach (var price in PriceUnits)
                                {
                                    <MudMenuItem OnClick="() => SelectPriceUnit(price, item)">
                                        @price.Title
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    </div>
                    <MudTextField T="string" @bind-Value="item.Description"
                                  For="@(() => item.Description!)"
                                  Label="شرح هزینه" Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Immediate="true" DebounceInterval="200" />
                    @if (item.PriceUnit != PriceUnit)
                    {
                        <MudNumericField T="decimal?" @bind-Value="item.ExchangeRate"
                                         For="@(() => item.ExchangeRate)"
                                         Class="invoice-adjustments-rate"
                                         Label="@item.ExchangeRateLabel"
                                         Format="#,##0.########"
                                         HideSpinButtons="true" DebounceInterval="1"
                                         Margin="Margin.Dense" Variant="Variant.Outlined" />
                    }
                </div>
            </div>
        }
    </div>
    <div class="invoice-adjustments-summary">
        <div>
            <span>جمع مخارج جانبی</span>
            <strong>@Items.Sum(x => x.Amount * (x.ExchangeRate ?? 1)).ToCurrencyFormat(PriceUnit.Title)</strong>
        </div>
    </div>
</div>