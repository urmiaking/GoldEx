@using GoldEx.Client.Components.Components.Dialogs
@inherits GoldExComponentBase

<EditorDialogFrame>
    <DialogContent>
        <section class="invoice-settlement" aria-label="تسویه فاکتور">
            <nav class="invoice-settlement-progress" aria-label="مراحل تسویه">
                <span class="@(_step == SettlementStep.Direction ? "is-current" : "is-complete")">۱. جهت تسویه</span>
                <span class="invoice-settlement-progress-line"></span>
                <span class="@(_step == SettlementStep.Method ? "is-current" : _step == SettlementStep.Review ? "is-complete" : "")">۲. روش تسویه</span>
                <span class="invoice-settlement-progress-line"></span>
                <span class="@(_step == SettlementStep.Review ? "is-current" : "")">۳. مرور تسویه‌ها</span>
            </nav>

            <div @key="_step" class="invoice-settlement-stage @(_isLeaving ? "is-leaving" : "")">
            @if (_step == SettlementStep.Direction)
            {
                <div class="invoice-settlement-intro">
                    <span class="invoice-settlement-eyebrow">مرحله اول</span>
                    <h3>وجه یا جنس از کدام طرف جابه‌جا می‌شود؟</h3>
                    <p>برای ثبت درست مانده حساب، ابتدا مشخص کنید از طرف‌حساب دریافت دارید یا به او پرداخت می‌کنید.</p>
                    <div class="invoice-settlement-balance">
                        <span>@CurrentRemainingLabel</span>
                        <strong>@Math.Abs(CurrentRemaining).ToCurrencyFormat(PriceUnit.Title)</strong>
                    </div>
                </div>
                <div class="invoice-settlement-directions">
                    <button type="button" class="invoice-settlement-direction is-receive"
                            @onclick="() => SelectSide(PaymentSide.Receive)">
                        <span class="invoice-settlement-direction-icon"><MudIcon Icon="@Icons.Material.Outlined.CallReceived" /></span>
                        <span class="invoice-settlement-direction-info">
                            <strong>@ReceiveTitle</strong>
                            <small>@ReceiveDescription</small>
                            <span>انتخاب و ادامه <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" /></span>
                        </span>
                    </button>
                    <button type="button" class="invoice-settlement-direction is-pay"
                            @onclick="() => SelectSide(PaymentSide.Pay)">
                        <span class="invoice-settlement-direction-icon"><MudIcon Icon="@Icons.Material.Outlined.CallMade" /></span>
                        <span class="invoice-settlement-direction-info">
                            <strong>@PayTitle</strong>
                            <small>@PayDescription</small>
                            <span>انتخاب و ادامه <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" /></span>
                        </span>
                    </button>
                </div>
                @if (Items.Count > 0)
                {
                    <button type="button" class="invoice-settlement-review-link" @onclick="ShowReview">
                        <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" />
                        مشاهده @Items.Count تسویه ثبت‌شده
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                    </button>
                }
            }
            else if (_step == SettlementStep.Method)
            {
                <div class="invoice-settlement-method-header">
                    <button type="button" class="invoice-settlement-back" @onclick="GoBackToDirection"
                            aria-label="بازگشت به انتخاب جهت">
                        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" /> بازگشت
                    </button>
                    <span class="invoice-settlement-selected-side @(_selectedSide == PaymentSide.Receive ? "is-receive" : "is-pay")">
                        <MudIcon Icon="@(_selectedSide == PaymentSide.Receive ? Icons.Material.Outlined.SouthWest : Icons.Material.Outlined.NorthEast)" Size="Size.Small" />
                        @(_selectedSide == PaymentSide.Receive ? ReceiveTitle : PayTitle)
                    </span>
                </div>
                <div class="invoice-settlement-intro">
                    <span class="invoice-settlement-eyebrow">مرحله دوم</span>
                    <h3>روش تسویه را انتخاب کنید</h3>
                    <p>مشخص کنید وجه، چک یا جنس چگونه جابه‌جا می‌شود. در مرحله بعد جزئیات و مبلغ را ثبت می‌کنید.</p>
                </div>
                <div class="invoice-settlement-methods">
                    <button type="button" class="invoice-settlement-method" @onclick="() => OnAddPayment(PaymentType.InternalCash)">
                        <span class="invoice-settlement-method-top">
                            <span class="invoice-settlement-method-icon"><MudIcon Icon="@Icons.Material.Outlined.Payments" /></span>
                            <strong>نقدی و حساب بانکی</strong>
                        </span>
                        <small>ثبت وجه نقد یا تراکنش حساب مالی فروشگاه</small>
                    </button>
                    <button type="button" class="invoice-settlement-method" @onclick="() => OnAddPayment(PaymentType.CustomerTransfer)">
                        <span class="invoice-settlement-method-top">
                            <span class="invoice-settlement-method-icon"><MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" /></span>
                            <strong>حواله</strong>
                        </span>
                        <small>ثبت انتقال وجه بین طرف‌حساب‌ها</small>
                    </button>
                    <button type="button" class="invoice-settlement-method" @onclick="() => OnAddPayment(PaymentType.Check)">
                        <span class="invoice-settlement-method-top">
                            <span class="invoice-settlement-method-icon"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span>
                            <strong>چک بانکی</strong>
                        </span>
                        <small>ثبت چک دریافتی یا پرداختی و مشخصات آن</small>
                    </button>
                    <button type="button" class="invoice-settlement-method" @onclick="() => OnAddPayment(PaymentType.UsedGoldInventory)">
                        <span class="invoice-settlement-method-top">
                            <span class="invoice-settlement-method-icon"><MudIcon Icon="@Icons.Material.Outlined.Recycling" /></span>
                            <strong>طلای شکسته</strong>
                        </span>
                        <small>تسویه بر اساس وزن و عیار طلای مستعمل</small>
                    </button>
                    <button type="button" class="invoice-settlement-method" @onclick="() => OnAddPayment(PaymentType.MoltenGoldInventory)">
                        <span class="invoice-settlement-method-top">
                            <span class="invoice-settlement-method-icon"><MudIcon Icon="@Icons.Material.Outlined.Whatshot" /></span>
                            <strong>طلای آب‌شده</strong>
                        </span>
                        <small>ثبت دریافت یا تحویل طلای آب‌شده</small>
                    </button>
                    <button type="button" class="invoice-settlement-method" @onclick="() => OnAddPayment(PaymentType.Coin)">
                        <span class="invoice-settlement-method-top">
                            <span class="invoice-settlement-method-icon"><MudIcon Icon="@Icons.Material.Outlined.Toll" /></span>
                            <strong>سکه</strong>
                        </span>
                        <small>تسویه با سکه، همراه تعداد و مشخصات سکه</small>
                    </button>
                </div>
            }
            else
            {
                <div class="invoice-settlement-review-heading">
                    <div>
                        <span class="invoice-settlement-eyebrow">مرحله سوم</span>
                        <h3>مرور تسویه‌های فاکتور</h3>
                        <p>پرداخت‌ها و دریافت‌های ثبت‌شده را بررسی کنید و سپس تأیید کنید.</p>
                    </div>
                    <button type="button" class="invoice-settlement-add-more" @onclick="GoBackToDirection">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                        تسویه دیگر
                    </button>
                </div>
                <div class="invoice-payment-dialog">
            @if (Items.Count == 0)
            {
                <div class="invoice-payment-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" Size="Size.Large" />
                    <strong>هنوز تسویه‌ای ثبت نشده است</strong>
                    <span>برای ثبت نخستین تسویه، گزینه «تسویه دیگر» را انتخاب کنید.</span>
                </div>
            }
            else
            {
                <div class="invoice-payment-desktop">
                    <table class="invoice-payment-table">
                        <colgroup>
                            <col class="invoice-payment-col-type" />
                            <col class="invoice-payment-col-amount" />
                            <col class="invoice-payment-col-date" />
                            <col class="invoice-payment-col-description" />
                            <col class="invoice-payment-col-actions" />
                        </colgroup>
                        <thead><tr><th>نوع</th><th>مبلغ یا وزن</th><th>تاریخ</th><th>شرح</th><th>عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var item in Items)
                            {
                                <tr @key="item">
                                    <td>@item.PaymentType.GetDisplayTitle()</td>
                                    <td><strong>@item.Amount.ToCurrencyFormat(item.PriceUnit?.Title)</strong></td>
                                    <td>@item.PaymentDate?.ToString("yyyy/MM/dd")</td>
                                    <td><span class="invoice-payment-description" title="@item.Description">@(!string.IsNullOrWhiteSpace(item.Description) ? item.Description : "—")</span></td>
                                    <td>
                                        @if (item.PaymentType is not PaymentType.TransferedPayment)
                                        {
                                            <div class="invoice-payment-row-actions">
                                                <button type="button" aria-label="ویرایش پرداخت" title="ویرایش پرداخت" @onclick="() => OnEdit(item)"><ShellIcon Name="edit" /></button>
                                                <button type="button" class="is-danger" aria-label="حذف پرداخت" title="حذف پرداخت" @onclick="() => OnDelete(item)"><ShellIcon Name="trash" /></button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="invoice-payment-mobile">
                    @foreach (var item in Items)
                    {
                        <article class="invoice-payment-card" @key="item">
                            <div class="invoice-payment-card-primary">
                                <div class="invoice-payment-card-type">
                                    <span>@item.PaymentType.GetDisplayTitle()</span>
                                    <small>@item.PaymentDate?.ToString("yyyy/MM/dd")</small>
                                </div>
                                <strong>@item.Amount.ToCurrencyFormat(item.PriceUnit?.Title)</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p title="@item.Description">@item.Description</p>
                            }
                            @if (item.PaymentType is not PaymentType.TransferedPayment)
                            {
                                <div class="invoice-payment-row-actions">
                                    <button type="button" aria-label="ویرایش پرداخت" @onclick="() => OnEdit(item)"><ShellIcon Name="edit" /></button>
                                    <button type="button" class="is-danger" aria-label="حذف پرداخت" @onclick="() => OnDelete(item)"><ShellIcon Name="trash" /></button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            <div class="invoice-payment-totals" aria-label="جمع پرداخت‌ها">
                @if (TotalReceiptsAmount > 0)
                {
                    <div><span>جمع دریافتی‌ها</span><strong class="is-receipt">@TotalReceiptsAmount.ToCurrencyFormat(PriceUnit.Title)</strong></div>
                }
                @if (TotalPaymentsAmount > 0)
                {
                    <div><span>جمع پرداختی‌ها</span><strong class="is-payment">@TotalPaymentsAmount.ToCurrencyFormat(PriceUnit.Title)</strong></div>
                }
            </div>
            <div class="invoice-settlement-balance invoice-settlement-review-balance">
                <span>@CurrentRemainingLabel</span>
                <strong>@Math.Abs(CurrentRemaining).ToCurrencyFormat(PriceUnit.Title)</strong>
            </div>
                </div>
            }
            </div>
        </section>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="Close">انصراف</MudButton>
        <MudSpacer />
        @if (_step == SettlementStep.Review)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Check" OnClick="Save">
                تأیید تسویه‌ها
            </MudButton>
        }
    </DialogActions>
</EditorDialogFrame>