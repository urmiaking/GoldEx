<div class="invoice-workspace invoice-workspace-loading">
    <header class="invoice-workspace-heading">
        <div class="invoice-workspace-title"><h1>@(IsEditMode ? "ویرایش فاکتور" : "ثبت فاکتور")</h1></div>
        <div class="invoice-workspace-heading-meta">
            <span><MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="75px" Height="21px" /></span>
            <span><MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="80px" Height="21px" /></span>
        </div>
    </header>
    <nav class="invoice-workspace-steps" aria-label="مراحل ثبت فاکتور">
        <span>۱ اطلاعات اصلی</span><span>۲ طرف‌حساب</span><span>۳ اقلام فاکتور</span><span>۴ تسویه و جمع‌بندی</span>
    </nav>
    <div class="invoice-workspace-columns">
        <main class="invoice-workspace-main">
            <div class="invoice-workspace-top">
                <section class="invoice-section invoice-core-section">
                    <div class="invoice-section-header"><span class="invoice-section-icon"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span><h2>مشخصات فاکتور</h2></div>
                    <div class="invoice-core-primary-grid">
                        @foreach (var label in new[] { "شماره فاکتور", "تاریخ فاکتور", "موعد تسویه" })
                        {
                            <div class="invoice-core-field">
                                <span class="invoice-skeleton-label">@label</span>
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="35px" />
                            </div>
                        }
                    </div>
                    <div class="invoice-core-price-strip">
                        <span class="invoice-core-strip-title">واحد محاسبه</span>
                        <div class="invoice-core-price-controls">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Width="125px" Height="36px" />
                        </div>
                    </div>
                </section>
                <section class="invoice-section invoice-customer-section">
                    <div class="invoice-section-header"><span class="invoice-section-icon"><MudIcon Icon="@Icons.Material.Outlined.PersonOutline" /></span><h2>طرف‌حساب</h2></div>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="38px" />
                    <div class="invoice-customer-card">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="80%" Height="29px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="55%" Height="19px" />
                        <span class="invoice-skeleton-label">مانده طرف‌حساب</span>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="55%" Height="23px" />
                    </div>
                </section>
            </div>
            <section class="invoice-section invoice-lines-section">
                <div class="invoice-section-header"><span class="invoice-section-icon"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" /></span><h2>اقلام فاکتور</h2></div>
                <div class="invoice-skeleton-tabs"><span>طلا و جواهر</span><span>سکه</span><span>ارز</span><span>طلای مستعمل</span></div>
                <div class="invoice-skeleton-toolbar">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="36px" />
                    <span>افزودن جنس</span>
                </div>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="100px" />
            </section>
        </main>
        <aside class="invoice-workspace-side">
            <div class="invoice-settlement-main">
                <section class="invoice-section invoice-financial-card">
                    <div class="invoice-section-header"><span class="invoice-section-icon"><MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" /></span><h2>مالی و تسویه</h2></div>
                    <div class="invoice-financial-total">
                        <span>مبلغ نهایی فاکتور</span>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="75%" Height="32px" />
                    </div>
                    <div class="invoice-financial-balance">
                        <span>مانده نهایی</span>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="65%" Height="30px" />
                    </div>
                    <div class="invoice-financial-accordion"><span class="invoice-skeleton-label">جزئیات محاسبات</span></div>
                </section>
            </div>
        </aside>
    </div>
</div>
@code {
    [Parameter] public bool IsEditMode { get; set; }
}
