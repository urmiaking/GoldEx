<div class="invoice-workspace invoice-workspace-loading">
    <header class="invoice-workspace-heading">
        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="220px" Height="49px" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="125px" Height="32px" />
    </header>
    <div class="invoice-workspace-top">
        <section class="invoice-section invoice-core-section">
            <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="180px" Height="38px" />
            <div class="invoice-core-primary-grid mt-3">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="invoice-core-field">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="58px" />
                    </div>
                }
            </div>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="55px" Class="mt-3" />
        </section>
        <section class="invoice-section invoice-customer-section">
            <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="110px" Height="35px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="40px" Class="my-2" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="155px" />
        </section>
        <aside class="invoice-workspace-side">
            <div class="invoice-settlement-main">
                <section class="invoice-section invoice-financial-card">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="130px" Height="40px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="80px" Class="my-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="115px" />
                </section>
            </div>
        </aside>
    </div>
    <main class="invoice-workspace-main">
        <section class="invoice-section invoice-lines-section">
            <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="165px" Height="40px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="45px" Class="my-3" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="190px" />
        </section>
    </main>
</div>
