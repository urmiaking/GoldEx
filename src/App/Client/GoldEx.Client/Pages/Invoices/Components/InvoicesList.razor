@inherits GoldExComponentBase

@if (ShowTitle)
{
    <div class="d-flex justify-content-center w-100">
        <MudText Typo="Typo.h5" GutterBottom="true" Class="mt-6">فاکتورها</MudText>
    </div>
    <MudDivider />
}

<MudTable T="InvoiceListVm" Class="@Class" RowsPerPage="14" Hover="true" @ref="_table" FixedHeader="true" ContainerClass="@ContainerClass"
          OnRowClick="(arg) => ShowDetails(arg)" RowClass="cursor-pointer"
          Dense="true" ServerData="LoadInvoicesAsync" SelectOnRowClick="false" Breakpoint="Breakpoint.None" Elevation="@Elevation">
    <ToolBarContent>
        <MudTextField T="string" Clearable="true" Immediate="true" Value="@_searchString" ValueChanged="@(s => OnSearch(s))" DebounceInterval="500"
                      Placeholder="جستجو ..." Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"></MudTextField>
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Filled.Tune"
                           Color="Color.Success"
                           Variant="Variant.Filled"
                           Class="mr-3"
                           Size="Size.Small"
                           OnClick="OpenMobileFilters" />
            <MudMenu Icon="@Icons.Material.Filled.Add"
                     Color="Color.Primary"
                     Variant="Variant.Filled"
                     Class="mr-3"
                     Size="Size.Small">
                @foreach (var scale in Enum.GetValues<TradeScale>())
                {
                    <MudMenuItem OnClick="@(() => OnCreateInvoice(scale))">
                        @scale.GetDisplayName()
                    </MudMenuItem>
                }
            </MudMenu>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.SmAndDown" Class="w-75">
            <MudSpacer />
            <MudDateRangePicker DateRange="@_filterDateRange"
                                DateRangeChanged="OnDateRangeChanged"
                                Margin="Margin.Dense"
                                Variant="Variant.Outlined"
                                Class="ml-3"
                                MaxMonthColumns="1"
                                DisplayMonths="1"
                                Rounded="true"
                                ShowToolbar="false"
                                Style="max-width: 320px;"
                                PlaceholderStart="از"
                                PlaceholderEnd="تا"
                                Elevation="24"
                                RelativeWidth="DropdownWidth.Adaptive"
                                Label="تاریخ فاکتور"
                                Clearable="true"/>

            <MudButtonGroup Size="Size.Small" Color="@TradeScaleColor" Variant="Variant.Filled" Class="ml-3">
                <MudButton Size="Size.Small" StartIcon="@TradeScaleIcon">
                    @(_tradeScale == null ? "نوع معامله" : _tradeScale.GetDisplayName())
                </MudButton>
                <MudMenu Size="Size.Small" Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                    <MudMenuItem IconColor="Color.Info" Icon="@Icons.Material.Filled.CompareArrows" OnClick="() => SetTradeScaleText(null)">همه</MudMenuItem>
                    <MudMenuItem IconColor="Color.Primary" Icon="@Icons.Material.Filled.Apps" OnClick="() => SetTradeScaleText(TradeScale.Wholesale)">@TradeScale.Wholesale.GetDisplayName()</MudMenuItem>
                    <MudMenuItem IconColor="Color.Success" Icon="@Icons.Material.Filled.Square" OnClick="() => SetTradeScaleText(TradeScale.Retail)">@TradeScale.Retail.GetDisplayName()</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>

            <MudButtonGroup Size="Size.Small" Color="@InvoiceTypeColor" Variant="Variant.Filled" Class="ml-3">
                <MudButton Size="Size.Small" StartIcon="@InvoiceTypeIcon">
                    @(_invoiceType == null ? "نوع فاکتور" : _invoiceType.GetDisplayName())
                </MudButton>
                <MudMenu Size="Size.Small" Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                    <MudMenuItem IconColor="Color.Info" Icon="@Icons.Material.Filled.CompareArrows" OnClick="() => SetInvoiceTypeText(null)">همه</MudMenuItem>
                    <MudMenuItem IconColor="Color.Success" Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => SetInvoiceTypeText(InvoiceType.Purchase)">@InvoiceType.Purchase.GetDisplayName()</MudMenuItem>
                    <MudMenuItem IconColor="Color.Error" Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => SetInvoiceTypeText(InvoiceType.Sell)">@InvoiceType.Sell.GetDisplayName()</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>

            <MudButtonGroup Size="Size.Small" Color="@InvoicePaymentStatusColor" Variant="Variant.Filled" Class="ml-3">
                <MudButton Size="Size.Small" StartIcon="@InvoicePaymentStatusIcon">
                    @(_invoicePaymentStatus == null ? "وضعیت" : _invoicePaymentStatus.GetDisplayName())
                </MudButton>
                <MudMenu Size="Size.Small" Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                    <MudMenuItem IconColor="Color.Info" Icon="@Icons.Material.Filled.ViewHeadline" OnClick="() => SetStatusFilterText(null)">همه</MudMenuItem>
                    <MudMenuItem IconColor="Color.Primary" Icon="@Icons.Material.Filled.Pending" OnClick="() => SetStatusFilterText(InvoicePaymentStatus.HasDebt)">@InvoicePaymentStatus.HasDebt.GetDisplayName()</MudMenuItem>
                    <MudMenuItem IconColor="Color.Error" Icon="@Icons.Material.Filled.MoreTime" OnClick="() => SetStatusFilterText(InvoicePaymentStatus.Overdue)">@InvoicePaymentStatus.Overdue.GetDisplayName()</MudMenuItem>
                    <MudMenuItem IconColor="Color.Success" Icon="@Icons.Material.Filled.Check" OnClick="() => SetStatusFilterText(InvoicePaymentStatus.Paid)">@InvoicePaymentStatus.Paid.GetDisplayName()</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>

            <MudMenu Class="ml-4"
                     Label="فاکتور جدید"
                     EndIcon="@Icons.Material.Filled.Add"
                     Color="Color.Primary"
                     Variant="Variant.Filled"
                     Size="Size.Small">
                @foreach (var scale in Enum.GetValues<TradeScale>())
                {
                    <MudMenuItem OnClick="@(() => OnCreateInvoice(scale))">
                        @scale.GetDisplayName()
                    </MudMenuItem>
                }
            </MudMenu>
        </MudHidden>
    </ToolBarContent>

    <HeaderContent>
        <MudTh Class="desktop-table-cell"><MudTableSortLabel SortLabel="InvoiceType" T="InvoiceListVm">فاکتور و معامله</MudTableSortLabel></MudTh>
        <MudTh Class="desktop-table-cell"><MudTableSortLabel SortLabel="InvoiceNumber" T="InvoiceListVm">شماره / تاریخ</MudTableSortLabel></MudTh>
        <MudTh Class="desktop-table-cell"><MudTableSortLabel SortLabel="Customer.FullName" T="InvoiceListVm">طرف حساب</MudTableSortLabel></MudTh>
        <MudTh Class="desktop-table-cell">ارزش کل</MudTh>
        <MudTh Class="desktop-table-cell">مانده فاکتور</MudTh>
        <MudTh Class="desktop-table-cell">مانده کل مشتری</MudTh>
        <MudTh Class="desktop-table-cell">عملیات</MudTh>
    </HeaderContent>

    <RowTemplate>
        @* --- Desktop Compact 2-Line Table Cells (>= 960px) --- *@
        <MudTd Class="desktop-table-cell align-middle" DataLabel="فاکتور و معامله">
            <div class="d-flex align-start">
                <MudChip T="string" Size="Size.Small" Color="@(context.InvoiceType == InvoiceType.Sell ? Color.Error : Color.Success)" Variant="Variant.Filled">
                    @context.InvoiceType.GetDisplayName()
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="@(context.TradeScale == TradeScale.Wholesale ? Color.Primary : Color.Info)" Variant="Variant.Outlined">
                    @context.TradeScale.GetDisplayName()
                </MudChip>
            </div>
        </MudTd>

        <MudTd Class="desktop-table-cell align-middle" DataLabel="شماره / تاریخ">
            <div class="d-flex flex-column align-start">
                <MudText Typo="Typo.body2">#@context.InvoiceNumber</MudText>
                <MudTooltip Text="@GetInvoiceDateTooltipText(context)" Arrow="true" Placement="Placement.Top">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@GetInvoiceDate(context)</MudText>
                </MudTooltip>
            </div>
        </MudTd>

        <MudTd Class="desktop-table-cell align-middle" DataLabel="طرف حساب">
            <div class="d-flex flex-column align-start">
                <MudText Typo="Typo.body2">@context.CustomerFullName</MudText>
                @if (!string.IsNullOrEmpty(context.CustomerPhoneNumber))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CustomerPhoneNumber</MudText>
                }
            </div>
        </MudTd>

        <MudTd Class="desktop-table-cell align-middle" DataLabel="ارزش کل">
            <MudText Typo="Typo.body2">@context.TotalAmount.ToCurrencyFormat(context.PriceUnit)</MudText>
        </MudTd>

        <MudTd Class="desktop-table-cell align-middle" DataLabel="مانده فاکتور">
            @switch (context.PaymentStatus)
            {
                case InvoicePaymentStatus.Paid:
                    <MudChip Size="Size.Small" T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">
                        @context.PaymentStatus.GetDisplayName()
                    </MudChip>
                    break;
                case InvoicePaymentStatus.HasDebt:
                    <MudText Typo="Typo.body2" Color="@(GetUnpaidAmountColor(context.TotalUnpaidAmount, context.InvoiceType))">
                        @FormatCompleteUnpaidAmount(context.TotalUnpaidAmount, context.PriceUnit, context.TotalUnpaidAmountSecondary, context.SecondaryPriceUnit)
                    </MudText>
                    break;
                case InvoicePaymentStatus.Overdue:
                    <div class="d-flex gap-1 align-center">
                        <MudText Typo="Typo.body2" Color="@(GetUnpaidAmountColor(context.TotalUnpaidAmount, context.InvoiceType))">
                            @FormatCompleteUnpaidAmount(context.TotalUnpaidAmount, context.PriceUnit, context.TotalUnpaidAmountSecondary, context.SecondaryPriceUnit)
                        </MudText>
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                    </div>
                    break;
                default:
                    throw new ArgumentOutOfRangeException();
            }
        </MudTd>

        <MudTd Class="desktop-table-cell align-middle" DataLabel="مانده کل مشتری">
            @if (context.CustomerId != Guid.Empty)
            {
                <CustomerRemaining CustomerId="@context.CustomerId"
                                   UntilDate="@GetInvoicePostingDate(context)"
                                   InvoiceId="@context.Id"
                                   EnableManualSlide="true"
                                   ItemClass="justify-content-end justify-content-lg-start" />
            }
        </MudTd>

        <MudTd Class="desktop-table-cell align-middle" DataLabel="عملیات">
            <div class="d-flex gap-2 align-center" @onclick:stopPropagation="true">
                <MudTooltip Text="چاپ فاکتور">
                    <MudIconButton Size="@Size.Small" Variant="@Variant.Filled" Icon="@Icons.Material.Filled.Print"
                                   Color="@Color.Success" OnClick="_ => OnViewInvoice(context)"></MudIconButton>
                </MudTooltip>
                <MudTooltip Text="ویرایش فاکتور">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Filled"
                                   Color="Color.Primary" OnClick="_ => OnEditInvoice(context)"></MudIconButton>
                </MudTooltip>
                <MudTooltip Text="حذف فاکتور">
                    <MudIconButton OnClick="@(_ => OnRemoveInvoice(context))" Size="@Size.Small" Variant="@Variant.Filled"
                                   Icon="@Icons.Material.Filled.Delete" Color="@Color.Error"></MudIconButton>
                </MudTooltip>
            </div>
        </MudTd>

        @* --- Mobile Clean Card Cell (< 960px) --- *@
        <MudTd Class="mobile-card-cell p-1 border-0" colspan="7">
            <MudCard Elevation="2" Class="rounded-lg my-1 border border-solid mud-border-lines-default overflow-hidden">
                <div class="pa-3 background-muted border-b mud-border-lines-default d-flex justify-space-between align-center">
                    <div class="d-flex align-center gap-1 flex-wrap">
                        <MudText Typo="Typo.subtitle2" Class="ml-1">فاکتور #@context.InvoiceNumber</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(context.InvoiceType == InvoiceType.Sell ? Color.Error : Color.Success)" Variant="Variant.Filled">
                            @context.InvoiceType.GetDisplayName()
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@(context.TradeScale == TradeScale.Wholesale ? Color.Primary : Color.Info)" Variant="Variant.Outlined">
                            @context.TradeScale.GetDisplayName()
                        </MudChip>
                    </div>
                    <MudText Typo="Typo.caption">
                        @GetInvoiceDate(context)
                    </MudText>
                </div>

                <MudCardContent Class="py-3 px-3">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <div>
                            <MudText Typo="Typo.body2">@context.CustomerFullName</MudText>
                            @if (!string.IsNullOrEmpty(context.CustomerPhoneNumber))
                            {
                                <MudText Typo="Typo.caption">
                                    @context.CustomerPhoneNumber
                                </MudText>
                            }
                        </div>
                        <div class="text-end">
                            <MudText Typo="Typo.caption">ارزش کل</MudText>
                            <MudText Typo="Typo.body2">
                                @context.TotalAmount.ToCurrencyFormat(context.PriceUnit)
                            </MudText>
                        </div>
                    </div>

                    <MudDivider Class="my-2" />

                    <div class="d-flex justify-space-between align-center gap-2 py-1">
                        <div class="d-flex flex-column align-start">
                            <MudText Typo="Typo.caption" Class="mb-1">مانده فاکتور</MudText>
                            @switch (context.PaymentStatus)
                            {
                                case InvoicePaymentStatus.Paid:
                                    <MudChip Size="Size.Small" T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">
                                        @context.PaymentStatus.GetDisplayName()
                                    </MudChip>
                                    break;
                                case InvoicePaymentStatus.HasDebt:
                                    <MudText Typo="Typo.body2" Color="@(GetUnpaidAmountColor(context.TotalUnpaidAmount, context.InvoiceType))">
                                        @FormatCompleteUnpaidAmount(context.TotalUnpaidAmount, context.PriceUnit, context.TotalUnpaidAmountSecondary, context.SecondaryPriceUnit)
                                    </MudText>
                                    break;
                                case InvoicePaymentStatus.Overdue:
                                    <div class="d-flex align-center gap-1">
                                        <MudText Typo="Typo.body2" Color="@(GetUnpaidAmountColor(context.TotalUnpaidAmount, context.InvoiceType))">
                                            @FormatCompleteUnpaidAmount(context.TotalUnpaidAmount, context.PriceUnit, context.TotalUnpaidAmountSecondary, context.SecondaryPriceUnit)
                                        </MudText>
                                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                                    </div>
                                    break;
                            }
                        </div>

                        <div class="d-flex flex-column align-end">
                            <MudText Typo="Typo.caption" Class="mb-1">مانده کل مشتری</MudText>
                            @if (context.CustomerId != Guid.Empty)
                            {
                                <CustomerRemaining CustomerId="@context.CustomerId"
                                                   UntilDate="@GetInvoicePostingDate(context)"
                                                   InvoiceId="@context.Id"
                                                   EnableManualSlide="true"
                                                   ItemClass="justify-content-end" />
                            }
                        </div>
                    </div>
                </MudCardContent>

                <div class="px-3 py-2 bg-light d-flex justify-space-between align-center border-t mud-border-lines-default">
                    <div class="d-flex gap-1" @onclick:stopPropagation="true">
                        <MudTooltip Text="چاپ فاکتور">
                            <MudIconButton Size="@Size.Small" Variant="@Variant.Filled" Icon="@Icons.Material.Filled.Print"
                                           Color="@Color.Success" OnClick="_ => OnViewInvoice(context)"></MudIconButton>
                        </MudTooltip>
                        <MudTooltip Text="ویرایش فاکتور">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Filled"
                                           Color="Color.Primary" OnClick="_ => OnEditInvoice(context)"></MudIconButton>
                        </MudTooltip>
                        <MudTooltip Text="حذف فاکتور">
                            <MudIconButton OnClick="@(_ => OnRemoveInvoice(context))" Size="@Size.Small" Variant="@Variant.Filled"
                                           Icon="@Icons.Material.Filled.Delete" Color="@Color.Error"></MudIconButton>
                        </MudTooltip>
                    </div>

                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.caption">
                            @(context.ShowDetails ? "بستن جزئیات" : "ریز تراکنش‌ها")
                        </MudText>
                        <MudIcon Icon="@(context.ShowDetails ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                    </div>
                </div>
            </MudCard>
        </MudTd>
    </RowTemplate>

    <ChildRowContent>
        <MudTr Class="mud-table-row-child">
            <td colspan="7">
                <MudCollapse Expanded="@context.ShowDetails">
                    @if (context.ShowDetails)
                    {
                        <MudCard Elevation="2" Class="m-2">
                            <MudCardContent>
                                <TransactionList InvoiceId="@context.Id" TableTitle="تراکنش‌های مرتبط با این فاکتور" ShowReversed="true" />
                                <InventoryList InvoiceId="@context.Id" />
                            </MudCardContent>
                        </MudCard>
                    }
                </MudCollapse>
            </td>
        </MudTr>
    </ChildRowContent>

    <NoRecordsContent>
        <MudText>هیچ فاکتوری یافت نشد</MudText>
    </NoRecordsContent>

    <LoadingContent>
        <MudText>در حال بارگیری</MudText>
    </LoadingContent>

    <PagerContent>
        @{
            var totalItems = _table.GetFilteredItemsCount();
            var startItem = totalItems == 0 ? 0 : _table.CurrentPage * _table.RowsPerPage + 1;
            var endItem = Math.Min((_table.CurrentPage + 1) * _table.RowsPerPage, totalItems);
            var pageCount = (totalItems + _table.RowsPerPage - 1) / _table.RowsPerPage;
            var infoText = $"نمایش {startItem} تا {endItem} از {totalItems} ردیف";
        }

        <div class="d-flex flex-column flex-sm-row align-center justify-sm-space-between w-100 py-4" style="gap: 1rem;">
            <div class="mud-table-pagination-caption">
                @infoText
            </div>
            <MudPagination SelectedChanged="PageChanged"
                           Selected="@(_table.CurrentPage + 1)"
                           Color="Color.Primary"
                           Count="@pageCount"
                           Class="justify-center"
                           BoundaryCount="1"
                           MiddleCount="3" />

            <div class="d-none d-sm-block mud-table-pagination-caption" style="visibility: hidden; pointer-events: none;">
                @infoText
            </div>
        </div>
    </PagerContent>
</MudTable>
