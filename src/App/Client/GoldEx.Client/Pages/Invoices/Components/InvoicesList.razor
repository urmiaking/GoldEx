@inherits GoldExComponentBase

<section class="invoice-directory @Class" aria-label="فهرست فاکتورها">
    <header class="directory-heading">
        <div class="directory-title">
            <h1 class="mud-typography-h5">@(CustomerId.HasValue ? "فاکتورهای مشتری" : "فاکتورها") <span class="directory-count mud-typography-caption">@(_loading ? "…" : $"{_totalItems:N0} فاکتور")</span></h1>
            <p class="mud-typography-body2">مدیریت و بررسی فاکتورها</p>
        </div>
        <MudMenu Label="فاکتور جدید"
                 EndIcon="@Icons.Material.Filled.Add"
                 Color="Color.Primary"
                 Variant="Variant.Filled"
                 Class="directory-create">
            @foreach (var scale in Enum.GetValues<TradeScale>())
            {
                <MudMenuItem OnClick="@(() => OnCreateInvoice(scale))">@scale.GetDisplayName()</MudMenuItem>
            }
        </MudMenu>
    </header>

    <div class="directory-filters">
        <div class="directory-toolbar">
            <div class="directory-search">
                <MudTextField T="string"
                              Value="_searchString" ValueChanged="OnSearch"
                              Immediate="true" DebounceInterval="500" Clearable="true"
                              Label="جستجوی فاکتور"
                              Placeholder="شماره فاکتور، نام یا شماره مشتری"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudButton Variant="Variant.Outlined"
                       Color="@(ActiveFilterCount > 0 ? Color.Primary : Color.Default)"
                       StartIcon="@Icons.Material.Outlined.Tune"
                       Class="directory-filter"
                       aria-label="@FilterButtonLabel"
                       OnClick="OpenMobileFilters">
                <span class="directory-filter-text">فیلترها</span>
                @if (ActiveFilterCount > 0)
                {
                    <span class="directory-filter-count" aria-hidden="true">@ActiveFilterCount</span>
                }
            </MudButton>
            <div class="directory-sort">
                <MudSelect T="string" Label="مرتب‌سازی بر اساس"
                           Value="_sortLabel" ValueChanged="OnSortChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem Value="@("InvoiceNumber")">شماره فاکتور</MudSelectItem>
                    <MudSelectItem Value="@("Customer.FullName")">نام مشتری</MudSelectItem>
                    <MudSelectItem Value="@("InvoiceType")">نوع فاکتور</MudSelectItem>
                </MudSelect>
            </div>
            <div class="directory-sort-toggle">
                <MudTooltip Text="@(_sortDirection == GoldEx.Sdk.Common.Definitions.SortDirection.Descending ? "مرتب‌سازی نزولی؛ تغییر به صعودی" : "مرتب‌سازی صعودی؛ تغییر به نزولی")">
                    <MudIconButton Icon="@(_sortDirection == GoldEx.Sdk.Common.Definitions.SortDirection.Descending ? Icons.Material.Filled.South : Icons.Material.Filled.North)"
                                   OnClick="ToggleSortDirection" Class="directory-sort-direction"
                                   aria-label="@(_sortDirection == GoldEx.Sdk.Common.Definitions.SortDirection.Descending ? "تغییر به مرتب‌سازی صعودی" : "تغییر به مرتب‌سازی نزولی")" />
                </MudTooltip>
            </div>
        </div>

        @if (ActiveFilterCount > 0)
        {
            <div class="directory-applied-filters" aria-label="فیلترهای فعال">
                @if (_tradeScale.HasValue) { <span>@_tradeScale.Value.GetDisplayName()</span> }
                @if (_invoiceType.HasValue) { <span>@_invoiceType.Value.GetDisplayName()</span> }
                @if (_invoicePaymentStatus.HasValue) { <span>@_invoicePaymentStatus.Value.GetDisplayName()</span> }
                @if (_filterDateRange.Start.HasValue || _filterDateRange.End.HasValue)
                {
                    <span>تاریخ فاکتور: @(_filterDateRange.Start?.ToShortDateString() ?? "ابتدا") تا @(_filterDateRange.End?.ToShortDateString() ?? "امروز")</span>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFilters"
                           StartIcon="@Icons.Material.Filled.Close">پاک کردن فیلترها</MudButton>
            </div>
        }
    </div>

    <div class="invoice-results" aria-busy="@_loading">
        @if (_loading && _invoices.Count == 0)
        {
            <div class="invoice-placeholder" role="status">
                @for (var i = 0; i < 6; i++) { <div class="invoice-skeleton"></div> }
                <span class="invoice-sr-only">در حال دریافت فاکتورها…</span>
            </div>
        }
        else if (_loadFailed)
        {
            <div class="invoice-empty" role="alert">
                <ShellIcon Name="warning" />
                <strong>دریافت فاکتورها انجام نشد</strong>
                <span>اتصال را بررسی کنید و دوباره تلاش کنید.</span>
                <button type="button" @onclick="ReloadAsync">تلاش دوباره</button>
            </div>
        }
        else if (_invoices.Count == 0)
        {
            <div class="invoice-empty" role="status">
                <ShellIcon Name="file" />
                <strong>فاکتوری پیدا نشد</strong>
                <span>جستجو یا فیلترها را تغییر دهید.</span>
                <button type="button" @onclick="ClearAllSearchAndFilters">نمایش همه فاکتورها</button>
            </div>
        }
        else
        {
            <div class="invoice-desktop-table">
                <table class="invoice-table mud-typography-body2">
                    <thead>
                        <tr>
                            <th scope="col"><button type="button" @onclick='() => ChangeSort("InvoiceNumber")'>شماره / تاریخ <span>@SortIndicator("InvoiceNumber")</span></button></th>
                            <th scope="col"><button type="button" @onclick='() => ChangeSort("Customer.FullName")'>طرف حساب <span>@SortIndicator("Customer.FullName")</span></button></th>
                            <th scope="col"><button type="button" @onclick='() => ChangeSort("InvoiceType")'>نوع معامله <span>@SortIndicator("InvoiceType")</span></button></th>
                            <th scope="col">ارزش کل</th>
                            <th scope="col">مانده فاکتور</th>
                            <th scope="col">مانده کل مشتری</th>
                            <th scope="col">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in _invoices)
                        {
                            <tr @key="invoice.Id" class="invoice-data-row @(invoice.ShowDetails ? "is-expanded" : "")">
                                <td>
                                    <div class="invoice-number-cell">
                                        <button type="button" class="invoice-expand" aria-expanded="@(invoice.ShowDetails ? "true" : "false")"
                                                aria-label="@(invoice.ShowDetails ? "بستن جزئیات" : "نمایش جزئیات") فاکتور @invoice.InvoiceNumber"
                                                @onclick="() => ToggleDetails(invoice)"><ShellIcon Name="expand" /></button>
                                        <div><strong>#@invoice.InvoiceNumber</strong><small title="@GetInvoiceDateTooltipText(invoice)">@GetInvoiceDate(invoice)</small></div>
                                    </div>
                                </td>
                                <td><div class="invoice-customer"><strong>@invoice.CustomerFullName</strong>
                                    @if (!string.IsNullOrWhiteSpace(invoice.CustomerPhoneNumber)) { <small dir="ltr">@invoice.CustomerPhoneNumber</small> }
                                </div></td>
                                <td><div class="invoice-tags"><span class="invoice-badge @(invoice.InvoiceType == InvoiceType.Sell ? "is-sale" : "is-purchase")">@invoice.InvoiceType.GetDisplayName()</span><span class="invoice-badge is-scale">@invoice.TradeScale.GetDisplayName()</span></div></td>
                                <td class="invoice-money">@invoice.TotalAmount.ToCurrencyFormat(invoice.PriceUnit)</td>
                                <td><div class="invoice-balance @UnpaidClass(invoice)">
                                    @if (invoice.PaymentStatus == InvoicePaymentStatus.Paid) { <span class="invoice-paid"><ShellIcon Name="check" /> تسویه حساب</span> }
                                    else { <strong>@FormatCompleteUnpaidAmount(invoice.TotalUnpaidAmount, invoice.PriceUnit, invoice.TotalUnpaidAmountSecondary, invoice.SecondaryPriceUnit)</strong> }
                                    @if (invoice.PaymentStatus == InvoicePaymentStatus.Overdue) { <small>سررسید گذشته</small> }
                                </div></td>
                                <td class="invoice-customer-balance">
                                    @if (invoice.CustomerId != Guid.Empty)
                                    {
                                        <CustomerRemaining @key="invoice.CustomerId" CustomerId="invoice.CustomerId"
                                                           EnableManualSlide="true" TextTypo="Typo.body2" />
                                    }
                                    else
                                    {
                                        <span class="invoice-no-balance">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="invoice-actions">
                                        <button type="button" title="چاپ فاکتور" aria-label="چاپ فاکتور @invoice.InvoiceNumber" @onclick="() => OnViewInvoice(invoice)"><ShellIcon Name="print" /></button>
                                        <button type="button" title="ویرایش فاکتور" aria-label="ویرایش فاکتور @invoice.InvoiceNumber" @onclick="() => OnEditInvoice(invoice)"><ShellIcon Name="edit" /></button>
                                        <button type="button" class="is-danger" title="حذف فاکتور" aria-label="حذف فاکتور @invoice.InvoiceNumber" @onclick="() => OnRemoveInvoice(invoice)"><ShellIcon Name="trash" /></button>
                                    </div>
                                </td>
                            </tr>
                            @if (invoice.ShowDetails)
                            {
                                <tr @key="@($"details-{invoice.Id}")" class="invoice-expanded-row">
                                    <td colspan="7"><InvoiceDetails @key="invoice.Id" InvoiceId="invoice.Id" InvoiceNumber="invoice.InvoiceNumber" CustomerId="invoice.CustomerId" PostingDate="GetInvoicePostingDate(invoice)" /></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="invoice-mobile-list">
                @foreach (var invoice in _invoices)
                {
                    <article @key="invoice.Id" class="invoice-card @(invoice.ShowDetails ? "is-expanded" : "")">
                        <header class="invoice-card-head">
                            <div class="invoice-card-number"><strong>فاکتور #@invoice.InvoiceNumber</strong><span>@GetInvoiceDate(invoice)</span></div>
                            <div class="invoice-tags"><span class="invoice-badge @(invoice.InvoiceType == InvoiceType.Sell ? "is-sale" : "is-purchase")">@invoice.InvoiceType.GetDisplayName()</span><span class="invoice-badge is-scale">@invoice.TradeScale.GetDisplayName()</span></div>
                        </header>
                        <div class="invoice-card-customer"><ShellIcon Name="user" /><div><strong>@invoice.CustomerFullName</strong>
                            @if (!string.IsNullOrWhiteSpace(invoice.CustomerPhoneNumber)) { <small dir="ltr">@invoice.CustomerPhoneNumber</small> }
                        </div></div>
                        <div class="invoice-card-amounts">
                            <div><span>ارزش فاکتور</span><strong>@invoice.TotalAmount.ToCurrencyFormat(invoice.PriceUnit)</strong></div>
                            <div><span>مانده فاکتور</span><strong class="invoice-balance @UnpaidClass(invoice)">@(invoice.PaymentStatus == InvoicePaymentStatus.Paid ? "تسویه حساب" : FormatCompleteUnpaidAmount(invoice.TotalUnpaidAmount, invoice.PriceUnit, invoice.TotalUnpaidAmountSecondary, invoice.SecondaryPriceUnit))</strong></div>
                        </div>
                        <footer class="invoice-card-footer">
                            <button type="button" class="invoice-card-expand" aria-expanded="@(invoice.ShowDetails ? "true" : "false")" @onclick="() => ToggleDetails(invoice)"><ShellIcon Name="expand" /> @(invoice.ShowDetails ? "بستن جزئیات" : "جزئیات و مانده مشتری")</button>
                            <div class="invoice-actions">
                                <button type="button" title="چاپ" aria-label="چاپ فاکتور @invoice.InvoiceNumber" @onclick="() => OnViewInvoice(invoice)"><ShellIcon Name="print" /></button>
                                <button type="button" title="ویرایش" aria-label="ویرایش فاکتور @invoice.InvoiceNumber" @onclick="() => OnEditInvoice(invoice)"><ShellIcon Name="edit" /></button>
                                <button type="button" class="is-danger" title="حذف" aria-label="حذف فاکتور @invoice.InvoiceNumber" @onclick="() => OnRemoveInvoice(invoice)"><ShellIcon Name="trash" /></button>
                            </div>
                        </footer>
                        @if (invoice.ShowDetails)
                        {
                            <InvoiceDetails @key="invoice.Id" InvoiceId="invoice.Id" InvoiceNumber="invoice.InvoiceNumber" CustomerId="invoice.CustomerId" PostingDate="GetInvoicePostingDate(invoice)" />
                        }
                    </article>
                }
            </div>
        }
        @if (_loading && _invoices.Count > 0)
        {
            <div class="invoice-refreshing" role="status">در حال به‌روزرسانی فهرست…</div>
        }
    </div>

    <footer class="invoice-pagination" aria-label="صفحه‌بندی فاکتورها">
        <div class="invoice-pagination-actions">
            <button type="button" disabled="@(!CanPrevious)" @onclick="() => ChangePage(-1)" aria-label="صفحه قبل"><ShellIcon Name="previous" /> قبلی</button>
            <span class="invoice-pagination-current" role="status" aria-live="polite">@(_pageIndex + 1) / @PageCount</span>
            <button type="button" disabled="@(!CanNext)" @onclick="() => ChangePage(1)" aria-label="صفحه بعد">بعدی <ShellIcon Name="next" /></button>
        </div>
        <label class="invoice-page-size">تعداد ردیف
            <select value="@_pageSize" @onchange="ChangePageSize" aria-label="تعداد فاکتور در هر صفحه">
                <option value="10">۱۰</option><option value="14">۱۴</option><option value="25">۲۵</option><option value="50">۵۰</option>
            </select>
        </label>
    </footer>
</section>
