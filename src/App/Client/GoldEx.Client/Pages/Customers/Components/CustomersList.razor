@inherits GoldExComponentBase

<section class="customers-directory @Class" aria-labelledby="customers-title">
    <header class="directory-heading">
        <div class="directory-title">
            <h1 id="customers-title">مشتریان <span class="directory-count">@(_loading ? "…" : $"{_totalItems:N0} نفر")</span></h1>
            <p>حساب و اطلاعات هر مشتری</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OnCreate" Class="directory-create">مشتری جدید</MudButton>
    </header>

    <div class="directory-filters">
    <div class="directory-toolbar">
        <div class="directory-search">
            <MudTextField T="string" Value="_searchString" ValueChanged="OnSearch" Clearable="true" Immediate="true" DebounceInterval="500"
                          Label="جستجوی مشتری" Placeholder="نام، کد مشتری یا شماره تماس" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <MudButton Variant="Variant.Outlined" Color="@(ActiveOptionCount > 0 ? Color.Primary : Color.Default)"
                   StartIcon="@Icons.Material.Outlined.Tune" OnClick="OpenMobileFilters" Class="directory-filter"
                   aria-label="@FilterButtonLabel">
            <span class="directory-filter-text">فیلترها</span>
            @if (ActiveOptionCount > 0)
            {
                <span class="directory-filter-count" aria-hidden="true">@ActiveOptionCount</span>
            }
        </MudButton>
        <div class="directory-sort">
            <MudSelect T="string" Label="مرتب‌سازی بر اساس" Value="_sortLabel" ValueChanged="OnSortChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@nameof(CustomerVm.CreatedAt)">تاریخ ثبت</MudSelectItem>
                <MudSelectItem Value="@nameof(CustomerVm.FullName)">نام مشتری</MudSelectItem>
                <MudSelectItem Value="@nameof(CustomerVm.CustomerType)">نوع مشتری</MudSelectItem>
                <MudSelectItem Value="@nameof(CustomerVm.NationalId)">کد مشتری</MudSelectItem>
                <MudSelectItem Value="@nameof(CustomerVm.PhoneNumber)">شماره تماس</MudSelectItem>
            </MudSelect>
        </div>
        <div class="directory-sort-toggle">
        <MudTooltip Text="@(_sortDescending ? "نزولی؛ تغییر به صعودی" : "صعودی؛ تغییر به نزولی")">
            <MudIconButton Icon="@(_sortDescending ? Icons.Material.Filled.South : Icons.Material.Filled.North)"
                           OnClick="ToggleSortDirection" Class="directory-sort-direction"
                           aria-label="@(_sortDescending ? "مرتب‌سازی نزولی؛ تغییر به صعودی" : "مرتب‌سازی صعودی؛ تغییر به نزولی")" />
        </MudTooltip>
        </div>
    </div>

    @if (ActiveFilterCount > 0)
    {
        <div class="directory-applied-filters" aria-label="فیلترهای فعال">
            @if (_customerType.HasValue) { <span>@_customerType.Value.GetDisplayName()</span> }
            @if (_transactionType.HasValue) { <span>@_transactionType.Value.GetDisplayName()</span> }
            @if (_filterDateRange.Start.HasValue || _filterDateRange.End.HasValue)
            {
                <span>تاریخ ثبت: @(_filterDateRange.Start?.ToShortDateString() ?? "ابتدا") تا @(_filterDateRange.End?.ToShortDateString() ?? "امروز")</span>
            }
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFilters" StartIcon="@Icons.Material.Filled.Close">پاک کردن فیلترها</MudButton>
        </div>
    }

    </div>

    <div class="directory-results" aria-busy="@((_loading || _loadingMore).ToString().ToLowerInvariant())">
        @if (_loading)
        {
            <div class="directory-grid" aria-label="در حال دریافت مشتریان">
                @for (var i = 0; i < 6; i++)
                {
                    <CustomerCardSkeleton />
                }
            </div>
            <span class="directory-sr-only" role="status">در حال دریافت مشتریان…</span>
        }
        else if (_loadFailed)
        {
            <div class="directory-empty" role="alert">
                <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" />
                <h2>دریافت مشتریان انجام نشد</h2>
                <p>دوباره تلاش کنید.</p>
                <MudButton OnClick="RefreshAsync" Color="Color.Primary" Variant="Variant.Outlined">تلاش دوباره</MudButton>
            </div>
        }
        else if (_customers.Count == 0)
        {
            <div class="directory-empty" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" Size="Size.Large" />
                <h2>@(HasQuery ? "مشتری با این مشخصات پیدا نشد" : "اولین مشتری‌تان را ثبت کنید")</h2>
                <p>@(HasQuery ? "نام، شماره تماس یا فیلترهای جستجو را تغییر دهید." : "با ثبت مشتری، اطلاعات و مانده حساب او را همین‌جا می‌بینید.")</p>
                @if (HasQuery)
                {
                    <MudButton OnClick="ClearQuery" Color="Color.Primary" Variant="Variant.Outlined">نمایش همه مشتریان</MudButton>
                }
                else
                {
                    <MudButton OnClick="OnCreate" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">مشتری جدید</MudButton>
                }
            </div>
        }
        else
        {
            <div class="directory-grid">
                @for (var index = 0; index < _customers.Count; index++)
                {
                    var customer = _customers[index];
                    <CustomerCard @key="customer.Id" Customer="customer" EntranceIndex="@(index % BatchSize)"
                                  FocusOnLoad="@(_appendStart > 0 && index == _appendStart)" OnEdit="OnEdit" OnRemove="OnRemove"
                                  OnViewTransaction="OnViewTransaction" OnViewInvoices="OnViewInvoices" />
                }
                @if (_loadingMore)
                {
                    @for (var i = 0; i < 6; i++)
                    {
                        <CustomerCardSkeleton />
                    }
                }
            </div>
        }
    </div>

    @if (!_loading && !_loadFailed && _customers.Count > 0)
    {
        <footer class="directory-load-more">
            <span role="status" aria-live="polite">نمایش @_customers.Count.ToString("N0") از @_totalItems.ToString("N0") مشتری</span>
            @if (_hasMore)
            {
                @if (_loadMoreFailed)
                {
                    <span class="directory-load-error" role="alert">دریافت مشتریان بیشتر انجام نشد. دوباره تلاش کنید.</span>
                }
                <MudButton OnClick="LoadMoreAsync" Disabled="_loadingMore" Variant="Variant.Outlined" Color="Color.Primary"
                           Class="directory-more-button" aria-label="@(_loadMoreFailed ? "تلاش دوباره برای دریافت مشتریان بیشتر" : "نمایش مشتریان بیشتر")">
                    @if (_loadingMore)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-hidden="true" />
                        <span>در حال بارگذاری…</span>
                    }
                    else
                    {
                        <MudIcon Icon="@(_loadMoreFailed ? Icons.Material.Outlined.Refresh : Icons.Material.Filled.ExpandMore)" />
                        <span>@(_loadMoreFailed ? "تلاش دوباره" : "نمایش بیشتر")</span>
                    }
                </MudButton>
            }
            else
            {
                <span class="directory-end">همه مشتریان نمایش داده شدند</span>
            }
        </footer>
    }
</section>
