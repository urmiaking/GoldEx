@inherits GoldExComponentBase
@using GoldEx.Client.Components.Components.Dialogs

<EditorDialogFrame>
    <DialogContent>
        <div class="gex-directory-filter-form">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="TransactionType?"
                               Variant="Variant.Outlined" Label="وضعیت حساب"
                               Value="@_transactionType" ValueChanged="@(v => _transactionType = v)"
                               Dense="true" Margin="Margin.Dense" Adornment="Adornment.Start"
                               AdornmentIcon="@GetTransactionTypeIcon(_transactionType)"
                               AdornmentColor="@GetTransactionTypeIconColor(_transactionType)" Class="w-100">
                        <MudSelectItem T="TransactionType?" Value="@(null as TransactionType?)">همه</MudSelectItem>
                        @foreach (var type in Enum.GetValues<TransactionType>())
                        {
                            <MudSelectItem T="TransactionType?" Value="@type">@type.GetDisplayName()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="CustomerType?"
                               Variant="Variant.Outlined" Label="نوع مشتری"
                               Value="@_customerType" ValueChanged="@(v => _customerType = v)"
                               Dense="true" Margin="Margin.Dense" Adornment="Adornment.Start"
                               AdornmentIcon="@GetCustomerTypeIcon(_customerType)"
                               AdornmentColor="@GetCustomerTypeIconColor(_customerType)" Class="w-100">
                        <MudSelectItem T="CustomerType?" Value="@(null as CustomerType?)">همه</MudSelectItem>
                        @foreach (var type in Enum.GetValues<CustomerType>())
                        {
                            <MudSelectItem T="CustomerType?" Value="@type">@type.GetDisplayName()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <div class="gex-filter-field-card gex-filter-date-card">
                        <div class="gex-filter-field-heading"><ShellIcon Name="calendar" /><span>بازه تاریخ ثبت مشتری</span></div>
                        <MudDateRangePicker DateRange="@_dateRange"
                                            DateRangeChanged="@(dr => _dateRange = dr)"
                                            Margin="Margin.Dense"
                                            Variant="Variant.Outlined"
                                            MaxMonthColumns="1"
                                            DisplayMonths="1"
                                            Rounded="true"
                                            ShowToolbar="false"
                                            AnchorOrigin="Origin.BottomCenter"
                                            TransformOrigin="Origin.TopCenter"
                                            PlaceholderStart="از تاریخ"
                                            PlaceholderEnd="تا تاریخ"
                                            Elevation="24"
                                            RelativeWidth="DropdownWidth.Adaptive"
                                            Clearable="true"
                                            Class="gex-filter-date-input w-100" />
                    </div>
                </MudItem>
                <MudItem xs="12" Class="gex-filter-mobile-sort">
                    <div class="gex-filter-section-title"><ShellIcon Name="list" /><span>مرتب‌سازی نمایش</span></div>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Label="مرتب‌سازی بر اساس" Value="_sortLabel" ValueChanged="OnSortChanged"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="customer-filter-sort">
                                <MudSelectItem Value="@nameof(CustomerVm.CreatedAt)">تاریخ ثبت</MudSelectItem>
                                <MudSelectItem Value="@nameof(CustomerVm.FullName)">نام مشتری</MudSelectItem>
                                <MudSelectItem Value="@nameof(CustomerVm.CustomerType)">نوع مشتری</MudSelectItem>
                                <MudSelectItem Value="@nameof(CustomerVm.NationalId)">کد مشتری</MudSelectItem>
                                <MudSelectItem Value="@nameof(CustomerVm.PhoneNumber)">شماره تماس</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="bool" Label="ترتیب نمایش" @bind-Value="_sortDescending"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="customer-filter-direction">
                                <MudSelectItem T="bool" Value="false">صعودی (از کم به زیاد)</MudSelectItem>
                                <MudSelectItem T="bool" Value="true">نزولی (از زیاد به کم)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="gex-directory-filter-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply"
                       StartIcon="@Icons.Material.Filled.Check" Class="gex-filter-apply">اعمال فیلترها</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel"
                       Class="gex-filter-cancel">انصراف</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Clear"
                       StartIcon="@Icons.Material.Filled.Delete" Class="gex-filter-reset">بازنشانی</MudButton>
        </div>    </DialogActions>
</EditorDialogFrame>
