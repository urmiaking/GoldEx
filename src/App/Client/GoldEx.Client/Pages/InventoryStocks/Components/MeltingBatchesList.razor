@using GoldEx.Shared.DTOs.MeltingBatches
@inherits GoldExComponentBase
<section @ref="_directory" class="melting-directory" aria-label="درخواست‌های ذوب طلا">
    <header class="melting-heading">
        <div><h1>ورود آبشده از ذوب طلا <span class="melting-count">@(_loading ? "…" : $"{_totalItems:N0} درخواست")</span></h1>
            <p>پیگیری مراحل ذوب، ری‌گیری و ثبت طلای آبشده در انبار</p></div>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="melting-create"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OnCreateMeltingBatch">درخواست جدید</MudButton>
    </header>
    <div class="melting-filters" @ref="_filterBar">
        <div class="melting-toolbar">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearch" Immediate="true" DebounceInterval="450"
                          Clearable="true" Label="جستجوی درخواست" Placeholder="شماره درخواست"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Outlined" Class="melting-filter-button" StartIcon="@Icons.Material.Outlined.Tune"
                       Color="@(ActiveFilterCount > 0 ? Color.Primary : Color.Default)"
                       OnClick="OpenFilters" aria-label="فیلتر درخواست‌های ذوب">
                <span class="melting-filter-label">فیلترها</span>
                @if (ActiveFilterCount > 0) { <span class="melting-filter-count">@ActiveFilterCount</span> }
            </MudButton>
            <MudSelect T="string" Class="melting-sort" Label="مرتب‌سازی" Value="_sortLabel" ValueChanged="OnSortChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@("BatchNumber")">شماره درخواست</MudSelectItem>
                <MudSelectItem Value="@("Weight")">وزن برآوردی</MudSelectItem>
            </MudSelect>
            <MudIconButton Class="melting-sort-direction" Icon="@(_sortDescending ? Icons.Material.Filled.South : Icons.Material.Filled.North)"
                           OnClick="ToggleSortDirection" aria-label="تغییر جهت مرتب‌سازی" />
        </div>
    </div>
    <div class="melting-results" aria-busy="@_loading">
        @if (_loading)
        {
            <div class="melting-skeleton" role="status" aria-label="در حال دریافت درخواست‌ها">
                @for (var i = 0; i < 5; i++) { <div><span></span><span></span><span></span></div> }
            </div>
        }
        else if (_loadFailed || _items.Count == 0)
        {
            <div class="melting-empty">
                <MudIcon Icon="@(_loadFailed ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.Whatshot)" Size="Size.Large" />
                <strong>@(_loadFailed ? "دریافت درخواست‌ها انجام نشد" : "درخواستی پیدا نشد")</strong>
                <p>@(_loadFailed ? "اتصال را بررسی و دوباره تلاش کنید." : "جستجو یا فیلترها را تغییر دهید.")</p>
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(_loadFailed ? LoadAsync : ResetFilters)">
                    @(_loadFailed ? "تلاش دوباره" : "پاک کردن فیلترها")
                </MudButton>
            </div>
        }
        else
        {
            <div class="melting-desktop">
                <table class="melting-table">
                    <thead><tr><th>شماره درخواست</th><th>وزن برآوردی</th><th>تاریخ ثبت</th><th>وضعیت</th><th>آزمایشگاه</th><th>عملیات</th></tr></thead>
                    <tbody>
                    @foreach (var item in _items)
                    {
                        <tr @key="item.Id">
                            <td><button class="melting-number" type="button" @onclick="() => ToggleDetails(item)" aria-expanded="@item.ShowDetails">#@item.BatchNumber</button></td>
                            <td><span class="melting-weight">@item.TotalWeight.ToWeightFormat(item.WeightUnitType)</span></td>
                            <td><time>@item.CurrentDateTime.ToString("yyyy/MM/dd HH:mm")</time></td>
                            <td><span class="melting-status @StatusClass(item.CurrentStatus)">@item.CurrentStatus.GetDisplayName()</span></td>
                            <td>@(item.Assayer?.FullName ?? "—")</td>
                            <td><div class="melting-actions">
                                <button type="button" title="مشاهده جزئیات" aria-label="مشاهده جزئیات" @onclick="() => ToggleDetails(item)">
                                    <ShellIcon Name="eye" />
                                </button>
                                @if(item.CurrentStatus != MeltingBatchStatus.Completed)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                               OnClick="() => OnProcessBatch(item.Id)">@ActionLabel(item.CurrentStatus)</MudButton>
                                }
                                else if(item.FinalProductDetail is not null)
                                {
                                    <button type="button" title="چاپ بارکد آبشده" aria-label="چاپ بارکد آبشده"
                                            @onclick="() => OnPrintBarcode(item.FinalProductDetail)"><ShellIcon Name="print" /></button>
                                }
                            </div></td>
                        </tr>
                        @if (item.ShowDetails)
                        {
                            <tr @key="@($"details-{item.Id}")" class="melting-detail-row">
                                <td colspan="6"><MeltingBatchDetails Batch="item" OnPrintBarcode="OnPrintBarcode" /></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="melting-mobile">
                @foreach (var item in _items)
                {
                    <article class="melting-card" @key="item.Id">
                        <header><span class="melting-number">درخواست #@item.BatchNumber</span>
                            <span class="melting-status @StatusClass(item.CurrentStatus)">@item.CurrentStatus.GetDisplayName()</span></header>
                        <div class="melting-card-primary">
                            <div><small>وزن برآوردی</small><strong>@item.TotalWeight.ToWeightFormat(item.WeightUnitType)</strong></div>
                            <time>@item.CurrentDateTime.ToString("yyyy/MM/dd")</time>
                        </div>
                        @if (item.Assayer is not null)
                        { <div class="melting-meta"><span>آزمایشگاه</span><span>@item.Assayer.FullName</span></div> }
                        <footer>
                            <button type="button" class="melting-details-toggle" @onclick="() => ToggleDetails(item)"
                                    aria-expanded="@item.ShowDetails" aria-label="نمایش جزئیات درخواست">
                                <ShellIcon Name="eye" /> @(item.ShowDetails ? "بستن جزئیات" : "جزئیات")
                            </button>
                            @if(item.CurrentStatus != MeltingBatchStatus.Completed)
                            {
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                           OnClick="() => OnProcessBatch(item.Id)">@ActionLabel(item.CurrentStatus)</MudButton>
                            }
                            else if(item.FinalProductDetail is not null)
                            {
                                <button type="button" class="melting-details-toggle" @onclick="() => OnPrintBarcode(item.FinalProductDetail)">
                                    <ShellIcon Name="print" /> چاپ
                                </button>
                            }
                        </footer>
                        @if (item.ShowDetails)
                        {
                            <div class="melting-mobile-details">
                                <MeltingBatchDetails Batch="item" OnPrintBarcode="OnPrintBarcode" />
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </div>
    <footer class="melting-pagination">
        <label>تعداد ردیف
            <select value="@_pageSize" @onchange="ChangePageSize" disabled="@_loading" aria-label="تعداد درخواست در صفحه">
                <option value="10">۱۰</option><option value="25">۲۵</option><option value="50">۵۰</option>
            </select>
        </label>
        <nav aria-label="صفحه‌بندی درخواست‌ها">
            <button type="button" disabled="@(_loading || _pageIndex == 0)" @onclick="() => ChangePage(-1)">قبلی</button>
            <span>@(_pageIndex + 1) از @PageCount</span>
            <button type="button" disabled="@(_loading || _pageIndex + 1 >= PageCount)" @onclick="() => ChangePage(1)">بعدی</button>
        </nav>
    </footer>
</section>
<script src="@Assets["js/libs/jsbarcode.all.min.js"]"></script>
<script src="@Assets["js/print.js"]"></script>