@attribute [Route(ClientRoutes.Reporting.InventoryKardex)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits InventoryKardexPageBase

<PageTitle>گزارش کاردکس کالا</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <InventoryKardexFilters Model="@Filters" />
    </ReportFiltersBase>

    <InventoryKardexReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>