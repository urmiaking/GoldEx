@attribute [Route(ClientRoutes.Reporting.CoinInventory)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits CoinInventoryPageBase

<PageTitle>گزارش موجودی سکه</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <CoinInventoryFilters Model="@Filters" />
    </ReportFiltersBase>

    <CoinInventoryReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>