@attribute [Route(ClientRoutes.Reporting.ProductInventory)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits ProductInventoryPageBase

<PageTitle>گزارش موجودی کالا</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <ProductInventoryFilters Model="@Filters" />
    </ReportFiltersBase>

    <ProductInventoryReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>