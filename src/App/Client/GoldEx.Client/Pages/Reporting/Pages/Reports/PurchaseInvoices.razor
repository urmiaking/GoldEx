@attribute [Route(ClientRoutes.Reporting.PurchaseInvoices)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits PurchaseInvoicePageBase

<PageTitle>گزارش فاکتور خرید</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <PurchaseInvoiceFilters Model="@Filters" />
    </ReportFiltersBase>

    <PurchaseInvoiceReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>