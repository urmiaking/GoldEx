@attribute [Route(ClientRoutes.Reporting.Payments)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits PaymentPageBase

<PageTitle>گزارش پرداخت/دریافت</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <PaymentFilters Model="@Filters" />
    </ReportFiltersBase>

    <PaymentReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>