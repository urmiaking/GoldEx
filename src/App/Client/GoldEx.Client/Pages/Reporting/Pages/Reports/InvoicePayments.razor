@attribute [Route(ClientRoutes.Reporting.InvoicePayments)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits InvoicePaymentPageBase

<PageTitle>ریز پرداخت های فاکتور</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <InvoicePaymentFilters Model="@Filters" />
    </ReportFiltersBase>

    <InvoicePaymentReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>