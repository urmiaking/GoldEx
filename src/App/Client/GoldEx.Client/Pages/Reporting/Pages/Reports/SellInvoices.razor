@attribute [Route(ClientRoutes.Reporting.SellInvoices)]
@attribute [Authorize(Roles = $"{BuiltinRoles.Administrators}, {BuiltinRoles.Owners}")]

@inherits SellInvoicePageBase

<PageTitle>گزارش فاکتور فروش</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gex-report-page">
    <ReportFiltersBase Model="@Filters" OnSubmit="OnSubmit">
        <SellInvoiceFilters Model="@Filters" /> 
    </ReportFiltersBase>

    <SellInvoiceReportView Items="@Data" IsLoading="@IsLoading" OnPrintReport="PrintReport" />
</MudContainer>

<script src="@Assets["js/report-print.js"]"></script>