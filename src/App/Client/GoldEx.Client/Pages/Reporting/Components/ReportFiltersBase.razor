@using GoldEx.Client.Pages.Reporting.ViewModels

<EditForm Model="Model" OnValidSubmit="Submit" class="report-filter-form">
    <DataAnnotationsValidator />
    <MudPaper Class="report-filter-panel" Elevation="0">
        <header class="report-filter-heading">
            <div>
                <h2>فیلتر گزارش</h2>
                <p>بازه زمانی و شرایط گزارش را انتخاب کنید.</p>
            </div>

        </header>
        <MudGrid Spacing="2" Class="report-filter-fields">
            <MudItem xs="12" sm="6" md="3">
                <MudDateRangePicker @bind-DateRange="Model.DateRange"
                                    Margin="Margin.Dense"
                                    Variant="Variant.Outlined"
                                    Adornment="Adornment.Start"
                                    Class="gex-filter-date-range"
                                    MaxMonthColumns="1"
                                    DisplayMonths="1"
                                    Rounded="true"
                                    ShowToolbar="false"
                                    AnchorOrigin="Origin.BottomCenter"
                                    TransformOrigin="Origin.TopCenter"
                                    PlaceholderStart="از"
                                    PlaceholderEnd="تا"
                                    RelativeWidth="DropdownWidth.Adaptive"
                                    Label="تاریخ گزارش"
                                    Clearable="true" />
            </MudItem>
            @ChildContent

        </MudGrid>
        <div class="report-filter-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                       StartIcon="@Icons.Material.Filled.Search">مشاهده گزارش</MudButton>
        </div>
    </MudPaper>
</EditForm>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ReportFilterVmBase Model { get; set; } = default!;
    [Parameter] public EventCallback<ReportFilterVmBase> OnSubmit { get; set; }

    private async Task Submit(EditContext editContext)
    {
        if (editContext.Validate())
            await OnSubmit.InvokeAsync(Model);
    }
}