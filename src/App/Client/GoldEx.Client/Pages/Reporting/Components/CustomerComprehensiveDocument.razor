@using GoldEx.Shared.DTOs.Reporting
@using GoldEx.Shared.Enums
@using GoldEx.Shared.Helpers
@using GoldEx.Sdk.Common.Extensions

<div class="gex-customer-report" dir="rtl">
    <section class="gex-customer-overview" aria-label="خلاصه وضعیت مشتری">
        <div class="gex-customer-overview-title">
            <strong>خلاصه وضعیت</strong>
            @if (!string.IsNullOrWhiteSpace(CustomerName))
            {
                <span>@CustomerName</span>
            }
        </div>
        <div class="gex-customer-overview-items">
            @foreach (var group in Data.Invoices
                .GroupBy(x => new { x.InvoiceType, x.PriceUnitTitle })
                .OrderBy(x => x.Key.InvoiceType).ThenBy(x => x.Key.PriceUnitTitle))
            {
                <div class="gex-customer-overview-metric">
                    <span>جمع @group.Key.InvoiceType.GetDisplayName() <small>(@group.Count() فاکتور)</small></span>
                    <strong>@group.Sum(x => x.TotalAmount).ToCurrencyFormat(group.Key.PriceUnitTitle)</strong>
                </div>
            }
            @foreach (var balance in Data.Balances)
            {
                <div class="gex-customer-overview-metric gex-customer-overview-balance">
                    <span>مانده حساب · @balance.PriceUnitTitle</span>
                    <strong class="@(balance.Amount > 0 ? "is-debit" : balance.Amount < 0 ? "is-credit" : "")">
                        @FormatBalance(balance.Amount, balance.PriceUnitTitle)
                    </strong>
                </div>
            }
            @if (Data.Invoices.Count == 0 && Data.Balances.Count == 0)
            {
                <div class="gex-customer-overview-empty">هنوز معامله یا مانده‌ای برای این مشتری ثبت نشده است.</div>
            }
        </div>
    </section>

    <section class="gex-customer-report-section" aria-label="فاکتورها و اقلام">
        <div class="gex-customer-report-heading">
            <h2>فاکتورها و اقلام</h2>
            <span>@Data.Invoices.Count فاکتور</span>
        </div>
        @if (Data.Invoices.Count == 0)
        {
            <p class="gex-customer-report-empty">در بازه انتخاب‌شده فاکتوری وجود ندارد.</p>
        }
        else
        {
            <div class="gex-customer-report-table-wrap">
                <table class="gex-customer-report-table gex-customer-invoices-table">
                    <thead>
                        <tr>
                            <th scope="col">تاریخ / سند</th>
                            <th scope="col">نوع / شرح</th>
                            <th scope="col">تعداد</th>
                            <th scope="col">وزن (گرم)</th>
                            <th scope="col">عیار</th>
                            <th scope="col">مبلغ / واحد</th>
                        </tr>
                    </thead>
                    @foreach (var invoice in Data.Invoices)
                    {
                        <tbody class="gex-customer-invoice-group">
                            <tr class="gex-customer-invoice-group-heading">
                                <td>
                                    <strong>فاکتور @invoice.InvoiceNumber</strong>
                                    <span class="gex-customer-muted">@invoice.InvoiceDate.ToShortDateString()</span>
                                </td>
                                <td colspan="4">
                                    <span class="gex-customer-invoice-type @(invoice.InvoiceType == InvoiceType.Sell ? "is-sale" : "is-purchase")">
                                        @invoice.InvoiceType.GetDisplayName()
                                    </span>
                                    <span class="gex-customer-group-count">@invoice.Items.Count قلم</span>
                                </td>
                                <td class="gex-customer-amount">@invoice.TotalAmount.ToCurrencyFormat(invoice.PriceUnitTitle)</td>
                            </tr>
                            @if (IncludeDetails)
                            {
                                @foreach (var item in invoice.Items)
                                {
                                    <tr class="gex-customer-invoice-item">
                                        <td class="gex-customer-item-marker">↳</td>
                                        <td>
                                            <span>@item.Description</span>
                                            <small class="gex-customer-muted">@item.Category</small>
                                        </td>
                                        <td>@item.Quantity.ToString("N3")</td>
                                        <td>@(item.Weight?.ToString("N3") ?? "—")</td>
                                        <td>@(item.Fineness?.ToString("N1") ?? "—")</td>
                                        <td>@item.Amount.ToCurrencyFormat(invoice.PriceUnitTitle)</td>
                                    </tr>
                                }
                                @if (invoice.DiscountAmount != 0 || invoice.ExtraCostAmount != 0)
                                {
                                    <tr class="gex-customer-invoice-adjustments">
                                        <td></td>
                                        <td colspan="5">
                                            @if (invoice.DiscountAmount != 0)
                                            {
                                                <span>تخفیف: @invoice.DiscountAmount.ToCurrencyFormat(invoice.PriceUnitTitle)</span>
                                            }
                                            @if (invoice.ExtraCostAmount != 0)
                                            {
                                                <span>هزینه اضافه: @invoice.ExtraCostAmount.ToCurrencyFormat(invoice.PriceUnitTitle)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    }
                </table>
            </div>
        }
    </section>

    <section class="gex-customer-report-section" aria-label="گردش مالی و تسویه‌ها">
        <div class="gex-customer-report-heading">
            <h2>گردش مالی و تسویه‌ها</h2>
        </div>
        @if (_activity.Count == 0)
        {
            <p class="gex-customer-report-empty">در بازه انتخاب‌شده گردش مالی یا پرداختی وجود ندارد.</p>
        }
        else
        {
            <div class="gex-customer-report-table-wrap">
                <table class="gex-customer-report-table gex-customer-ledger-table">
                    <thead>
                        <tr>
                            <th scope="col">تاریخ</th>
                            <th scope="col">شرح / روش تسویه</th>
                            <th scope="col">بدهکار</th>
                            <th scope="col">بستانکار</th>
                            <th scope="col">مانده</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in _activity)
                        {
                            @if (activity.Ledger is { } line)
                            {
                                <tr>
                                    <td>@line.PostingDate.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <span>@line.Description</span>
                                        @if (line.InvoicePaymentId is { } paymentId &&
                                             _paymentsById.TryGetValue(paymentId, out var matchedPayment))
                                        {
                                            <small class="gex-customer-muted">
                                                فاکتور @matchedPayment.InvoiceNumber · @matchedPayment.PaymentType.GetDisplayName()
                                                @if (!string.IsNullOrWhiteSpace(matchedPayment.ReferenceNumber))
                                                {
                                                    <span> · پیگیری @matchedPayment.ReferenceNumber</span>
                                                }
                                            </small>
                                        }
                                        else if (line.PaymentVoucherId.HasValue)
                                        {
                                            <small class="gex-customer-muted">سند پرداخت</small>
                                        }
                                        else if (line.CustomerTransferVoucherId.HasValue)
                                        {
                                            <small class="gex-customer-muted">حواله مشتری</small>
                                        }
                                    </td>
                                    <td>@(line.TransactionType == TransactionType.Debit ? line.Amount.ToCurrencyFormat(line.PriceUnitTitle) : "—")</td>
                                    <td>@(line.TransactionType == TransactionType.Credit ? line.Amount.ToCurrencyFormat(line.PriceUnitTitle) : "—")</td>
                                    <td class="@(line.RunningBalance > 0 ? "is-debit" : line.RunningBalance < 0 ? "is-credit" : "")">
                                        @FormatBalance(line.RunningBalance, line.PriceUnitTitle)
                                    </td>
                                </tr>
                            }
                            else if (activity.Payment is { } payment)
                            {
                                <tr class="gex-customer-unposted-payment">
                                    <td>@payment.PaymentDate.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <span>@payment.PaymentSide.GetDisplayName() · فاکتور @payment.InvoiceNumber · @payment.PaymentType.GetDisplayName()</span>
                                        <small class="gex-customer-muted">
                                            @payment.Amount.ToCurrencyFormat(payment.PriceUnitTitle)
                                            · سند فاقد ردیف متناظر در گردش حساب
                                        </small>
                                    </td>
                                    <td>—</td><td>—</td><td>—</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public CustomerComprehensiveRpResponse Data { get; set; } = default!;
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public bool IncludeDetails { get; set; } = true;

    private Dictionary<Guid, CustomerComprehensivePayment> _paymentsById = new();
    private List<CustomerActivityRow> _activity = new();

    protected override void OnParametersSet()
    {
        _paymentsById = Data.Payments
            .GroupBy(x => x.Id)
            .ToDictionary(x => x.Key, x => x.First());

        var paymentsWithLedger = Data.Transactions
            .Where(x => x.InvoicePaymentId.HasValue)
            .Select(x => x.InvoicePaymentId!.Value)
            .ToHashSet();

        _activity = Data.Transactions
            .Select(x => new CustomerActivityRow(x.PostingDate, x, null))
            .Concat(Data.Payments
                .Where(x => !paymentsWithLedger.Contains(x.Id))
                .Select(x => new CustomerActivityRow(x.PaymentDate, null, x)))
            .OrderBy(x => x.Date)
            .ThenBy(x => x.Ledger is null ? 1 : 0)
            .ToList();
    }

    private sealed record CustomerActivityRow(
        DateTime Date,
        CustomerTransactionRpResponse? Ledger,
        CustomerComprehensivePayment? Payment);

    private static string FormatBalance(decimal value, string unit) =>
        value == 0m ? 0m.ToCurrencyFormat(unit) :
        $"{Math.Abs(value).ToCurrencyFormat(unit)} {(value > 0 ? "بدهکار" : "بستانکار")}";
}
