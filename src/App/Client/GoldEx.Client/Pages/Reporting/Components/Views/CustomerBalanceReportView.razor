@using GoldEx.Client.Pages.Reporting.Components.Summaries
@using GoldEx.Shared.DTOs.Reporting
@inherits GoldExComponentBase

@if (Items is null || IsLoading)
{
    @if (IsLoading)
    {
        <div class="balance-report-loading" role="status">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <span>در حال آماده‌سازی گزارش...</span>
        </div>
    }
    else
    {
        <ReportViewPlaceHolder />
    }
}
else
{
    <section class="balance-report">
        <header class="balance-report-heading">
            <div><h2>گزارش مانده مشتریان</h2><span>@Items.Count ردیف</span></div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Print" OnClick="() => OnPrintReport.InvokeAsync()">
                چاپ گزارش
            </MudButton>
        </header>
        @if (Items.Count == 0)
        {
            <div class="balance-report-empty">برای فیلتر انتخاب‌شده موردی پیدا نشد.</div>
        }
        else
        {
            <div class="balance-report-desktop">
                <table>
                    <thead>
                    <tr>
                        <th><button type="button" @onclick='() => SetSort("name")'>طرف حساب @SortIndicator("name")</button></th>
                        <th>شماره تماس</th>
                        <th><button type="button" @onclick='() => SetSort("payable")'>حساب پرداختنی @SortIndicator("payable")</button></th>
                        <th><button type="button" @onclick='() => SetSort("receivable")'>حساب دریافتنی @SortIndicator("receivable")</button></th>
                        <th><button type="button" @onclick='() => SetSort("net")'>خالص @SortIndicator("net")</button></th>
                        <th>عملیات</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in VisibleItems)
                    {
                        <tr @key="row">
                            <td><strong>@row.CustomerName</strong><small>کد @row.CustomerCode</small></td>
                            <td>@row.CustomerPhoneNumber</td>
                            <td><span class="@AmountClass(row.PayableAmount)">@GetAmount(row.PayableAmount,row.PriceUnitTitle)</span></td>
                            <td><span class="@AmountClass(row.ReceivableAmount)">@GetAmount(row.ReceivableAmount,row.PriceUnitTitle)</span></td>
                            <td><span class="@NetClass(row)">@GetNetAmount(row)</span></td>
                            <td><button type="button" class="balance-report-details" @onclick="() => OnViewSource(row)">
                                <ShellIcon Name="eye" /> ریز تراکنش‌ها
                            </button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="balance-report-mobile">
                @foreach (var row in VisibleItems)
                {
                    <article class="balance-report-card" @key="row">
                        <header><div><strong>@row.CustomerName</strong><small>کد @row.CustomerCode</small></div>
                            <span class="@NetClass(row)">@GetNetAmount(row)</span></header>
                        @if (!string.IsNullOrWhiteSpace(row.CustomerPhoneNumber))
                        { <small class="balance-report-phone">@row.CustomerPhoneNumber</small> }
                        <div class="balance-report-values">
                            <div><small>پرداختنی</small><span class="@AmountClass(row.PayableAmount)">@GetAmount(row.PayableAmount,row.PriceUnitTitle)</span></div>
                            <div><small>دریافتنی</small><span class="@AmountClass(row.ReceivableAmount)">@GetAmount(row.ReceivableAmount,row.PriceUnitTitle)</span></div>
                        </div>
                        <button type="button" class="balance-report-details" @onclick="() => OnViewSource(row)">
                            <ShellIcon Name="eye" /> ریز تراکنش‌ها
                        </button>
                    </article>
                }
            </div>
            <footer class="balance-report-pagination">
                <label>تعداد ردیف
                    <select value="@_pageSize" @onchange="ChangePageSize" aria-label="تعداد ردیف در صفحه">
                        <option value="10">۱۰</option><option value="25">۲۵</option><option value="50">۵۰</option>
                    </select>
                </label>
                <nav aria-label="صفحه‌بندی گزارش">
                    <button type="button" disabled="@(_pageIndex==0)" @onclick="() => ChangePage(-1)">قبلی</button>
                    <span>@(_pageIndex+1) از @PageCount</span>
                    <button type="button" disabled="@(_pageIndex+1>=PageCount)" @onclick="() => ChangePage(1)">بعدی</button>
                </nav>
            </footer>
        }
    </section>
    <CustomerBalanceSummary Summary="@_summary" />
}