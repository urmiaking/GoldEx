@inherits GoldExComponentBase

<MudDialog Class="inventory-kardex-selector-dialog"
           ContentClass="inventory-kardex-selector-content">
     <DialogContent>
        <style>
            .inventory-kardex-selector-dialog .mud-dialog-content,
            .inventory-kardex-selector-content {
                max-height: 70vh !important;
                overflow-y: auto !important;
                overflow-x: auto !important;
            }
        </style>
        <InventoryStockList Elevation="0"
                            Selectable="true"
                            ShowItemStatus="true"
                            SelectedItemsChanged="OnSelectedItemsChanged">
        </InventoryStockList>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error"
                   OnClick="Close"
                   StartIcon="@Icons.Material.Filled.Close"
                   Variant="Variant.Filled">انصراف</MudButton>

        <MudButton Class="m-2"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="OnSubmit"
                   Variant="Variant.Filled">
            <MudText>انتخاب</MudText>
        </MudButton>
    </DialogActions>
</MudDialog>