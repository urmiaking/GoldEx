@attribute [Route(ClientRoutes.About.Index)]

@inherits GoldExComponentBase

<PageTitle>درباره گلدکس - سامانه جامع و دستیار هوشمند مدیریت طلا و جواهر</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-10">
    <MudBreadcrumbs Class="px-0" Items="_breadcrumbs" MaxItems="2">
        <SeparatorTemplate>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />
        </SeparatorTemplate>
    </MudBreadcrumbs>
    
    <!-- Hero Banner Section -->
    <MudPaper Class="pa-8 pa-md-12 mb-8 d-flex flex-column align-center justify-center text-center relative overflow-hidden" 
              Style="border-radius: 28px; background: linear-gradient(135deg, var(--mud-palette-surface) 0%, var(--mud-palette-background-gray) 100%); border: 1px solid var(--mud-palette-divider); box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
        
        <!-- Decorative subtle radial glow background -->
        <div style="position: absolute; top: -120px; right: -120px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgba(201,162,39,0.15) 0%, transparent 70%); pointer-events: none;"></div>
        <div style="position: absolute; bottom: -120px; left: -120px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgba(201,162,39,0.12) 0%, transparent 70%); pointer-events: none;"></div>

        <div class="align-center d-flex flex-wrap gap-2 justify-center mb-3">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Stars" Style="font-weight: bold; padding: 6px 14px;">
                پلتفرم نسل جدید مدیریت و حسابداری طلا
            </MudChip>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Verified" Style="font-weight: bold; padding: 6px 14px;">
                مورد تایید و هماهنگ با عرف بازار زرگران
            </MudChip>
        </div>

        <div class="d-flex align-center justify-center gap-3 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Diamond" Color="Color.Primary" Style="font-size: 3.8rem;" Class="pulse-icon" />
            <span class="brand-text" style="font-size: 3.5rem; letter-spacing: 1px; line-height: 1;">GoldEx</span>
        </div>
        
        <MudText Typo="Typo.h4" Class="font-weight-bold mb-4" Color="Color.Primary" Style="letter-spacing: -0.5px;">
            دستیار هوشمند، جامع و بدون خطای گالری‌های طلا و جواهر
        </MudText>
        
        <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width: 950px; line-height: 2.1; font-size: 1.15rem; text-align: justify;">
            سامانه فاخر <strong>گلدکس (GoldEx)</strong> پاسخی یکپارچه و هوشمند به تمامی نیازهای مدیریتی، فروش، انبارداری و حسابداری زرگری است. 
            این پلتفرم با تلفیق <strong>دستیار صوتی و متنی هوش مصنوعی</strong>، <strong>ویترین آنلاین و اختصاصی گالری</strong> و <strong>فرمول‌های بی‌نقص حسابداری دوطرفه</strong>، تمامی دغدغه‌های نوسانات لحظه‌ای نرخ بازار، پیچیدگی‌های محاسبات عیار و اجرت در حضور مشتری، کسری‌های کوره ذوب و ردیابی حساب‌های طلایی و ریالی را برای همیشه مرتفع نموده است.
        </MudText>

        <div class="d-flex flex-wrap justify-center gap-3 mt-6">
            <MudChip T="string" Variant="Variant.Text" Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary">دستیار گفتگویی هوش مصنوعی</MudChip>
            <MudChip T="string" Variant="Variant.Text" Icon="@Icons.Material.Filled.Storefront" Color="Color.Primary">ویترین اینترنتی اختصاصی</MudChip>
            <MudChip T="string" Variant="Variant.Text" Icon="@Icons.Material.Filled.Speed" Color="Color.Primary">پیش‌خوان سریع و بدون وقفه</MudChip>
            <MudChip T="string" Variant="Variant.Text" Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary">تراز طلایی و ریالی همزمان</MudChip>
            <MudChip T="string" Variant="Variant.Text" Icon="@Icons.Material.Filled.WifiOff" Color="Color.Primary">کارکرد مداوم حتی در قطعی اینترنت</MudChip>
        </div>
    </MudPaper>

    <!-- 3 Big Breakthroughs Section -->
    <div class="d-flex align-center gap-3 mb-5 mt-8">
        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Color="Color.Primary" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
                سه دستاورد تحول‌آفرین و اختصاصی گلدکس
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                نوآوری‌هایی که گالری شما را چند گام از رقبا پیش می‌اندازد
            </MudText>
        </div>
    </div>

    <MudGrid Class="mb-8" Spacing="4">
        <!-- Breakthrough 1: AI Assistant -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Class="pa-6 h-100 d-flex flex-column relative overflow-hidden" 
                     Style="border-radius: 24px; border: 1px solid var(--mud-palette-primary); background: linear-gradient(180deg, rgba(201,162,39,0.06) 0%, var(--mud-palette-surface) 100%);">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="pa-3 rounded-circle" style="background: linear-gradient(135deg, rgba(201,162,39,0.2) 0%, rgba(201,162,39,0.05) 100%);">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Large" />
                    </div>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: bold;">
                        پیشتاز و هوشمند
                    </MudChip>
                </div>

                <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">
                    دستیار صوتی و متنی هوش مصنوعی
                </MudText>
                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Primary">
                    مدیریت و صدور فاکتور تنها با یک پیام ساده
                </MudText>

                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1 mb-4" Style="line-height: 1.9; text-align: justify;">
                    دیگر نیازی به ثبت فرم‌های وقت‌گیر ندارید! فقط به دستیار هوشمند بگویید <em>«فاکتور فروش ۴ گرم طلای ۱۸ عیار برای آقای حسینی با پرداخت نقد»</em> تا فاکتور استاندارد در کسری از ثانیه صادر و آماده چاپ گردد. همچنین استعلام لحظه‌ای موجودی گاوصندوق، مانده‌حساب مشتریان و تحلیل رشد فروش ماهانه با یک سوال ساده در دسترس شماست.
                </MudText>

                <MudDivider Class="my-2" />
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">صدور آنی فاکتور با پیام صوتی و متنی</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">تحلیل هوشمند و مقایسه ماهانه رشد فروش</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">استعلام فوری مانده و موجودی بدون معطلی</MudText>
                    </div>
                </div>
            </MudCard>
        </MudItem>

        <!-- Breakthrough 2: Online Vitrine -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Class="pa-6 h-100 d-flex flex-column relative overflow-hidden" 
                     Style="border-radius: 24px; border: 1px solid var(--mud-palette-divider); background: linear-gradient(180deg, rgba(33,150,243,0.05) 0%, var(--mud-palette-surface) 100%);">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="pa-3 rounded-circle" style="background: linear-gradient(135deg, rgba(33,150,243,0.2) 0%, rgba(33,150,243,0.05) 100%);">
                        <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Info" Size="Size.Large" />
                    </div>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: bold;">
                        افزایش چشمگیر فروش
                    </MudChip>
                </div>

                <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">
                    ویترین آنلاین و کاتالوگ دیجیتال
                </MudText>
                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Info">
                    سایت اختصاصی گالری با محاسبه زنده قیمت
                </MudText>

                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1 mb-4" Style="line-height: 1.9; text-align: justify;">
                    گالری خود را به یک نمایشگاه آنلاین شبانه‌روزی با آدرس اختصاصی و برند خود مجهز کنید. خریداران می‌توانند کارهای فاخر و سرویس‌های طلا را با گالری عکس‌های باکیفیت تماشا کنند. قیمت هر کار <strong>به صورت خودکار و لحظه‌ای بر اساس نرخ روز طلا، اجرت و سود</strong> محاسبه شده و خریدار با یک کلیک در پیام‌رسان‌ها (واتس‌اپ، بله) سفارش می‌دهد.
                </MudText>

                <MudDivider Class="my-2" />
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">آدرس و صفحه اختصاصی با برند و نام گالری</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">محاسبه خودکار قیمت روز بدون تماس تلفنی</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">سفارش‌گیری مستقیم در پیام‌رسان‌های معتبر</MudText>
                    </div>
                </div>
            </MudCard>
        </MudItem>

        <!-- Breakthrough 3: Executive Dashboard -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Class="pa-6 h-100 d-flex flex-column relative overflow-hidden" 
                     Style="border-radius: 24px; border: 1px solid var(--mud-palette-divider); background: linear-gradient(180deg, rgba(76,175,80,0.05) 0%, var(--mud-palette-surface) 100%);">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="pa-3 rounded-circle" style="background: linear-gradient(135deg, rgba(76,175,80,0.2) 0%, rgba(76,175,80,0.05) 100%);">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: bold;">
                        سرعت و اشراف کامل
                    </MudChip>
                </div>

                <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">
                    پیش‌خوان فرماندهی و مدیریت آنی
                </MudText>
                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Success">
                    رصد در یک نگاه سرمایه‌ها و مانده مشتریان
                </MudText>

                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1 mb-4" Style="line-height: 1.9; text-align: justify;">
                    تمام نبض گالری در یک نگاه زیر دستان شماست! موجودی تفکیک‌شده ارزها (دلار، یورو)، سکه‌های بانکی، طلای آب‌شده و دست‌دوم به تفکیک روی صفحه اصلی نمایان است. همچنین <strong>مانده‌حساب طلایی و ریالی دقیق مشتری بلافاصله پای هر فاکتور</strong> درج می‌شود تا کوچک‌ترین بدهی یا طلب فراموش نشود.
                </MudText>

                <MudDivider Class="my-2" />
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">دسترسی برق‌آسا به فاکتورها، انبار و حساب‌ها</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">تفکیک شفاف موجودی ارزی، سکه و طلای خام</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Class="font-weight-bold">محاسبه آنی مانده‌حساب پس از هر تراکنش</MudText>
                    </div>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Comprehensive Capabilities Section -->
    <div class="d-flex align-center gap-3 mb-5 mt-10">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Large" />
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
                ستون‌های اقتدار و ابزارهای تخصصی صنف زرگری
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                تمام ظرافت‌ها و جزییات بازار طلا با نهایت دقت پیاده‌سازی شده‌اند
            </MudText>
        </div>
    </div>
    
    <MudGrid Class="mb-8" Spacing="4">
        <!-- Live pricing -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-5 h-100 d-flex flex-column" Style="border-radius: 20px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center gap-3 mb-3">
                    <div class="pa-2 rounded-circle" style="background-color: rgba(201,162,39,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">رصد بی‌وقفه نرخ بازار</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1" Style="line-height: 1.9; text-align: justify;">
                    بدون نیاز به تماس‌های تلفنی مکرر یا باز کردن سایت‌های گوناگون، نرخ لحظه‌ای انواع طلا (مظنه مثقال، ۱۸ و ۲۴ عیار، آب‌شده)، مسکوکات بانکی و ارزهای آزاد همواره پیش روی شما به‌روزرسانی می‌شود.
                </MudText>
            </MudCard>
        </MudItem>

        <!-- Advanced calculator -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-5 h-100 d-flex flex-column" Style="border-radius: 20px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center gap-3 mb-3">
                    <div class="pa-2 rounded-circle" style="background-color: rgba(201,162,39,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">محاسبه‌گر جادویی و معکوس زرگری</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1" Style="line-height: 1.9; text-align: justify;">
                    محاسبه عیار ۷۵۰، اجرت، سود قانونی و تخفیف‌ها در کسری از ثانیه انجام می‌شود. با ابزار «محاسبه معکوس» می‌توانید فوراً به مشتری بگویید با بودجه ریالی مشخص، دقیقاً چه وزنی از طلا می‌توان تحویل داد.
                </MudText>
            </MudCard>
        </MudItem>

        <!-- Automated accounting & Remittance -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-5 h-100 d-flex flex-column" Style="border-radius: 20px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center gap-3 mb-3">
                    <div class="pa-2 rounded-circle" style="background-color: rgba(201,162,39,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">دفتر حساب طلا و ریال و حواله</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1" Style="line-height: 1.9; text-align: justify;">
                    گردش حساب مشتریان هم به صورت وزن طلای ۱۸ عیار و هم مبالغ ریالی ثبت شده و سیستم امکان صدور مستقیم حواله بین مشتریان و تسویه حساب‌های باز را با بالاترین دقت فراهم می‌سازد.
                </MudText>
            </MudCard>
        </MudItem>

        <!-- Smart Invoices & Multi-payment -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-5 h-100 d-flex flex-column" Style="border-radius: 20px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center gap-3 mb-3">
                    <div class="pa-2 rounded-circle" style="background-color: rgba(201,162,39,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">فاکتورهای رسمی و تسویه ترکیبی</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1" Style="line-height: 1.9; text-align: justify;">
                    چاپ فاکتورهای رسمی، شکیل و مطابق استاندارد اتحادیه در ابعاد استاندارد A5. مشتری می‌تواند تسویه فاکتور را به صورت ترکیبی از کارتخوان، نقد، چک بانکی و طلای تعویضی و کهنه پرداخت نماید.
                </MudText>
            </MudCard>
        </MudItem>

        <!-- Inventory, Melting, Assay -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-5 h-100 d-flex flex-column" Style="border-radius: 20px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center gap-3 mb-3">
                    <div class="pa-2 rounded-circle" style="background-color: rgba(201,162,39,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">گاوصندوق، کوره ذوب و ری‌گیری</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1" Style="line-height: 1.9; text-align: justify;">
                    کنترل لحظه‌ای موجودی ویترین با بارکدخوان، حساب‌وکتاب دقیق وزن ذوب طلاهای مستعمل، کسر عیار آزمایشگاه (ری‌گیری)، محاسبه افت کوره و استخراج سود پنهان ذوب طلا بدون ذره‌ای خطا.
                </MudText>
            </MudCard>
        </MudItem>

        <!-- Anti-Fluctuation & Offline Engine -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-5 h-100 d-flex flex-column" Style="border-radius: 20px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center gap-3 mb-3">
                    <div class="pa-2 rounded-circle" style="background-color: rgba(201,162,39,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.WifiOff" Color="Color.Primary" Size="Size.Medium" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-weight-bold">تداوم فروش در زمان قطعی اینترنت</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1" Style="line-height: 1.9; text-align: justify;">
