@page "/price-board"
@attribute [Authorize]
@inherits GoldExComponentBase

<PageTitle>تابلو قیمت‌های بازار</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudBreadcrumbs Class="px-0 py-2 mb-4" Items="_breadcrumbs" MaxItems="2">
        <SeparatorTemplate>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />
        </SeparatorTemplate>
    </MudBreadcrumbs>

    <PriceBoard ShowTitle="false" />
</MudContainer>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new ("صفحه اصلی", href: ClientRoutes.Home.Index, icon: Icons.Material.Filled.Home),
        new ("تابلو قیمت‌ها", href: ClientRoutes.PriceBoard.Index, icon: Icons.Material.Filled.TableChart)
    ];
}
