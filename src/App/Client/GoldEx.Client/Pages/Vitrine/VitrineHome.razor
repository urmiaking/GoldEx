@page "/{StoreSlug}"
@layout VitrineLayout
@attribute [AllowAnonymous]
@implements IDisposable

@using GoldEx.Shared.DTOs.Vitrine
@using GoldEx.Shared.Services.Abstractions
@using GoldEx.Shared.Enums
@using GoldEx.Shared.Routings
@inject IVitrineService VitrineService
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject IStoreContext StoreContext

<PageTitle>ویترین آنلاین @(_storeInfo?.Name ?? "گالری طلا و جواهر")</PageTitle>

<HeadContent>
    @{
        var canonicalUrl = StoreContext.IsCustomDomain 
            ? Navigation.ToAbsoluteUri("/").ToString() 
            : Navigation.ToAbsoluteUri($"/{EffectiveStoreSlug}").ToString();
        var storeName = _storeInfo?.Name ?? "گالری طلا و جواهر";
        var pageTitle = $"ویترین آنلاین طلا و جواهرات {storeName}";
        var pageDesc = _storeInfo?.AboutText ?? $"ویترین رسمی و کاتالوگ آنلاین طلا و جواهرات {storeName} با محاسبه زنده قیمت روز، عیار استاندارد ۷۵۰ و استعلام سریع.";
        var logoUrl = !string.IsNullOrWhiteSpace(_storeInfo?.LogoUrl) ? Navigation.ToAbsoluteUri(_storeInfo.LogoUrl).ToString() : null;
    }

    <link rel="canonical" href="@canonicalUrl" />
    <meta name="description" content="@pageDesc" />
    <meta name="keywords" content="@($"ویترین طلا, گالری طلا, {storeName}, خرید آنلاین طلا, قیمت طلا 18 عیار, طلا 750, طلا و جواهر")" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="@storeName" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDesc" />
    @if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        <meta property="og:image" content="@logoUrl" />
        <meta property="og:image:alt" content="@storeName" />
        <link rel="icon" type="image/png" href="@logoUrl" />
        <link rel="shortcut icon" href="@logoUrl" />
        <link rel="apple-touch-icon" href="@logoUrl" />
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDesc" />
    @if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        <meta name="twitter:image" content="@logoUrl" />
    }

    <!-- JSON-LD Structured Data: JewelryStore -->
    <script type="application/ld+json">
    @((MarkupString)GetStoreJsonLd(canonicalUrl, logoUrl, storeName, pageDesc))
    </script>
</HeadContent>

<div class="vitrine-container">
    <!-- Asymmetric Editorial Hero Section -->
    <section class="vitrine-hero animate-fade-in">
        <div class="vitrine-hero-inner">
            <div class="vitrine-hero-subtitle">کلکسیون فاخر سال ۱۴۰۵</div>
            <h1 class="vitrine-hero-title">
                داستانی نو برای <span>درخشش استایل شما</span>
            </h1>
            <p class="vitrine-hero-desc">
                در ویترین رسمی @(_storeInfo?.Name ?? "گالری طلا و جواهر")، هر قطعه طلا تلفیقی از هنر اصیل طلاسازی و عیار استاندارد ۷۵۰ است. محاسبه زنده قیمت روز، اجرت ساخت منصفانه و ارائه فاکتور معتبر رسمی.
            </p>

            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
                <a href="@CatalogUrl" class="btn-gisu btn-gisu-accent" style="padding: 15px 34px;">
                    <span>مشاهده کاتالوگ محصولات (@_products.Count قطعه)</span>
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                @if (!string.IsNullOrWhiteSpace(_storeInfo?.WhatsAppNumber))
                {
                    var waPhone = _storeInfo.WhatsAppNumber.Replace(" ", "").Replace("-", "").TrimStart('+');
                    if (waPhone.StartsWith("09")) waPhone = "98" + waPhone.Substring(1);
                    <a href="@($"https://wa.me/{waPhone}")" target="_blank" class="btn-gisu btn-gisu-outline" style="padding: 15px 26px;">
                        <i class="fa-brands fa-whatsapp" style="color: #25d366;"></i>
                        <span>مشاوره و استعلام در واتساپ</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Trust Feature Cards (4 Pillars) -->
    <div class="vitrine-trust-grid animate-fade-in-up">
        <div class="vitrine-trust-card">
            <div class="vitrine-trust-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <div class="vitrine-trust-title">تضمین عیار ۷۵۰</div>
                <div class="vitrine-trust-desc">اصالت کتبی کلیه طلاها و جواهرات</div>
            </div>
        </div>
        <div class="vitrine-trust-card">
            <div class="vitrine-trust-icon">
                <i class="fa-solid fa-receipt"></i>
            </div>
            <div>
                <div class="vitrine-trust-title">فاکتور رسمی معتبر</div>
                <div class="vitrine-trust-desc">صدور فاکتور سیستمی به نام خریدار</div>
            </div>
        </div>
        <div class="vitrine-trust-card">
            <div class="vitrine-trust-icon">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div>
                <div class="vitrine-trust-title">قیمت‌گذاری شفاف</div>
                <div class="vitrine-trust-desc">محاسبه آنلاین با نرخ زنده مظنه روز</div>
            </div>
        </div>
        <div class="vitrine-trust-card">
            <div class="vitrine-trust-icon">
                <i class="fa-solid fa-comments"></i>
            </div>
            <div>
                <div class="vitrine-trust-title">مشاوره و استعلام آنی</div>
                <div class="vitrine-trust-desc">پاسخگویی سریع در واتساپ و بله</div>
            </div>
        </div>
    </div>

    <!-- Category Pills Bar -->
    @if (_categories.Count > 0)
    {
        <section style="margin-bottom: 35px;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0; color: var(--primary-color);">
                    دسته‌بندی‌های طلا و جواهر
                </h3>
                <a href="@CatalogUrl" style="color: var(--accent-color); font-size: 0.88rem; text-decoration: none; font-weight: 700;">
                    همه دسته‌ها ←
                </a>
            </div>

            <div class="vitrine-categories-bar">
                <a href="@CatalogUrl" class="vitrine-category-pill active">
                    <i class="fa-solid fa-gem"></i>
                    <span>همه دسته‌بندی‌ها</span>
                    <span class="vitrine-category-count">@_products.Count</span>
                </a>
                @foreach (var cat in _categories)
                {
                    <a href="@GetCategoryCatalogUrl(cat.Id)" class="vitrine-category-pill">
                        <i class="@GetCategoryIcon(cat.Title)"></i>
                        <span>@cat.Title</span>
                        <span class="vitrine-category-count">@cat.ProductCount</span>
                    </a>
                }
            </div>
        </section>
    }

    <!-- Featured Products Showcase (کالکشن‌های برگزیده) -->
    @if (_featuredProducts.Count > 0)
    {
        <section class="vitrine-showcase-box" style="margin-bottom: 45px;">
            <div class="showcase-header d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div class="showcase-title-box">
                    <h2 class="showcase-title">
                        ⭐ پیشنهادات <span style="color: var(--accent-color);">ویژه و برگزیده</span> گالری
                    </h2>
                    <div class="showcase-title-line"></div>
                </div>
                <a href="@FeaturedCatalogUrl" class="showcase-link-all">
                    <span>مشاهده همه</span>
                    <i class="fa-solid fa-angle-left"></i>
                </a>
            </div>

            <div class="vitrine-home-slider">
                @foreach (var product in _featuredProducts)
                {
                    <a href="@GetProductUrl(product.Barcode)" class="product-card product-slider-card animate-fade-in-up @(!product.IsAvailable ? "is-sold" : "")">
                        <div class="product-image">
                            @if (!product.IsAvailable)
                            {
                                <span class="product-badge badge-sold">فروخته شد</span>
                                <span class="product-badge badge-top-left">عیار @(product.Fineness > 0 ? product.Fineness.ToString("G29") : "750")</span>
                                <span class="product-badge badge-bottom-right">@(product.Weight.ToString("G29")) گرم</span>
                                @if (product.IsFeatured)
                            {
                                <span class="product-badge badge-featured">⭐ ویژه</span>
                            }
                            }
                            else
                            {
                                <span class="product-badge badge-top-right">@(product.Weight.ToString("G29")) گرم</span>
                                <span class="product-badge badge-top-left">عیار @(product.Fineness > 0 ? product.Fineness.ToString("G29") : "750")</span>
                                @if (product.IsFeatured)
                                {
                                    <span class="product-badge badge-featured">⭐ ویژه</span>
                                }
                                else if (product.ProductType == ProductType.Jewelry)
                                {
                                    <span class="product-badge badge-bottom-left">💎 جواهر</span>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                            {
                                <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="product-no-image">
                                    <i class="fa-solid fa-gem"></i>
                                    <span>بدون تصویر</span>
                                </div>
                            }
                        </div>
                        <div class="product-info">
                            <span class="product-category">@(product.CategoryTitle ?? "طلا و جواهر")</span>
                            <h3 class="product-title" title="@product.Name">@product.Name</h3>
                            <div class="product-price-container">
                                <span class="product-price-label">مبلغ با مظنه روز:</span>
                                <div class="product-price">
                                    @product.EstimatedPrice.ToString("N0") <small style="font-size: 0.75rem; font-weight: normal; color: var(--gray-600);">تومان</small>
                                </div>
                            </div>
                        </div>
                    </a>
                }

                <!-- Ending Card -->
                <a href="@FeaturedCatalogUrl" class="slider-view-all-card animate-fade-in-up" title="مشاهده همه برگزیده‌ها">
                    <div class="slider-view-all-circle">
                        <i class="fa-solid fa-arrow-left"></i>
                    </div>
                    <span class="slider-view-all-text">مشاهده همه</span>
                </a>
            </div>
        </section>
    }

    <!-- Recent Arrivals Showcase (مشابه دیجی‌کالا) -->
    <section class="vitrine-showcase-box" style="margin-bottom: 55px;">
        <div class="showcase-header d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="showcase-title-box">
                <h2 class="showcase-title">
                    جدیدترین کارهای <span style="color: var(--accent-color);">ویترین</span>
                </h2>
                <div class="showcase-title-line"></div>
            </div>

            <a href="@CatalogUrl" class="showcase-link-all">
                <span>مشاهده همه</span>
                <i class="fa-solid fa-angle-left"></i>
            </a>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="vitrine-ticker-pulse d-inline-block mb-3" style="width: 28px; height: 28px;"></div>
                <div style="color: var(--gray-600); font-weight: 700;">در حال بارگذاری زیورآلات ویترین...</div>
            </div>
        }
        else if (FilteredHomeProducts.Count == 0)
        {
            <div class="text-center py-5" style="background: var(--white); border-radius: var(--border-radius-sm); border: 1px solid var(--gray-200); padding: 50px 20px; box-shadow: var(--shadow-subtle);">
                <i class="fa-solid fa-gem mb-3" style="font-size: 3rem; color: var(--accent-color); display: block;"></i>
                <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--primary-color); margin-bottom: 8px;">ویترین در حال چیدمان است</h3>
                <p style="color: var(--gray-600); max-width: 420px; margin: 0 auto 20px;">
                    به زودی جدیدترین کارهای طلا و جواهر در این ویترین قرار خواهند گرفت.
                </p>
            </div>
        }
        else
        {
            <div class="vitrine-home-slider">
                @foreach (var product in FilteredHomeProducts)
                {
                    <a href="@GetProductUrl(product.Barcode)" class="product-card product-slider-card animate-fade-in-up @(!product.IsAvailable ? "is-sold" : "")">
                        <div class="product-image">
                            @if (!product.IsAvailable)
                            {
                                <span class="product-badge badge-sold">فروخته شد</span>
                                <span class="product-badge badge-top-left">عیار @(product.Fineness > 0 ? product.Fineness.ToString("G29") : "750")</span>
                                <span class="product-badge badge-bottom-right">@(product.Weight.ToString("G29")) گرم</span>
                                @if (product.IsFeatured)
                                {
                                    <span class="product-badge badge-featured">⭐ ویژه</span>
                                }
                            }
                            else
                            {
                                <span class="product-badge badge-top-right">@(product.Weight.ToString("G29")) گرم</span>
                                <span class="product-badge badge-top-left">عیار @(product.Fineness > 0 ? product.Fineness.ToString("G29") : "750")</span>
                                @if (product.IsFeatured)
                                {
                                    <span class="product-badge badge-featured">⭐ ویژه</span>
                                }
                                else if (product.ProductType == ProductType.Jewelry)
                                {
                                    <span class="product-badge badge-bottom-left">💎 جواهر</span>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                            {
                                <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="product-no-image">
                                    <i class="fa-solid fa-gem"></i>
                                    <span>بدون تصویر</span>
                                </div>
                            }
                        </div>
                        <div class="product-info">
                            <span class="product-category">@(product.CategoryTitle ?? "طلا و جواهر")</span>
                            <h3 class="product-title" title="@product.Name">@product.Name</h3>
                            <div class="product-price-container">
                                <span class="product-price-label">مبلغ با مظنه روز:</span>
                                <div class="product-price">
                                    @product.EstimatedPrice.ToString("N0") <small style="font-size: 0.75rem; font-weight: normal; color: var(--gray-600);">تومان</small>
                                </div>
                            </div>
                        </div>
                    </a>
                }

                <!-- Dedicated Digikala-style 'مشاهده همه' (View All) Card -->
                <a href="@CatalogUrl" class="slider-view-all-card animate-fade-in-up" title="مشاهده همه محصولات کاتالوگ">
                    <div class="slider-view-all-circle">
                        <i class="fa-solid fa-arrow-left"></i>
                    </div>
                    <span class="slider-view-all-text">مشاهده همه</span>
                </a>
            </div>
        }
    </section>

    <!-- Consultation & Custom Order Banner -->
    <section style="background: var(--accent-soft); border: 1px solid var(--accent-color); border-radius: var(--border-radius-sm); padding: 45px 30px; margin-bottom: 60px; text-align: center; box-shadow: var(--shadow-subtle);">
        <h3 style="font-size: 1.8rem; font-weight: 900; color: var(--primary-color); margin-bottom: 12px;">نیاز به مشاوره یا سفارش طرح خاص دارید؟</h3>
        <p style="color: var(--gray-600); max-width: 600px; margin: 0 auto 28px; line-height: 1.9;">
            کارشناسان گالری آماده پاسخگویی به سوالات شما در مورد وزن، اجرت ساخت، عیار و نحوه تحویل حضوری یا ارسال سفارش هستند.
        </p>
        <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(_storeInfo?.WhatsAppNumber))
            {
                var wa = _storeInfo.WhatsAppNumber.Replace(" ", "").Replace("-", "").TrimStart('+');
                if (wa.StartsWith("09")) wa = "98" + wa.Substring(1);
                <a href="@($"https://wa.me/{wa}")" target="_blank" class="btn-gisu btn-gisu-whatsapp" style="padding: 12px 28px;">
                    <i class="fa-brands fa-whatsapp"></i>
                    <span>گفت‌وگو در واتساپ</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(_storeInfo?.BaleUrl))
            {
                <a href="@_storeInfo.BaleUrl" target="_blank" class="btn-gisu btn-gisu-bale" style="padding: 12px 28px;">
                    <i class="fa-solid fa-comment"></i>
                    <span>پیام در بله</span>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(_storeInfo?.PhoneNumber))
            {
                <a href="@($"tel:{_storeInfo.PhoneNumber}")" class="btn-gisu btn-gisu-outline" style="padding: 12px 24px;">
                    <i class="fa-solid fa-phone"></i>
                    <span>تماس با گالری (@_storeInfo.PhoneNumber)</span>
                </a>
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public string? StoreSlug { get; set; }
    [CascadingParameter] private VitrineStoreInfoDto? _storeInfo { get; set; }

    private string EffectiveStoreSlug => !string.IsNullOrWhiteSpace(StoreSlug)
        ? StoreSlug
        : (!string.IsNullOrWhiteSpace(_storeInfo?.Slug) 
            ? _storeInfo.Slug 
            : (!string.IsNullOrWhiteSpace(StoreContext.StoreSlug) ? StoreContext.StoreSlug : ""));

    private string CatalogUrl => StoreContext.IsCustomDomain ? "/catalog" : $"/{EffectiveStoreSlug}/catalog";
    private string FeaturedCatalogUrl => StoreContext.IsCustomDomain ? "/catalog?onlyFeatured=true" : $"/{EffectiveStoreSlug}/catalog?onlyFeatured=true";
    private string GetCategoryCatalogUrl(Guid? catId) => StoreContext.IsCustomDomain 
        ? (catId.HasValue ? $"/catalog?categoryId={catId}" : "/catalog") 
        : (catId.HasValue ? $"/{EffectiveStoreSlug}/catalog?categoryId={catId}" : $"/{EffectiveStoreSlug}/catalog");
    private string GetProductUrl(string barcode) => StoreContext.IsCustomDomain ? $"/p/{barcode}" : $"/{EffectiveStoreSlug}/p/{barcode}";

    private List<VitrineProductSummaryDto> _products = [];
    private List<VitrineProductSummaryDto> _featuredProducts = [];
    private List<VitrineCategoryDto> _categories = [];
    private bool _isLoading = true;
    private PersistingComponentStateSubscription _persistingSubscription;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistHomeData);

        var restoredCategories = ApplicationState.TryTakeFromJson<List<VitrineCategoryDto>>("vitrine_home_categories", out var catRestored) && catRestored != null
            ? catRestored
            : (!string.IsNullOrWhiteSpace(EffectiveStoreSlug) && ApplicationState.TryTakeFromJson<List<VitrineCategoryDto>>($"vitrine_home_categories_{EffectiveStoreSlug}", out catRestored) && catRestored != null ? catRestored : null);

        var restoredProducts = ApplicationState.TryTakeFromJson<List<VitrineProductSummaryDto>>("vitrine_home_products", out var prodRestored) && prodRestored != null
            ? prodRestored
            : (!string.IsNullOrWhiteSpace(EffectiveStoreSlug) && ApplicationState.TryTakeFromJson<List<VitrineProductSummaryDto>>($"vitrine_home_products_{EffectiveStoreSlug}", out prodRestored) && prodRestored != null ? prodRestored : null);

        if (restoredCategories != null && restoredProducts != null)
        {
            _categories = restoredCategories;
            _products = restoredProducts;
            _featuredProducts = _products.Where(x => x.IsFeatured).Take(4).ToList();
            _isLoading = false;
        }
        else
        {
            await LoadDataAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        if (_products.Count == 0 && !_isLoading)
        {
            await LoadDataAsync();
        }
    }

    private Task PersistHomeData()
    {
        if (_categories != null && _categories.Count > 0)
        {
            ApplicationState.PersistAsJson("vitrine_home_categories", _categories);
            if (!string.IsNullOrWhiteSpace(EffectiveStoreSlug))
            {
                ApplicationState.PersistAsJson($"vitrine_home_categories_{EffectiveStoreSlug}", _categories);
            }
        }
        if (_products != null && _products.Count > 0)
        {
            ApplicationState.PersistAsJson("vitrine_home_products", _products);
            if (!string.IsNullOrWhiteSpace(EffectiveStoreSlug))
            {
                ApplicationState.PersistAsJson($"vitrine_home_products_{EffectiveStoreSlug}", _products);
            }
        }
        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _categories = (await VitrineService.GetCategoriesAsync(EffectiveStoreSlug)).ToList();
            var allProducts = (await VitrineService.GetVitrineProductsAsync(EffectiveStoreSlug)).ToList();

            _products = allProducts;
            _featuredProducts = allProducts.Where(x => x.IsFeatured).Take(4).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading vitrine: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _persistingSubscription.Dispose();
    }

    private List<VitrineProductSummaryDto> FilteredHomeProducts => _products.Take(8).ToList();

    private string GetCategoryIcon(string title)
    {
        if (string.IsNullOrEmpty(title)) return "fa-solid fa-gem";
        if (title.Contains("انگشتر")) return "fa-solid fa-ring";
        if (title.Contains("النگو") || title.Contains("تک‌پوش")) return "fa-regular fa-circle-dot";
        if (title.Contains("دستبند")) return "fa-solid fa-link";
        if (title.Contains("گردنبند") || title.Contains("پلاک") || title.Contains("مدال")) return "fa-solid fa-gem";
        if (title.Contains("گوشواره")) return "fa-solid fa-wand-magic-sparkles";
        if (title.Contains("سرویس") || title.Contains("نیم‌ست")) return "fa-solid fa-crown";
        if (title.Contains("سکه")) return "fa-solid fa-coins";
        if (title.Contains("جواهر")) return "fa-solid fa-diamond";
        return "fa-solid fa-gem";
    }

    private string GetStoreJsonLd(string canonicalUrl, string? logoUrl, string storeName, string pageDesc)
    {
        var sameAsList = new List<string>();
        if (!string.IsNullOrWhiteSpace(_storeInfo?.InstagramUrl)) sameAsList.Add(_storeInfo.InstagramUrl);
        if (!string.IsNullOrWhiteSpace(_storeInfo?.TelegramUrl)) sameAsList.Add(_storeInfo.TelegramUrl);
        if (!string.IsNullOrWhiteSpace(_storeInfo?.BaleUrl)) sameAsList.Add(_storeInfo.BaleUrl);
        if (!string.IsNullOrWhiteSpace(_storeInfo?.WhatsAppNumber)) sameAsList.Add($"https://wa.me/{_storeInfo.WhatsAppNumber.Replace(" ", "").Replace("-", "").TrimStart('+')}");

        var jsonObject = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "JewelryStore",
            ["name"] = storeName,
            ["url"] = canonicalUrl,
            ["logo"] = logoUrl,
            ["image"] = logoUrl,
            ["description"] = pageDesc,
            ["telephone"] = _storeInfo?.PhoneNumber,
            ["priceRange"] = "$$$$",
            ["currenciesAccepted"] = "IRT",
            ["paymentAccepted"] = "Cash, Credit Card, Bank Transfer",
            ["address"] = !string.IsNullOrWhiteSpace(_storeInfo?.Address)
                ? new Dictionary<string, object>
                {
                    ["@type"] = "PostalAddress",
                    ["streetAddress"] = _storeInfo.Address,
                    ["addressCountry"] = "IR"
                }
                : null,
            ["sameAs"] = sameAsList.Count > 0 ? sameAsList : null
        };

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
}
