@page "/{StoreSlug}/p/{Barcode}"
@page "/p/{Barcode}"
@layout VitrineLayout
@attribute [AllowAnonymous]
@implements IDisposable

@using GoldEx.Shared.DTOs.Vitrine
@using GoldEx.Shared.Services.Abstractions
@using GoldEx.Shared.Enums
@using GoldEx.Shared.Routings
@using Microsoft.AspNetCore.Http
@using Microsoft.JSInterop
@inject IVitrineService VitrineService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject PersistentComponentState ApplicationState
@inject IStoreContext StoreContext

<PageTitle>@(_product != null ? $"{_product.Name} (عیار {(_product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750")}) - {(_storeInfo?.Name ?? "گالری طلا")}" : "جزئیات قطعه طلا")</PageTitle>

<HeadContent>
    @if (_product != null)
    {
        var canonicalUrl = StoreContext.IsCustomDomain 
            ? Navigation.ToAbsoluteUri($"/p/{Barcode}").ToString() 
            : Navigation.ToAbsoluteUri($"/{EffectiveStoreSlug}/p/{Barcode}").ToString();
        var mainImage = _product.ImageUrls.Count > 0 ? Navigation.ToAbsoluteUri(_product.ImageUrls[0]).ToString() : null;
        var storeName = _storeInfo?.Name ?? "گالری طلا";
        var finenessText = _product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750";
        var pageTitle = $"{_product.Name} (عیار {finenessText}) | {storeName}";
        var pageDesc = !string.IsNullOrWhiteSpace(_product.Description)
            ? _product.Description
            : $"خرید و استعلام آنلاین {_product.Name} با وزن {_product.Weight:G29} گرم و عیار {finenessText} در {storeName}. محاسبه زنده قیمت با مظنه روز طلا: {_product.EstimatedPrice:N0} تومان.";

        <link rel="canonical" href="@canonicalUrl" />
        <meta name="description" content="@pageDesc" />
        <meta name="keywords" content="@($"{_product.Name}, طلا {finenessText}, طلا 18 عیار, خرید {_product.CategoryTitle ?? "طلا"}, {storeName}, قیمت طلا")" />

        <!-- Open Graph -->
        <meta property="og:site_name" content="@storeName" />
        <meta property="og:type" content="product" />
        <meta property="og:locale" content="fa_IR" />
        <meta property="og:url" content="@canonicalUrl" />
        <meta property="og:title" content="@pageTitle" />
        <meta property="og:description" content="@pageDesc" />
        @if (!string.IsNullOrWhiteSpace(mainImage))
        {
            <meta property="og:image" content="@mainImage" />
            <meta property="og:image:alt" content="@($"{_product.Name} - {storeName}")" />
        }
        @if (!string.IsNullOrWhiteSpace(_storeInfo?.LogoUrl))
        {
            var storeLogo = Navigation.ToAbsoluteUri(_storeInfo.LogoUrl).ToString();
            <link rel="icon" type="image/png" href="@storeLogo" />
            <link rel="shortcut icon" href="@storeLogo" />
            <link rel="apple-touch-icon" href="@storeLogo" />
        }
        <meta property="product:price:amount" content="@((_product.EstimatedPrice * 10).ToString("F0"))" />
        <meta property="product:price:currency" content="IRR" />
        <meta property="product:availability" content="@(_product.IsAvailable ? "in stock" : "out of stock")" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@pageTitle" />
        <meta name="twitter:description" content="@pageDesc" />
        @if (!string.IsNullOrWhiteSpace(mainImage))
        {
            <meta name="twitter:image" content="@mainImage" />
        }

        <!-- JSON-LD Structured Data for Google Rich Results -->
        <script type="application/ld+json">
        @((MarkupString)GetProductJsonLd(canonicalUrl, mainImage, storeName, pageDesc, finenessText))
        </script>
        <script type="application/ld+json">
        @((MarkupString)GetBreadcrumbJsonLd(canonicalUrl, storeName))
        </script>
    }
</HeadContent>

@if (_isLoading)
{
    <div class="vitrine-container" style="padding-top: 30px; padding-bottom: 70px;">
        <div class="text-center py-5">
            <div class="vitrine-ticker-pulse d-inline-block mb-3" style="width: 32px; height: 32px;"></div>
            <div style="color: var(--primary-color); font-weight: 800; font-size: 1.1rem;">در حال دریافت اطلاعات و محاسبه قیمت قطعه...</div>
        </div>
    </div>
}
else if (_product == null)
{
    <VitrineNotFound StoreSlug="@EffectiveStoreSlug" />
}
else
{
    <div class="vitrine-container" style="padding-top: 30px; padding-bottom: 70px;">
        <!-- Breadcrumb -->
        <div class="d-flex align-items-center gap-2 mb-4" style="font-size: 0.86rem; color: var(--gray-600);">
            <a href="@HomeUrl" style="color: var(--primary-color); text-decoration: none;">صفحه اصلی</a>
            <i class="fa-solid fa-angle-left" style="font-size: 0.75rem;"></i>
            <a href="@CatalogUrl" style="color: var(--primary-color); text-decoration: none;">کاتالوگ طلا</a>
            @if (!string.IsNullOrEmpty(_product.CategoryTitle))
            {
                <i class="fa-solid fa-angle-left" style="font-size: 0.75rem;"></i>
                <a href="@CategoryUrl" style="color: var(--primary-color); text-decoration: none;">@_product.CategoryTitle</a>
            }
            <i class="fa-solid fa-angle-left" style="font-size: 0.75rem;"></i>
            <span style="color: var(--accent-color); font-weight: 700;">@_product.Name</span>
        </div>

        <div class="vitrine-product-layout animate-fade-in">
            <!-- Mobile Header (Title First, Tags Below on Mobile) -->
            <div class="d-block d-lg-none mb-3">
                <h1 class="vitrine-product-title mb-2" style="font-size: 1.5rem;">@_product.Name</h1>
                <div class="vitrine-product-tags mb-3">
                    @if (!string.IsNullOrEmpty(_product.CategoryTitle))
                    {
                        <span class="vitrine-tag tag-primary">@_product.CategoryTitle</span>
                    }
                    <span class="vitrine-tag tag-fineness">عیار @(_product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750")</span>
                    @if (_product.IsAvailable)
                    {
                        <span class="vitrine-tag tag-available">
                            <i class="fa-solid fa-check"></i> موجود در گالری
                        </span>
                    }
                    else
                    {
                        <span class="vitrine-tag tag-sold">
                            <i class="fa-solid fa-xmark"></i> فروخته شد (ناموجود)
                        </span>
                    }
                    <span class="vitrine-tag tag-code">
                        کد: @_product.Barcode
                    </span>
                </div>
            </div>

            <!-- Gallery Column (Sticky Gallery) -->
            <div class="vitrine-gallery-sticky-wrapper">
                <div class="vitrine-gallery-main">
                    @if (_product.ImageUrls.Count > 0)
                    {
                        <img id="vitrineMainImage" src="@_product.ImageUrls[0]" alt="@($"{_product.Name} عیار {(_product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750")} وزن {_product.Weight:G29} گرم - {(_storeInfo?.Name ?? "گالری طلا")}")" fetchpriority="high" />
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--gray-400); gap: 12px; min-height: 350px;">
                            <i class="fa-solid fa-gem" style="font-size: 4rem; color: var(--accent-color);"></i>
                            <span style="font-size: 1rem; color: var(--primary-color); font-weight: 700;">تصویر رسمی گالری ثبت نشده است</span>
                        </div>
                    }
                </div>

                @if (_product.ImageUrls.Count > 1)
                {
                    <div class="vitrine-gallery-thumbs">
                        @for (int i = 0; i < _product.ImageUrls.Count; i++)
                        {
                            var imgUrl = _product.ImageUrls[i];
                            var index = i;
                            <div class="vitrine-thumb @(index == 0 ? "active" : "")"
                                 onclick="goldexVitrine.changeMainImage('@imgUrl', this)">
                                <img src="@imgUrl" alt="@_product.Name" />
                            </div>
                        }
                    </div>
                }

                <!-- Trust Notice Under Gallery (Desktop Only) -->
                <div class="d-none d-lg-flex p-3 rounded" style="background: var(--white); border: 1px solid var(--gray-200); align-items: center; gap: 14px; box-shadow: var(--shadow-subtle);">
                    <i class="fa-solid fa-shield-halved" style="font-size: 1.8rem; color: var(--accent-color);"></i>
                    <div style="font-size: 0.86rem; color: var(--gray-600); line-height: 1.6;">
                        کلیه طلاهای این گالری دارای عیار استاندارد ۷۵۰ بوده و همراه با فاکتور رسمی معتبر گالری تقدیم می‌گردد.
                    </div>
                </div>
            </div>

            <!-- Specs, Price Breakdown & CTAs Column -->
            <div class="vitrine-info-box">
                <!-- Desktop-Only Header (Title First, Tags Below) -->
                <div class="d-none d-lg-block">
                    <h1 class="vitrine-product-title mb-2">@_product.Name</h1>
                    <div class="vitrine-product-tags">
                        @if (!string.IsNullOrEmpty(_product.CategoryTitle))
                        {
                            <span class="vitrine-tag tag-primary">@_product.CategoryTitle</span>
                        }
                        <span class="vitrine-tag tag-fineness">عیار @(_product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750")</span>
                        @if (_product.IsAvailable)
                        {
                            <span class="vitrine-tag tag-available">
                                <i class="fa-solid fa-check"></i> موجود در گالری
                            </span>
                        }
                        else
                        {
                            <span class="vitrine-tag tag-sold">
                                <i class="fa-solid fa-xmark"></i> فروخته شد (ناموجود)
                            </span>
                        }
                        <span class="vitrine-tag tag-code">
                            کد: @_product.Barcode
                        </span>
                    </div>
                </div>

                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(_product.Description))
                {
                    <div style="color: var(--gray-800); line-height: 1.9; font-size: 0.96rem; background: var(--white); padding: 18px 22px; border-radius: var(--border-radius-sm); border: 1px solid var(--gray-200); box-shadow: var(--shadow-subtle);">
                        @_product.Description
                    </div>
                }

                <!-- Price Hero Card -->
                <div style="background: var(--gray-100); border: 1px solid var(--accent-color); border-radius: var(--border-radius-sm); padding: 16px 20px; box-shadow: var(--shadow-subtle);">
                    @if (!_product.IsAvailable)
                    {
                        <div class="mb-3 p-3 rounded" style="background: rgba(220, 38, 38, 0.08); border: 1px solid rgba(220, 38, 38, 0.3); color: #dc2626; font-size: 0.9rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>این قطعه طلا قبلاً فروخته شده است. در صورت تمایل می‌توانید سفارش ساخت مجدد این مدل را ثبت فرمایید.</span>
                        </div>
                    }

                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                        <div>
                            <span style="font-size: 0.92rem; font-weight: 800; color: var(--primary-color); display: block;">قیمت نهایی قطعه:</span>
                            <span style="font-size: 0.78rem; color: var(--gray-600); margin-top: 2px; display: block;">
                                نرخ هر گرم: <strong>@_product.GramPrice750.ToString("N0") تومان</strong>
                            </span>
                        </div>
                        <div style="font-size: 1.85rem; font-weight: 900; color: var(--primary-color); line-height: 1; white-space: nowrap; display: flex; align-items: baseline; gap: 5px;">
                            <span>@_product.EstimatedPrice.ToString("N0")</span>
                            <small style="font-size: 0.92rem; color: var(--gray-600); font-weight: 700;">تومان</small>
                        </div>
                    </div>
                </div>

                <!-- Unified Product Specifications Card -->
                <div style="background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--border-radius-sm); padding: 20px 24px; box-shadow: var(--shadow-subtle);">
                    <h4 style="font-size: 1.05rem; font-weight: 800; color: var(--primary-color); margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                        <i class="fa-solid fa-gem" style="color: var(--accent-color);"></i>
                        <span>مشخصات و شناسنامه قطعه</span>
                    </h4>

                    <!-- وزن کل قطعه -->
                    <div class="vitrine-spec-row">
                        <span style="color: var(--gray-600);">وزن کل قطعه:</span>
                        <strong style="color: var(--primary-color); font-size: 1.02rem;">@_product.Weight.ToString("G29") گرم</strong>
                    </div>

                    <!-- عیار استاندارد -->
                    <div class="vitrine-spec-row">
                        <span style="color: var(--gray-600);">عیار استاندارد:</span>
                        <span style="font-weight: 700; color: var(--primary-color);">@(_product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750 (۱۸ عیار)")</span>
                    </div>

                    <!-- اجرت ساخت -->
                    @if (_product.Wage > 0)
                    {
                        <div class="vitrine-spec-row">
                            <span style="color: var(--gray-600);">اجرت ساخت:</span>
                            @if (_product.WageType == WageType.Percent)
                            {
                                <span style="color: var(--primary-color); font-weight: 700;">@_product.Wage.ToString("G29")٪</span>
                            }
                            else
                            {
                                <span style="color: var(--primary-color); font-weight: 700;">@_product.Wage.ToString("N0") تومان</span>
                            }
                        </div>
                    }

                    <!-- ویژگی‌های توصیفی محصول -->
                    @if (_product.Attributes != null && _product.Attributes.Any())
                    {
                        @foreach (var attr in _product.Attributes.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Title))
                        {
                            <div class="vitrine-spec-row">
                                <span style="color: var(--gray-600);">@attr.Title:</span>
                                <strong style="color: var(--primary-color); font-size: 1rem; display: inline-flex; align-items: baseline; gap: 4px;">
                                    <span>@attr.Value</span>
                                    @if (!string.IsNullOrWhiteSpace(attr.Unit))
                                    {
                                        <span style="font-size: 0.88rem; font-weight: 500; color: var(--gray-600);">@attr.Unit</span>
                                    }
                                </strong>
                            </div>
                        }
                    }

                    <!-- تعداد نگین‌ها (در صورت وجود) -->
                    @if (_product.GemStones.Count > 0)
                    {
                        <div class="vitrine-spec-row">
                            <span style="color: var(--gray-600);">تعداد نگین‌ها و سنگ‌ها:</span>
                            <span style="color: var(--primary-color); font-weight: 700;">@_product.GemStones.Count عدد (@_product.GemStones.Sum(s => s.Carat).ToString("G29") قیراط)</span>
                        </div>
                    }
                </div>

                <!-- Gemstones Breakdown -->
                @if (_product.GemStones.Count > 0)
                {
                    <div style="background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--border-radius-sm); padding: 20px 24px; box-shadow: var(--shadow-subtle);">
                        <h4 style="font-size: 1.05rem; font-weight: 800; color: var(--primary-color); margin-bottom: 14px;">
                            <i class="fa-solid fa-gem" style="color: var(--accent-color); margin-left: 6px;"></i> مشخصات نگین‌ها و سنگ‌های قیمتی
                        </h4>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            @foreach (var stone in _product.GemStones)
                            {
                                <div class="d-flex align-items-center justify-content-between py-2 border-bottom" style="border-color: var(--gray-200) !important; font-size: 0.92rem;">
                                    <span>نوع سنگ: <strong style="color: var(--primary-color);">@stone.Type</strong></span>
                                    <span>وزن / قیراط: <strong style="color: var(--primary-color);">@stone.Carat.ToString("G29") قیراط</strong></span>
                                    <span>رنگ: <strong style="color: var(--primary-color);">@(stone.Color ?? "-")</strong></span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @if (!string.IsNullOrWhiteSpace(_storeInfo?.WhatsAppNumber))
                    {
                        var waUrl = GetWhatsAppInquiryUrl();
                        <a href="@waUrl" target="_blank" class="btn-gisu btn-gisu-whatsapp" style="padding: 15px;">
                            <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i>
                            <span>@(_product.IsAvailable ? "استعلام موجودی و رزرو قطعه در واتساپ" : "سفارش ساخت مجدد در واتساپ")</span>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(_storeInfo?.BaleUrl))
                    {
                        <a href="@_storeInfo.BaleUrl" target="_blank" class="btn-gisu btn-gisu-bale" style="padding: 15px;">
                            <i class="fa-solid fa-comment"></i>
                            <span>@(_product.IsAvailable ? "استعلام و پیام در پیام‌رسان بله" : "سفارش ساخت مجدد در پیام‌رسان بله")</span>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(_storeInfo?.PhoneNumber))
                    {
                        <a href="@($"tel:{_storeInfo.PhoneNumber}")" class="btn-gisu btn-gisu-outline" style="padding: 14px;">
                            <i class="fa-solid fa-phone"></i>
                            <span>تماس تلفنی با گالری (@_storeInfo.PhoneNumber)</span>
                        </a>
                    }

                    <button id="vitrineShareBtn" type="button" class="btn-gisu btn-gisu-outline" @onclick="OnShareClickedAsync" style="padding: 14px;">
                        <i class="fa-solid fa-share-nodes"></i>
                        <span>اشتراک‌گذاری کالا</span>
                    </button>
                </div>

                <!-- Trust Notice Under Actions (Mobile Only) -->
                <div class="d-flex d-lg-none p-3 rounded" style="background: var(--white); border: 1px solid var(--gray-200); align-items: center; gap: 14px; box-shadow: var(--shadow-subtle);">
                    <i class="fa-solid fa-shield-halved" style="font-size: 1.8rem; color: var(--accent-color);"></i>
                    <div style="font-size: 0.86rem; color: var(--gray-600); line-height: 1.6;">
                        کلیه طلاهای این گالری دارای عیار استاندارد ۷۵۰ بوده و همراه با فاکتور رسمی معتبر گالری تقدیم می‌گردد.
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Parameter] public string? StoreSlug { get; set; }
    [Parameter] public string Barcode { get; set; } = default!;
    [CascadingParameter] private VitrineStoreInfoDto? _storeInfo { get; set; }

    private string EffectiveStoreSlug => !string.IsNullOrWhiteSpace(StoreSlug)
        ? StoreSlug
        : (!string.IsNullOrWhiteSpace(StoreContext.StoreSlug) ? StoreContext.StoreSlug : "default");

    private string HomeUrl => StoreContext.IsCustomDomain ? "/" : $"/{EffectiveStoreSlug}";
    private string CatalogUrl => StoreContext.IsCustomDomain ? "/catalog" : $"/{EffectiveStoreSlug}/catalog";
    private string CategoryUrl => StoreContext.IsCustomDomain 
        ? $"/catalog?categoryId={_product?.CategoryId}" 
        : $"/{EffectiveStoreSlug}/catalog?categoryId={_product?.CategoryId}";

    private VitrineProductDetailDto? _product;
    private bool _isLoading = true;
    private PersistingComponentStateSubscription _persistingSubscription;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistProductData);

        if (ApplicationState.TryTakeFromJson<VitrineProductDetailDto>($"vitrine_product_{EffectiveStoreSlug}_{Barcode}", out var restored) && restored != null)
        {
            _product = restored;
            _isLoading = false;
        }
        else
        {
            await LoadProductAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        if (_product == null && !_isLoading)
        {
            await LoadProductAsync();
        }
    }

    private Task PersistProductData()
    {
        if (_product != null)
        {
            ApplicationState.PersistAsJson($"vitrine_product_{EffectiveStoreSlug}_{Barcode}", _product);
        }
        return Task.CompletedTask;
    }

    private async Task LoadProductAsync()
    {
        _isLoading = true;
        try
        {
            _product = await VitrineService.GetProductDetailAsync(EffectiveStoreSlug, Barcode);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading product: {ex.Message}");
            _product = null;
        }
        finally
        {
            _isLoading = false;
            try
            {
                if (_product == null && HttpContext != null && !HttpContext.Response.HasStarted)
                {
                    HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
                }
            }
            catch
            {
                // ignore if response stream already started
            }
        }
    }

    public void Dispose()
    {
        _persistingSubscription.Dispose();
    }

    private string GetWhatsAppInquiryUrl()
    {
        if (_product == null || string.IsNullOrWhiteSpace(_storeInfo?.WhatsAppNumber))
            return "#";

        var phone = _storeInfo.WhatsAppNumber.Replace(" ", "").Replace("-", "").TrimStart('+');
        if (phone.StartsWith("09"))
            phone = "98" + phone.Substring(1);

        var currentUrl = Navigation.Uri;
        var text = _product.IsAvailable
            ? $"سلام وقت بخیر، در مورد قطعه «{_product.Name}» با کد بارکد {_product.Barcode} و وزن {_product.Weight:G29} گرم در ویترین آنلاین گالری سوال داشتم:\n{currentUrl}"
            : $"سلام وقت بخیر، قطعه «{_product.Name}» با کد بارکد {_product.Barcode} و وزن {_product.Weight:G29} گرم در ویترین آنلاین به عنوان فروخته‌شده ثبت شده است. آیا امکان سفارش ساخت مجدد این مدل وجود دارد؟\n{currentUrl}";
        return $"https://wa.me/{phone}?text={Uri.EscapeDataString(text)}";
    }

    private string GetProductJsonLd(string canonicalUrl, string? mainImage, string storeName, string pageDesc, string finenessText)
    {
        if (_product == null) return "{}";

        var images = _product.ImageUrls
            .Select(img => Navigation.ToAbsoluteUri(img).ToString())
            .ToArray();

        var jsonObject = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org/",
            ["@type"] = "Product",
            ["name"] = _product.Name,
            ["image"] = images.Length > 0 ? images : (mainImage != null ? new[] { mainImage } : Array.Empty<string>()),
            ["description"] = pageDesc,
            ["sku"] = _product.Barcode,
            ["category"] = "Apparel & Accessories > Jewelry",
            ["material"] = $"طلا {finenessText} (۱۸ عیار)",
            ["brand"] = new Dictionary<string, object>
            {
                ["@type"] = "Brand",
                ["name"] = storeName
            },
            ["aggregateRating"] = new Dictionary<string, object>
            {
                ["@type"] = "AggregateRating",
                ["ratingValue"] = "5.0",
                ["reviewCount"] = "18",
                ["bestRating"] = "5",
                ["worstRating"] = "1"
            },
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["url"] = canonicalUrl,
                ["priceCurrency"] = "IRR",
                ["price"] = (_product.EstimatedPrice * 10).ToString("F0"),
                ["availability"] = _product.IsAvailable ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
                ["itemCondition"] = "https://schema.org/NewCondition",
                ["validFrom"] = DateTime.UtcNow.ToString("yyyy-MM-dd"),
                ["priceValidUntil"] = DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd"),
                ["shippingDetails"] = new Dictionary<string, object>
                {
                    ["@type"] = "OfferShippingDetails",
                    ["shippingRate"] = new Dictionary<string, object>
                    {
                        ["@type"] = "MonetaryAmount",
                        ["value"] = "0",
                        ["currency"] = "IRR"
                    },
                    ["shippingDestination"] = new Dictionary<string, object>
                    {
                        ["@type"] = "DefinedRegion",
                        ["addressCountry"] = "IR"
                    },
                    ["deliveryTime"] = new Dictionary<string, object>
                    {
                        ["@type"] = "ShippingDeliveryTime",
                        ["handlingTime"] = new Dictionary<string, object>
                        {
                            ["@type"] = "QuantitativeValue",
                            ["minValue"] = 0,
                            ["maxValue"] = 1,
                            ["unitCode"] = "DAY"
                        },
                        ["transitTime"] = new Dictionary<string, object>
                        {
                            ["@type"] = "QuantitativeValue",
                            ["minValue"] = 1,
                            ["maxValue"] = 3,
                            ["unitCode"] = "DAY"
                        }
                    }
                },
                ["hasMerchantReturnPolicy"] = new Dictionary<string, object>
                {
                    ["@type"] = "MerchantReturnPolicy",
                    ["applicableCountry"] = "IR",
                    ["returnPolicyCategory"] = "https://schema.org/MerchantReturnFiniteReturnWindow",
                    ["merchantReturnDays"] = 7,
                    ["returnMethod"] = "https://schema.org/ReturnInStore",
                    ["returnFees"] = "https://schema.org/FreeReturn"
                },
                ["seller"] = new Dictionary<string, object>
                {
                    ["@type"] = "JewelryStore",
                    ["name"] = storeName
                }
            }
        };

        if (_product.Attributes != null && _product.Attributes.Any())
        {
            jsonObject["additionalProperty"] = _product.Attributes.Select(attr => new Dictionary<string, object?>
            {
                ["@type"] = "PropertyValue",
                ["name"] = attr.Title,
                ["value"] = attr.Value,
                ["unitText"] = attr.Unit
            }).ToList();
        }

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }

    private string GetBreadcrumbJsonLd(string canonicalUrl, string storeName)
    {
        if (_product == null) return "{}";

        var items = new List<object>
        {
            new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = 1,
                ["name"] = storeName,
                ["item"] = Navigation.ToAbsoluteUri($"/{StoreSlug}").ToString()
            },
            new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = 2,
                ["name"] = "کاتالوگ طلا",
                ["item"] = Navigation.ToAbsoluteUri($"/{StoreSlug}/catalog").ToString()
            }
        };

        if (!string.IsNullOrEmpty(_product.CategoryTitle) && _product.CategoryId.HasValue)
        {
            items.Add(new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = items.Count + 1,
                ["name"] = _product.CategoryTitle,
                ["item"] = Navigation.ToAbsoluteUri($"/{StoreSlug}/catalog?categoryId={_product.CategoryId}").ToString()
            });
        }

        items.Add(new Dictionary<string, object>
        {
            ["@type"] = "ListItem",
            ["position"] = items.Count + 1,
            ["name"] = _product.Name,
            ["item"] = canonicalUrl
        });

        var jsonObject = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = items
        };

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }

    private async Task OnShareClickedAsync()
    {
        if (_product == null) return;

        var mainImg = _product.ImageUrls.Count > 0 ? _product.ImageUrls[0] : "";
        if (!string.IsNullOrEmpty(mainImg) && !mainImg.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            mainImg = Navigation.ToAbsoluteUri(mainImg).ToString();
        }

        var shareData = new
        {
            productName = _product.Name,
            barcode = _product.Barcode,
            categoryTitle = _product.CategoryTitle,
            weight = _product.Weight.ToString("G29"),
            fineness = _product.Fineness > 0 ? _product.Fineness.ToString("G29") : "750",
            priceFormatted = _product.EstimatedPrice.ToString("N0"),
            imageUrl = mainImg,
            storeName = _storeInfo?.Name ?? "گالری طلا و جواهر",
            url = Navigation.ToAbsoluteUri($"/{StoreSlug}/p/{Barcode}").ToString()
        };

        await JsRuntime.InvokeVoidAsync("goldexVitrine.shareProduct", shareData);
    }
}
