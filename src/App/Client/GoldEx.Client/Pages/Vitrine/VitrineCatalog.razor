        </div>

        <!-- ویجت محدوده اجرت ساخت -->
        <div class="sidebar-widget">
            <h3>محدوده اجرت ساخت</h3>
            <div class="filter-pills-vertical">
                <a class="filter-pill-btn @(_wageFilter == "all" ? "active" : "")"
                        href="@(GetCatalogUrl("wage", "all"))" data-vitrine-catalog-link>
                    <span>همه اجرت‌ها</span>
                    @if (_wageFilter == "all")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_wageFilter == "low" ? "active" : "")"
                        href="@(GetCatalogUrl("wage", "low"))" data-vitrine-catalog-link>
                    <span>طلای کم‌اجرت (زیر ۱۰٪ - اقتصادی)</span>
                    @if (_wageFilter == "low")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_wageFilter == "medium" ? "active" : "")"
                        href="@(GetCatalogUrl("wage", "medium"))" data-vitrine-catalog-link>
                    <span>اجرت متوسط (۱۰٪ تا ۲۰٪)</span>
                    @if (_wageFilter == "medium")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_wageFilter == "high" ? "active" : "")"
                        href="@(GetCatalogUrl("wage", "high"))" data-vitrine-catalog-link>
                    <span>کارهای فاخر و پرکار (بالای ۲۰٪)</span>
                    @if (_wageFilter == "high")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
            </div>
        </div>

        <!-- ویجت‌های ویژگی‌های توصیفی پویا (آکاردئونی و باز و بسته‌شونده) -->
        @foreach (var group in AvailableAttributeFacets)
        {
            var hasActiveFilter = _selectedAttributeFilters.ContainsKey(group.AttributeId);

            <details class="sidebar-widget" open="@hasActiveFilter" data-vitrine-facet="@group.AttributeId">
                <summary class="widget-collapsible">
                    <div class="d-flex align-items-center gap-2">
                        <span>@group.Title @(!string.IsNullOrWhiteSpace(group.Unit) ? $"({group.Unit})" : "")</span>
                        @if (hasActiveFilter)
                        {
                            <span class="active-facet-dot"></span>
                        }
                    </div>
                    <i class="fa-solid fa-chevron-down widget-toggle-icon"></i>
                </summary>

                    <div class="filter-pills-vertical" style="margin-top: 10px;">
                        <a class="filter-pill-btn @(!_selectedAttributeFilters.ContainsKey(group.AttributeId) ? "active" : "")"
                                href="@(GetCatalogUrl(attributeId: group.AttributeId))" data-vitrine-catalog-link>
                            <span>همه</span>
                            @if (!_selectedAttributeFilters.ContainsKey(group.AttributeId))
                            {
                                <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                            }
                        </a>
                        @foreach (var val in group.Values)
                        {
                            var isSelected = _selectedAttributeFilters.TryGetValue(group.AttributeId, out var currentVal) && currentVal.Equals(val, StringComparison.OrdinalIgnoreCase);
                            <a class="filter-pill-btn @(isSelected ? "active" : "")"
                                    href="@(GetCatalogUrl(attributeId: group.AttributeId, attributeValue: val))" data-vitrine-catalog-link>
                                <span>@val</span>
                                @if (isSelected)
                                {
                                    <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                                }
                            </a>
                        }
                    </div>
            </details>
        }

        <!-- دکمه پاک کردن فیلترها -->
        @if (HasActiveFilters)
        {
            <a class="btn-gisu btn-gisu-outline" style="width: 100%; justify-content: center; font-size: 0.86rem;" href="@(CatalogUrl)" data-vitrine-catalog-link>
                <i class="fa-solid fa-rotate-left"></i>
                <span>حذف تمام فیلترها (@ActiveFiltersCount)</span>
            </a>
        }
    </text>;

    [Parameter] public string? StoreSlug { get; set; }

    private string EffectiveStoreSlug => !string.IsNullOrWhiteSpace(StoreSlug)
        ? StoreSlug
        : (!string.IsNullOrWhiteSpace(_storeInfo?.Slug) 
            ? _storeInfo.Slug 
            : (!string.IsNullOrWhiteSpace(StoreContext.StoreSlug) ? StoreContext.StoreSlug : ""));

    private string HomeUrl => StoreContext.IsCustomDomain ? "/" : $"/{EffectiveStoreSlug}";

    private string GetProductUrl(string barcode) => StoreContext.IsCustomDomain
        ? $"/p/{barcode}"
        : $"/{EffectiveStoreSlug}/p/{barcode}";

    private string CatalogUrl => StoreContext.IsCustomDomain ? "/catalog" : $"/{EffectiveStoreSlug}/catalog";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            return;
        }

        _selectedCategoryId = CategoryId;
        _selectedProductType = Enum.TryParse<ProductType>(SelectedType, true, out var productType)
            && productType is ProductType.Gold or ProductType.Jewelry ? productType : null;
        _onlyFeatured = OnlyFeatured is true;
        _onlyAvailable = OnlyAvailable is true;
        _searchTerm = QuerySearch?.Trim() ?? "";
        _weightFilter = WeightRange is "under_2" or "2_to_5" or "5_to_10" or "over_10" ? WeightRange : "all";
        _wageFilter = WageRange is "low" or "medium" or "high" ? WageRange : "all";
        _sortBy = Sort is "price_asc" or "price_desc" or "wage_asc" or "wage_desc" or "weight_asc" or "weight_desc" ? Sort : "newest";
        _visibleCount = (int)Math.Min((long)Math.Max(Pages ?? 1, 1) * PageSize, int.MaxValue);

        _selectedAttributeFilters.Clear();
        foreach (var attribute in Attributes ?? [])
        {
            var separator = attribute.IndexOf(':');
            if (separator > 0 && Guid.TryParse(attribute.AsSpan(0, separator), out var id) &&
                !string.IsNullOrWhiteSpace(attribute[(separator + 1)..]))
            {
                _selectedAttributeFilters[id] = attribute[(separator + 1)..];
            }
        }

        try
        {
            _categories = (await VitrineService.GetCategoriesAsync(EffectiveStoreSlug)).ToList();
            _products = (await VitrineService.GetVitrineProductsAsync(EffectiveStoreSlug)).ToList();
            FilteredProducts = FilterProducts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<KeyValuePair<string, string>> GetCatalogParameters(
        string? key = null, string? value = null, Guid? attributeId = null, string? attributeValue = null, int? pages = null)
    {
        var filters = new Dictionary<string, string?>
        {
            ["categoryId"] = _selectedCategoryId?.ToString(),
            ["type"] = _selectedProductType?.ToString(),
            ["onlyFeatured"] = _onlyFeatured ? "true" : null,
            ["onlyAvailable"] = _onlyAvailable ? "true" : null,
            ["q"] = _searchTerm,
            ["weight"] = _weightFilter == "all" ? null : _weightFilter,
            ["wage"] = _wageFilter == "all" ? null : _wageFilter,
            ["sort"] = _sortBy == "newest" ? null : _sortBy
        };
        if (key != null)
            filters[key] = value is "all" or "newest" ? null : value;

        foreach (var (name, item) in filters)
        {
            if (!string.IsNullOrEmpty(item))
                yield return new(name, item);
        }

        foreach (var (id, attribute) in _selectedAttributeFilters)
        {
            if (id != attributeId)
                yield return new("attribute", $"{id}:{attribute}");
        }

        if (attributeId.HasValue && !string.IsNullOrEmpty(attributeValue))
            yield return new("attribute", $"{attributeId}:{attributeValue}");

        if (pages > 1)
            yield return new("pages", pages.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private string GetCatalogUrl(string? key = null, string? value = null, Guid? attributeId = null, string? attributeValue = null, int? pages = null)
    {
        var query = string.Join("&", GetCatalogParameters(key, value, attributeId, attributeValue, pages)
            .Select(pair => $"{pair.Key}={Uri.EscapeDataString(pair.Value)}"));
        return query.Length == 0 ? CatalogUrl : $"{CatalogUrl}?{query}";
    }

    public record AttributeFacetGroup(Guid AttributeId, string Title, string? Unit, List<string> Values);

    private List<AttributeFacetGroup> AvailableAttributeFacets
    {
        get
        {
            var baseProducts = _products.AsEnumerable();
            if (_selectedCategoryId.HasValue)
            {
                baseProducts = baseProducts.Where(p => p.CategoryId == _selectedCategoryId.Value);
            }

            var allAttrs = baseProducts
                .SelectMany(p => p.Attributes ?? Enumerable.Empty<VitrineAttributeValueDto>())
                .Where(a => !string.IsNullOrWhiteSpace(a.Value))
                .GroupBy(a => new { a.AttributeId, a.Title, a.Unit, a.DisplayOrder })
                .OrderBy(g => g.Key.DisplayOrder)
                .ThenBy(g => g.Key.Title)
                .Select(g => new AttributeFacetGroup(
                    g.Key.AttributeId,
                    g.Key.Title,
                    g.Key.Unit,
                    g.Select(x => x.Value.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList()
                ))
                .Where(g => g.Values.Count > 0)
                .ToList();

            return allAttrs;
        }
    }

    private string GetWeightFilterTitle(string weight) => weight switch
    {
        "under_2" => "زیر ۲ گرم",
        "2_to_5" => "۲ تا ۵ گرم",
        "5_to_10" => "۵ تا ۱۰ گرم",
        "over_10" => "بالای ۱۰ گرم",
        _ => "همه وزن‌ها"
    };

    private string GetWageFilterTitle(string wage) => wage switch
    {
        "low" => "کم‌اجرت (زیر ۱۰٪)",
        "medium" => "اجرت ۱۰ تا ۲۰٪",
        "high" => "اجرت بالای ۲۰٪",
        _ => "همه اجرت‌ها"
    };

    private static decimal GetEffectiveWage(VitrineProductSummaryDto p)
    {
        if (p.WageType == WageType.Percent)
            return p.Wage;

        if (p.EstimatedPrice > 0 && p.WageAmount > 0)
            return Math.Round((p.WageAmount / p.EstimatedPrice) * 100m, 2);

        return p.Wage;
    }

    private int ActiveFiltersCount
    {
        get
        {
            int count = 0;
            if (_selectedCategoryId.HasValue) count++;
            if (_selectedProductType.HasValue) count++;
            if (_onlyFeatured) count++;
            if (_onlyAvailable) count++;
            if (_weightFilter != "all") count++;
            if (_wageFilter != "all") count++;
            if (!string.IsNullOrWhiteSpace(_searchTerm)) count++;
            count += _selectedAttributeFilters.Count;
            return count;
        }
    }

    private bool HasActiveFilters => ActiveFiltersCount > 0;

    private IEnumerable<VitrineProductSummaryDto> VisibleProducts => FilteredProducts.Take(_visibleCount);

    private List<VitrineProductSummaryDto> FilteredProducts { get; set; } = [];

    private List<VitrineProductSummaryDto> FilterProducts()
    {
        var result = _products.AsEnumerable();

        if (_onlyAvailable)
        {
            result = result.Where(x => x.IsAvailable);
        }

        if (_selectedCategoryId.HasValue)
        {
            result = result.Where(x => x.CategoryId == _selectedCategoryId.Value);
        }

        if (_selectedProductType.HasValue)
        {
            result = result.Where(x => x.ProductType == _selectedProductType.Value);
        }

        if (_onlyFeatured)
        {
            result = result.Where(x => x.IsFeatured);
        }

        if (_weightFilter == "under_2")
        {
            result = result.Where(x => x.Weight < 2.0m);
        }
        else if (_weightFilter == "2_to_5")
        {
            result = result.Where(x => x.Weight >= 2.0m && x.Weight <= 5.0m);
        }
        else if (_weightFilter == "5_to_10")
        {
            result = result.Where(x => x.Weight > 5.0m && x.Weight <= 10.0m);
        }
        else if (_weightFilter == "over_10")
        {
            result = result.Where(x => x.Weight > 10.0m);
        }

        if (_wageFilter == "low")
        {
            result = result.Where(x => GetEffectiveWage(x) < 10.0m);
        }
        else if (_wageFilter == "medium")
        {
            result = result.Where(x => GetEffectiveWage(x) >= 10.0m && GetEffectiveWage(x) <= 20.0m);
        }
        else if (_wageFilter == "high")
        {
            result = result.Where(x => GetEffectiveWage(x) > 20.0m);
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            result = result.Where(x => x.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                       x.Barcode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                       (x.CategoryTitle != null && x.CategoryTitle.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (_selectedAttributeFilters.Count > 0)
        {
            foreach (var (attrId, attrVal) in _selectedAttributeFilters)
            {
                result = result.Where(x => x.Attributes != null && x.Attributes.Any(a => a.AttributeId == attrId && a.Value.Equals(attrVal, StringComparison.OrdinalIgnoreCase)));
            }
        }

        // Keep "newest" faithful to its label: creation date is the primary key.
        // Availability is only a tie-breaker for products created at the same instant.
        result = _sortBy switch
        {
            "price_asc" => result.OrderByDescending(x => x.IsAvailable).ThenBy(x => x.EstimatedPrice),
            "price_desc" => result.OrderByDescending(x => x.IsAvailable).ThenByDescending(x => x.EstimatedPrice),
            "wage_asc" => result.OrderByDescending(x => x.IsAvailable).ThenBy(x => GetEffectiveWage(x)).ThenBy(x => x.WageAmount),
            "wage_desc" => result.OrderByDescending(x => x.IsAvailable).ThenByDescending(x => GetEffectiveWage(x)).ThenByDescending(x => x.WageAmount),
            "weight_asc" => result.OrderByDescending(x => x.IsAvailable).ThenBy(x => x.Weight),
            "weight_desc" => result.OrderByDescending(x => x.IsAvailable).ThenByDescending(x => x.Weight),
            _ => result.OrderByDescending(x => x.CreatedAt)
                .ThenByDescending(x => x.IsAvailable)
                .ThenByDescending(x => x.Id) // newest / default
        };

        return result.ToList();
    }

    private string GetCatalogJsonLd(string canonicalUrl, string storeName, string pageDesc)
    {
        var items = VisibleProducts.Take(12).Select((p, idx) => new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = idx + 1,
            ["url"] = Navigation.ToAbsoluteUri(GetProductUrl(p.Barcode)).ToString(),
            ["name"] = p.Name,
            ["image"] = !string.IsNullOrWhiteSpace(p.MainImageUrl) ? Navigation.ToAbsoluteUri(p.MainImageUrl).ToString() : null
        }).ToList();

        var jsonObject = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "CollectionPage",
            ["name"] = $"کاتالوگ طلا و جواهرات {storeName}",
            ["url"] = canonicalUrl,
            ["description"] = pageDesc,
            ["mainEntity"] = new Dictionary<string, object?>
            {
                ["@type"] = "ItemList",
                ["itemListElement"] = items
            }
        };

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }

    private string GetCatalogBreadcrumbJsonLd(string canonicalUrl, string storeName)
    {
        var jsonObject = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object>
                {
                    ["@type"] = "ListItem",
                    ["position"] = 1,
                    ["name"] = storeName,
                    ["item"] = Navigation.ToAbsoluteUri(HomeUrl).ToString()
                },
                new Dictionary<string, object>
                {
                    ["@type"] = "ListItem",
                    ["position"] = 2,
                    ["name"] = "کاتالوگ طلا و جواهرات",
                    ["item"] = canonicalUrl
                }
            }
        };

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
