                        <span>فقط طلا</span>
                    </div>
                    @if (_selectedProductType == ProductType.Gold)
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_selectedProductType == ProductType.Jewelry ? "active" : "")"
                        href="@(GetCatalogUrl("type", nameof(ProductType.Jewelry)))" data-vitrine-catalog-link>
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gem" style="font-size: 0.85rem; color: #0ea5e9;"></i>
                        <span>جواهرات نگین‌دار</span>
                    </div>
                    @if (_selectedProductType == ProductType.Jewelry)
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
            </div>
        </div>

        <!-- ویجت محدوده وزن -->
        <div class="sidebar-widget">
            <h3>محدوده وزن (گرم)</h3>
            <div class="filter-pills-vertical">
                <a class="filter-pill-btn @(_weightFilter == "all" ? "active" : "")"
                        href="@(GetCatalogUrl("weight", "all"))" data-vitrine-catalog-link>
                    <span>همه وزن‌ها</span>
                    @if (_weightFilter == "all")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_weightFilter == "under_2" ? "active" : "")"
                        href="@(GetCatalogUrl("weight", "under_2"))" data-vitrine-catalog-link>
                    <span>زیر ۲ گرم (سبک و اقتصادی)</span>
                    @if (_weightFilter == "under_2")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_weightFilter == "2_to_5" ? "active" : "")"
                        href="@(GetCatalogUrl("weight", "2_to_5"))" data-vitrine-catalog-link>
                    <span>۲ تا ۵ گرم</span>
                    @if (_weightFilter == "2_to_5")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_weightFilter == "5_to_10" ? "active" : "")"
                        href="@(GetCatalogUrl("weight", "5_to_10"))" data-vitrine-catalog-link>
                    <span>۵ تا ۱۰ گرم</span>
                    @if (_weightFilter == "5_to_10")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
                <a class="filter-pill-btn @(_weightFilter == "over_10" ? "active" : "")"
                        href="@(GetCatalogUrl("weight", "over_10"))" data-vitrine-catalog-link>
                    <span>بالای ۱۰ گرم (سنگین و مجلسی)</span>
                    @if (_weightFilter == "over_10")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </a>
