@page "/{StoreSlug}/catalog"
@page "/catalog"
@layout VitrineLayout
@attribute [AllowAnonymous]
@implements IDisposable

@using GoldEx.Shared.DTOs.Vitrine
@using GoldEx.Shared.Services.Abstractions
@using GoldEx.Shared.Enums
@using GoldEx.Shared.Routings
@inject IVitrineService VitrineService
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject IStoreContext StoreContext

<PageTitle>کاتالوگ و ویترین طلا و جواهرات - @(_storeInfo?.Name ?? "گالری طلا")</PageTitle>

<HeadContent>
    @{
        var canonicalUrl = StoreContext.IsCustomDomain 
            ? Navigation.ToAbsoluteUri("/catalog").ToString() 
            : Navigation.ToAbsoluteUri($"/{EffectiveStoreSlug}/catalog").ToString();
        var storeName = _storeInfo?.Name ?? "گالری طلا";
        var pageTitle = $"کاتالوگ طلا و جواهرات | {storeName}";
        var pageDesc = $"کاتالوگ رسمی طلا و جواهرات {storeName} با محاسبه آنلاین قیمت روز، مشاهده وزن، عیار ۷۵۰، فیلتر وزن و استعلام فوری کالاها.";
        var logoUrl = !string.IsNullOrWhiteSpace(_storeInfo?.LogoUrl) ? Navigation.ToAbsoluteUri(_storeInfo.LogoUrl).ToString() : null;
    }

    <link rel="canonical" href="@canonicalUrl" />
    <meta name="description" content="@pageDesc" />
    <meta name="keywords" content="@($"کاتالوگ طلا, محصولات طلا, {storeName}, خرید دستبند طلا, خرید انگشتر طلا, النگو طلا, گردنبند طلا, طلا 18 عیار")" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="@storeName" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDesc" />
    @if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        <meta property="og:image" content="@logoUrl" />
        <meta property="og:image:alt" content="@storeName" />
        <link rel="icon" type="image/png" href="@logoUrl" />
        <link rel="shortcut icon" href="@logoUrl" />
        <link rel="apple-touch-icon" href="@logoUrl" />
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDesc" />
    @if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        <meta name="twitter:image" content="@logoUrl" />
    }

    <!-- JSON-LD Structured Data: CollectionPage & BreadcrumbList -->
    <script type="application/ld+json">
    @((MarkupString)GetCatalogJsonLd(canonicalUrl, storeName, pageDesc))
    </script>
    <script type="application/ld+json">
    @((MarkupString)GetCatalogBreadcrumbJsonLd(canonicalUrl, storeName))
    </script>
</HeadContent>

<div class="vitrine-container" style="padding-top: 30px; padding-bottom: 70px;">
    <!-- Breadcrumb & Header -->
    <div style="margin-bottom: 24px;">
        <div class="d-flex align-items-center gap-2 mb-2" style="font-size: 0.86rem; color: var(--gray-600);">
            <a href="@HomeUrl" style="color: var(--primary-color); text-decoration: none;">صفحه اصلی</a>
            <i class="fa-solid fa-angle-left" style="font-size: 0.75rem;"></i>
            <span style="color: var(--accent-color); font-weight: 700;">کاتالوگ زیورآلات و طلا</span>
        </div>
        <h1 style="font-size: 2.2rem; font-weight: 900; margin: 0 0 6px; color: var(--primary-color);">
            ویترین <span style="color: var(--accent-color);">طلا و جواهرات</span>
        </h1>
        <p style="color: var(--gray-600); font-size: 0.96rem; margin: 0;">
            مشاهده تمام زیورآلات و طلاهای ساخته‌شده در گالری
        </p>
    </div>

    <!-- Mobile Filter Bar (< 992px) -->
    <div class="catalog-mobile-filter-bar">
        <button type="button" class="catalog-mobile-filter-btn" @onclick="OpenFilterDrawer">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders catalog-mobile-filter-icon"></i>
                <span class="catalog-mobile-filter-text">فیلترها و دسته‌بندی‌ها</span>
                @if (ActiveFiltersCount > 0)
                {
                    <span class="active-filter-badge">@ActiveFiltersCount</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2" style="font-size: 0.82rem; color: var(--gray-600);">
                <span>@FilteredProducts.Count کالا</span>
                <i class="fa-solid fa-angle-left" style="font-size: 0.72rem;"></i>
            </div>
        </button>

        @if (HasActiveFilters)
        {
            <div class="catalog-mobile-quick-pills">
                @if (_onlyAvailable)
                {
                    <button type="button" class="catalog-quick-pill active" @onclick="ToggleOnlyAvailable">
                        <i class="fa-solid fa-circle-check" style="font-size: 0.75rem;"></i>
                        <span>فقط موجود</span>
                        <i class="fa-solid fa-xmark remove-pill"></i>
                    </button>
                }
                @if (_onlyFeatured)
                {
                    <button type="button" class="catalog-quick-pill active" @onclick="ToggleOnlyFeatured">
                        <i class="fa-solid fa-star" style="font-size: 0.75rem;"></i>
                        <span>پیشنهادات ویژه</span>
                        <i class="fa-solid fa-xmark remove-pill"></i>
                    </button>
                }
                @if (_selectedCategoryId.HasValue)
                {
                    var activeCat = _categories.FirstOrDefault(c => c.Id == _selectedCategoryId.Value);
                    if (activeCat != null)
                    {
                        <button type="button" class="catalog-quick-pill active" @onclick="() => FilterByCategory(null)">
                            <span>@activeCat.Title</span>
                            <i class="fa-solid fa-xmark remove-pill"></i>
                        </button>
                    }
                }
                @if (_selectedProductType.HasValue)
                {
                    <button type="button" class="catalog-quick-pill active" @onclick="() => FilterByType(null)">
                        <span>@(_selectedProductType == ProductType.Gold ? "طلا" : "جواهرات")</span>
                        <i class="fa-solid fa-xmark remove-pill"></i>
                    </button>
                }
                @if (_weightFilter != "all")
                {
                    <button type="button" class="catalog-quick-pill active" @onclick='() => SetWeightFilter("all")'>
                        <span>@GetWeightFilterTitle(_weightFilter)</span>
                        <i class="fa-solid fa-xmark remove-pill"></i>
                    </button>
                }
                @foreach (var (attrId, attrVal) in _selectedAttributeFilters)
                {
                    var group = AvailableAttributeFacets.FirstOrDefault(g => g.AttributeId == attrId);
                    var title = group != null ? $"{group.Title}: {attrVal}" : attrVal;
                    <button type="button" class="catalog-quick-pill active" @onclick="() => SetAttributeFilter(attrId, null)">
                        <span>@title</span>
                        <i class="fa-solid fa-xmark remove-pill"></i>
                    </button>
                }
                <button type="button" class="catalog-quick-pill clear-all" @onclick="ResetFilters">
                    <span>حذف همه</span>
                </button>
            </div>
        }
    </div>

    <!-- Mobile Off-Canvas Filter Drawer -->
    <div class="catalog-drawer-backdrop @(_isFilterDrawerOpen ? "open" : "")" @onclick="CloseFilterDrawer"></div>

    <div class="catalog-filter-drawer @(_isFilterDrawerOpen ? "open" : "")" aria-hidden="@(!_isFilterDrawerOpen)">
        <div class="catalog-drawer-header">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders" style="color: var(--accent-color); font-size: 1.1rem;"></i>
                <span class="catalog-drawer-title">فیلترها و دسته‌بندی‌ها</span>
                @if (ActiveFiltersCount > 0)
                {
                    <span class="active-filter-badge">@ActiveFiltersCount</span>
                }
            </div>
            <button type="button" class="catalog-drawer-close" @onclick="CloseFilterDrawer" aria-label="بستن فیلترها">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="catalog-drawer-body">
            @FilterWidgetsContent
        </div>

        <div class="catalog-drawer-footer">
            <button type="button" class="btn-gisu btn-gisu-primary" style="width: 100%; justify-content: center; font-size: 0.92rem; padding: 12px;" @onclick="CloseFilterDrawer">
                <span>مشاهده محصولات (@FilteredProducts.Count کالا)</span>
            </button>
        </div>
    </div>

    <!-- Main Shop Layout: Sidebar Right, Products Left -->
    <main class="shop-layout">
        
        <!-- ۱. سایدبار فیلترها (Right Filter Sidebar - Desktop) -->
        <aside class="shop-sidebar">
            @FilterWidgetsContent
        </aside>

        <!-- ۲. بخش محصولات سمت چپ (Left Products Section) -->
        <section class="shop-products">
            
            <!-- نوار ابزار بالای محصولات -->
            <div class="shop-toolbar">
                <div style="font-size: 0.92rem; color: var(--gray-600); font-weight: 700;">
                    @if (FilteredProducts.Count > PageSize)
                    {
                        <span>نمایش <strong style="color: var(--primary-color); font-weight: 900; font-size: 1.05rem;">@Math.Min(_visibleCount, FilteredProducts.Count)</strong> از <strong style="color: var(--primary-color); font-weight: 900; font-size: 1.05rem;">@FilteredProducts.Count</strong> قطعه طلا و جواهر</span>
                    }
                    else
                    {
                        <span>نمایش <strong style="color: var(--primary-color); font-weight: 900; font-size: 1.05rem;">@FilteredProducts.Count</strong> قطعه طلا و جواهر</span>
                    }
                </div>

                <div class="sort-tabs-container">
                    <span style="font-size: 0.84rem; color: var(--gray-600); font-weight: 700; white-space: nowrap; flex-shrink: 0;">مرتب‌سازی:</span>
                    <div class="sort-tabs">
                        <button type="button" class="sort-tab @(_sortBy == "newest" ? "active" : "")" @onclick='() => SetSortBy("newest")'>
                            جدیدترین
                        </button>
                        <button type="button" class="sort-tab @(_sortBy == "price_asc" ? "active" : "")" @onclick='() => SetSortBy("price_asc")'>
                            ارزان‌ترین
                        </button>
                        <button type="button" class="sort-tab @(_sortBy == "price_desc" ? "active" : "")" @onclick='() => SetSortBy("price_desc")'>
                            گران‌ترین
                        </button>
                        <button type="button" class="sort-tab @(_sortBy == "weight_asc" ? "active" : "")" @onclick='() => SetSortBy("weight_asc")'>
                            سبک‌ترین
                        </button>
                        <button type="button" class="sort-tab @(_sortBy == "weight_desc" ? "active" : "")" @onclick='() => SetSortBy("weight_desc")'>
                            سنگین‌ترین
                        </button>
                    </div>
                </div>
            </div>

            <!-- وضعیت بارگذاری یا لیست خالی یا محصولات -->
            @if (_isLoading)
            {
                <div class="vitrine-grid animate-fade-in" style="padding-top: 0;">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="vitrine-card-skeleton">
                            <div class="skeleton-image skeleton-shimmer"></div>
                            <div class="skeleton-info">
                                <div class="skeleton-line short skeleton-shimmer"></div>
                                <div class="skeleton-line medium skeleton-shimmer"></div>
                                <div class="skeleton-line short skeleton-shimmer"></div>
                                <div class="skeleton-line price skeleton-shimmer mt-2"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (FilteredProducts.Count == 0)
            {
                <div class="text-center py-5 animate-fade-in" style="background: var(--white); border-radius: var(--border-radius-sm); border: 1px solid var(--gray-200); padding: 50px 20px; box-shadow: var(--shadow-subtle);">
                    <i class="fa-solid fa-magnifying-glass mb-3" style="font-size: 3rem; color: var(--accent-color); display: block;"></i>
                    <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--primary-color); margin-bottom: 8px;">موردی با مشخصات انتخابی یافت نشد</h3>
                    <p style="color: var(--gray-600); max-width: 450px; margin: 0 auto 24px; font-size: 0.92rem; line-height: 1.8;">
                        لطفاً فیلترهای اعمال‌شده، دسته‌بندی یا عبارت جستجو را تغییر دهید.
                    </p>
                    <button type="button" class="btn-gisu btn-gisu-outline" style="display: inline-flex;" @onclick="ResetFilters">
                        <span>نمایش تمام محصولات</span>
                    </button>
                </div>
            }
            else
            {
                <div class="vitrine-grid animate-fade-in" style="padding-top: 0;">
                    @foreach (var product in VisibleProducts)
                    {
                        <a href="@GetProductUrl(product.Barcode)" class="product-card @(!product.IsAvailable ? "is-sold" : "")">
                            <div class="product-image">
                                @if (!product.IsAvailable)
                                {
                                    <span class="product-badge badge-sold">فروخته شد</span>
                                    <span class="product-badge badge-top-left">عیار @(product.Fineness > 0 ? product.Fineness.ToString("G29") : "750")</span>
                                    <span class="product-badge badge-bottom-right">@(product.Weight.ToString("G29")) گرم</span>
                                    @if (product.IsFeatured)
                                    {
                                        <span class="product-badge badge-featured">⭐ ویژه</span>
                                    }
                                }
                                else
                                {
                                    <span class="product-badge badge-top-right">@(product.Weight.ToString("G29")) گرم</span>
                                    <span class="product-badge badge-top-left">عیار @(product.Fineness > 0 ? product.Fineness.ToString("G29") : "750")</span>
                                    @if (product.IsFeatured)
                                    {
                                        <span class="product-badge badge-featured">⭐ ویژه</span>
                                    }
                                    else if (product.ProductType == ProductType.Jewelry)
                                    {
                                        <span class="product-badge badge-bottom-left">💎 جواهر</span>
                                    }
                                }

                                @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                                {
                                    <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--gray-400);">
                                        <i class="fa-solid fa-gem" style="font-size: 3rem; color: var(--accent-color); margin-bottom: 8px;"></i>
                                        <span style="font-size: 0.78rem; color: var(--gray-600);">گالری طلا</span>
                                    </div>
                                }
                            </div>

                            <div class="product-info">
                                <span class="product-category">@(!string.IsNullOrEmpty(product.CategoryTitle) ? product.CategoryTitle : "زیورآلات طلا")</span>

                                <h3 class="product-title" title="@product.Name">@product.Name</h3>

                                <div class="product-price-container">
                                    <span class="product-price-label">مبلغ با مظنه روز:</span>
                                    <div class="product-price">
                                        @product.EstimatedPrice.ToString("N0") <small style="font-size: 0.75rem; font-weight: normal; color: var(--gray-600);">تومان</small>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }

                    @if (_isLoadingMore)
                    {
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="vitrine-card-skeleton animate-fade-in">
                                <div class="skeleton-image skeleton-shimmer"></div>
                                <div class="skeleton-info">
                                    <div class="skeleton-line short skeleton-shimmer"></div>
                                    <div class="skeleton-line medium skeleton-shimmer"></div>
                                    <div class="skeleton-line price skeleton-shimmer mt-2"></div>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (_visibleCount < FilteredProducts.Count)
                {
                    <div class="text-center mt-5 mb-4 animate-fade-in">
                        <button type="button" class="btn-gisu btn-gisu-primary btn-load-more" @onclick="LoadMoreAsync" disabled="@_isLoadingMore">
                            @if (_isLoadingMore)
                            {
                                <i class="fa-solid fa-spinner fa-spin ms-2"></i>
                                <span>در حال بارگذاری موارد بیشتر...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-arrow-down-long ms-2"></i>
                                <span>نمایش @(Math.Min(PageSize, FilteredProducts.Count - _visibleCount)) محصول دیگر (@Math.Min(_visibleCount, FilteredProducts.Count) از @FilteredProducts.Count)</span>
                            }
                        </button>
                    </div>
                }
                else if (FilteredProducts.Count > PageSize)
                {
                    <div class="vitrine-end-indicator animate-fade-in">
                        <i class="fa-solid fa-circle-check" style="color: #10b981; font-size: 1.1rem;"></i>
                        <span>تمامی @FilteredProducts.Count محصول با مشخصات انتخابی نمایش داده شده است</span>
                    </div>
                }
            }

        </section>

    </main>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? CategoryId { get; set; }
    [SupplyParameterFromQuery] public bool? OnlyFeatured { get; set; }
    [SupplyParameterFromQuery] public bool? OnlyAvailable { get; set; }
    [CascadingParameter] private VitrineStoreInfoDto? _storeInfo { get; set; }

    private const int PageSize = 24;
    private int _visibleCount = PageSize;
    private bool _isLoadingMore = false;

    private List<VitrineProductSummaryDto> _products = [];
    private List<VitrineCategoryDto> _categories = [];
    private Guid? _selectedCategoryId;
    private ProductType? _selectedProductType;
    private bool _onlyFeatured;
    private bool _onlyAvailable;
    private bool _isFilterDrawerOpen;
    private string _weightFilter = "all";
    private string _searchTerm = "";
    private string _sortBy = "newest";
    private bool _isLoading = true;
    private Dictionary<Guid, string> _selectedAttributeFilters = new();

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ResetVisibleCount();
            }
        }
    }

    private PersistingComponentStateSubscription _persistingSubscription;

    private RenderFragment FilterWidgetsContent => @<text>
        <!-- ویجت جستجو -->
        <div class="sidebar-widget">
            <h3>جستجوی زیورآلات</h3>
            <div class="search-box">
                <input type="text"
                       @bind="SearchTerm"
                       @bind:event="oninput"
                       placeholder="نام مدل، دسته‌بندی، بارکد..."
                       class="luxury-search-input" />
                <span class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></span>
            </div>
        </div>

        <!-- ویجت وضعیت و دسترسی -->
        <div class="sidebar-widget">
            <h3>وضعیت و دسترسی</h3>
            <div class="filter-pills-vertical">
                <button type="button" class="filter-pill-btn filter-toggle-pill @(_onlyAvailable ? "active" : "")"
                        @onclick="ToggleOnlyAvailable">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check" style="font-size: 0.9rem; color: @(_onlyAvailable ? "var(--accent-color)" : "#10b981");"></i>
                        <span>فقط اجناس موجود</span>
                    </div>
                    <div class="luxury-switch-indicator @(_onlyAvailable ? "checked" : "")">
                        <span class="luxury-switch-thumb"></span>
                    </div>
                </button>
                <button type="button" class="filter-pill-btn filter-toggle-pill @(_onlyFeatured ? "active" : "")"
                        @onclick="ToggleOnlyFeatured">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-star" style="font-size: 0.9rem; color: @(_onlyFeatured ? "var(--accent-color)" : "#eab308");"></i>
                        <span>پیشنهادات ویژه</span>
                    </div>
                    <div class="luxury-switch-indicator @(_onlyFeatured ? "checked" : "")">
                        <span class="luxury-switch-thumb"></span>
                    </div>
                </button>
            </div>
        </div>

        <!-- ویجت دسته‌بندی‌های گالری -->
        @if (_categories.Count > 0)
        {
            <div class="sidebar-widget">
                <h3>دسته‌بندی‌های گالری</h3>
                <div class="category-chips-list">
                    <div class="category-chip-item @(_selectedCategoryId == null ? "active" : "")"
                         @onclick="() => FilterByCategory(null)">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-gem" style="font-size: 0.85rem; color: var(--accent-color);"></i>
                            <span>همه دسته‌ها</span>
                        </div>
                        <span class="chip-badge">@_products.Count</span>
                    </div>
                    @foreach (var cat in _categories)
                    {
                        <div class="category-chip-item @(_selectedCategoryId == cat.Id ? "active" : "")"
                             @onclick="() => FilterByCategory(cat.Id)">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-sparkles" style="font-size: 0.8rem; opacity: 0.7;"></i>
                                <span>@cat.Title</span>
                            </div>
                            <span class="chip-badge">@cat.ProductCount</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ویجت نوع کالا -->
        <div class="sidebar-widget">
            <h3>نوع زیورآلات</h3>
            <div class="filter-pills-vertical">
                <button type="button" class="filter-pill-btn @(_selectedProductType == null ? "active" : "")"
                        @onclick="() => FilterByType(null)">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-layer-group" style="font-size: 0.85rem;"></i>
                        <span>همه انواع</span>
                    </div>
                    @if (_selectedProductType == null)
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
                <button type="button" class="filter-pill-btn @(_selectedProductType == ProductType.Gold ? "active" : "")"
                        @onclick="() => FilterByType(ProductType.Gold)">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-ring" style="font-size: 0.85rem; color: var(--accent-color);"></i>
                        <span>فقط طلا</span>
                    </div>
                    @if (_selectedProductType == ProductType.Gold)
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
                <button type="button" class="filter-pill-btn @(_selectedProductType == ProductType.Jewelry ? "active" : "")"
                        @onclick="() => FilterByType(ProductType.Jewelry)">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-gem" style="font-size: 0.85rem; color: #0ea5e9;"></i>
                        <span>جواهرات نگین‌دار</span>
                    </div>
                    @if (_selectedProductType == ProductType.Jewelry)
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
            </div>
        </div>

        <!-- ویجت محدوده وزن -->
        <div class="sidebar-widget">
            <h3>محدوده وزن (گرم)</h3>
            <div class="filter-pills-vertical">
                <button type="button" class="filter-pill-btn @(_weightFilter == "all" ? "active" : "")"
                        @onclick='() => SetWeightFilter("all")'>
                    <span>همه وزن‌ها</span>
                    @if (_weightFilter == "all")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
                <button type="button" class="filter-pill-btn @(_weightFilter == "under_2" ? "active" : "")"
                        @onclick='() => SetWeightFilter("under_2")'>
                    <span>زیر ۲ گرم (سبک و اقتصادی)</span>
                    @if (_weightFilter == "under_2")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
                <button type="button" class="filter-pill-btn @(_weightFilter == "2_to_5" ? "active" : "")"
                        @onclick='() => SetWeightFilter("2_to_5")'>
                    <span>۲ تا ۵ گرم</span>
                    @if (_weightFilter == "2_to_5")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
                <button type="button" class="filter-pill-btn @(_weightFilter == "5_to_10" ? "active" : "")"
                        @onclick='() => SetWeightFilter("5_to_10")'>
                    <span>۵ تا ۱۰ گرم</span>
                    @if (_weightFilter == "5_to_10")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
                <button type="button" class="filter-pill-btn @(_weightFilter == "over_10" ? "active" : "")"
                        @onclick='() => SetWeightFilter("over_10")'>
                    <span>بالای ۱۰ گرم (سنگین و مجلسی)</span>
                    @if (_weightFilter == "over_10")
                    {
                        <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                    }
                </button>
            </div>
        </div>

        <!-- ویجت‌های ویژگی‌های توصیفی پویا (آکاردئونی و باز و بسته‌شونده) -->
        @foreach (var group in AvailableAttributeFacets)
        {
            var isExpanded = IsAttributeWidgetExpanded(group.AttributeId);
            var hasActiveFilter = _selectedAttributeFilters.ContainsKey(group.AttributeId);

            <div class="sidebar-widget">
                <h3 class="widget-collapsible @(isExpanded ? "expanded" : "")" @onclick="() => ToggleAttributeWidget(group.AttributeId)">
                    <div class="d-flex align-items-center gap-2">
                        <span>@group.Title @(!string.IsNullOrWhiteSpace(group.Unit) ? $"({group.Unit})" : "")</span>
                        @if (hasActiveFilter)
                        {
                            <span class="active-facet-dot"></span>
                        }
                    </div>
                    <i class="fa-solid fa-chevron-down widget-toggle-icon @(isExpanded ? "rotated" : "")"></i>
                </h3>

                @if (isExpanded)
                {
                    <div class="filter-pills-vertical animate-fade-in" style="margin-top: 10px;">
                        <button type="button" class="filter-pill-btn @(!_selectedAttributeFilters.ContainsKey(group.AttributeId) ? "active" : "")"
                                @onclick="() => SetAttributeFilter(group.AttributeId, null)">
                            <span>همه</span>
                            @if (!_selectedAttributeFilters.ContainsKey(group.AttributeId))
                            {
                                <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                            }
                        </button>
                        @foreach (var val in group.Values)
                        {
                            var isSelected = _selectedAttributeFilters.TryGetValue(group.AttributeId, out var currentVal) && currentVal.Equals(val, StringComparison.OrdinalIgnoreCase);
                            <button type="button" class="filter-pill-btn @(isSelected ? "active" : "")"
                                    @onclick="() => SetAttributeFilter(group.AttributeId, val)">
                                <span>@val</span>
                                @if (isSelected)
                                {
                                    <i class="fa-solid fa-check" style="font-size: 0.8rem;"></i>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }

        <!-- دکمه پاک کردن فیلترها -->
        @if (HasActiveFilters)
        {
            <button type="button" class="btn-gisu btn-gisu-outline" style="width: 100%; justify-content: center; font-size: 0.86rem;" @onclick="ResetFilters">
                <i class="fa-solid fa-rotate-left"></i>
                <span>حذف تمام فیلترها (@ActiveFiltersCount)</span>
            </button>
        }
    </text>;

    [Parameter] public string? StoreSlug { get; set; }

    private string EffectiveStoreSlug => !string.IsNullOrWhiteSpace(StoreSlug)
        ? StoreSlug
        : (!string.IsNullOrWhiteSpace(_storeInfo?.Slug) 
            ? _storeInfo.Slug 
            : (!string.IsNullOrWhiteSpace(StoreContext.StoreSlug) ? StoreContext.StoreSlug : ""));

    private string HomeUrl => StoreContext.IsCustomDomain ? "/" : $"/{EffectiveStoreSlug}";

    private string GetProductUrl(string barcode) => StoreContext.IsCustomDomain
        ? $"/p/{barcode}"
        : $"/{EffectiveStoreSlug}/p/{barcode}";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        _selectedCategoryId = CategoryId;
        _onlyFeatured = OnlyFeatured ?? false;
        _onlyAvailable = OnlyAvailable ?? false;
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistCatalogData);

        var restoredCategories = ApplicationState.TryTakeFromJson<List<VitrineCategoryDto>>("vitrine_catalog_categories", out var catRestored) && catRestored != null
            ? catRestored
            : (!string.IsNullOrWhiteSpace(EffectiveStoreSlug) && ApplicationState.TryTakeFromJson<List<VitrineCategoryDto>>($"vitrine_catalog_categories_{EffectiveStoreSlug}", out catRestored) && catRestored != null ? catRestored : null);

        var restoredProducts = ApplicationState.TryTakeFromJson<List<VitrineProductSummaryDto>>("vitrine_catalog_products", out var prodRestored) && prodRestored != null
            ? prodRestored
            : (!string.IsNullOrWhiteSpace(EffectiveStoreSlug) && ApplicationState.TryTakeFromJson<List<VitrineProductSummaryDto>>($"vitrine_catalog_products_{EffectiveStoreSlug}", out prodRestored) && prodRestored != null ? prodRestored : null);

        if (restoredCategories != null && restoredProducts != null)
        {
            _categories = restoredCategories;
            _products = restoredProducts;
            ResetVisibleCount();
            _isLoading = false;
        }
        else
        {
            await LoadDataAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(StoreSlug) && ClientRoutes.Vitrine.IsReservedSegment(StoreSlug))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        _selectedCategoryId = CategoryId;
        _onlyFeatured = OnlyFeatured ?? false;
        _onlyAvailable = OnlyAvailable ?? false;

        if (_products.Count == 0 && !_isLoading)
        {
            await LoadDataAsync();
        }
    }

    private Task PersistCatalogData()
    {
        if (_categories != null && _categories.Count > 0)
        {
            ApplicationState.PersistAsJson("vitrine_catalog_categories", _categories);
            if (!string.IsNullOrWhiteSpace(EffectiveStoreSlug))
            {
                ApplicationState.PersistAsJson($"vitrine_catalog_categories_{EffectiveStoreSlug}", _categories);
            }
        }
        if (_products != null && _products.Count > 0)
        {
            ApplicationState.PersistAsJson("vitrine_catalog_products", _products);
            if (!string.IsNullOrWhiteSpace(EffectiveStoreSlug))
            {
                ApplicationState.PersistAsJson($"vitrine_catalog_products_{EffectiveStoreSlug}", _products);
            }
        }
        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _categories = (await VitrineService.GetCategoriesAsync(EffectiveStoreSlug)).ToList();
            _products = (await VitrineService.GetVitrineProductsAsync(EffectiveStoreSlug)).ToList();
            ResetVisibleCount();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _persistingSubscription.Dispose();
    }

    private void ResetVisibleCount()
    {
        _visibleCount = PageSize;
    }

    private async Task LoadMoreAsync()
    {
        if (_isLoadingMore) return;
        _isLoadingMore = true;
        StateHasChanged();
        await Task.Delay(250); // Gentle feedback
        _visibleCount += PageSize;
        _isLoadingMore = false;
        StateHasChanged();
    }

    private void OpenFilterDrawer()
    {
        _isFilterDrawerOpen = true;
    }

    private void CloseFilterDrawer()
    {
        _isFilterDrawerOpen = false;
    }

    private void ToggleOnlyAvailable()
    {
        _onlyAvailable = !_onlyAvailable;
        ResetVisibleCount();
    }

    private void ToggleOnlyFeatured()
    {
        _onlyFeatured = !_onlyFeatured;
        ResetVisibleCount();
    }

    private void FilterByCategory(Guid? categoryId)
    {
        _selectedCategoryId = categoryId;
        ResetVisibleCount();
    }

    private void FilterByType(ProductType? type)
    {
        _selectedProductType = type;
        ResetVisibleCount();
    }

    private void SetWeightFilter(string filter)
    {
        _weightFilter = filter;
        ResetVisibleCount();
    }

    private void SetSortBy(string sort)
    {
        _sortBy = sort;
        ResetVisibleCount();
    }

    private readonly HashSet<Guid> _expandedAttributeWidgets = new();

    private void ToggleAttributeWidget(Guid attributeId)
    {
        if (!_expandedAttributeWidgets.Add(attributeId))
        {
            _expandedAttributeWidgets.Remove(attributeId);
        }
    }

    private bool IsAttributeWidgetExpanded(Guid attributeId)
    {
        return _selectedAttributeFilters.ContainsKey(attributeId) || _expandedAttributeWidgets.Contains(attributeId);
    }

    private void SetAttributeFilter(Guid attributeId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _selectedAttributeFilters.Remove(attributeId);
        }
        else
        {
            _selectedAttributeFilters[attributeId] = value;
            _expandedAttributeWidgets.Add(attributeId);
        }
        ResetVisibleCount();
    }

    private void ResetFilters()
    {
        _selectedCategoryId = null;
        _selectedProductType = null;
        _onlyFeatured = false;
        _onlyAvailable = false;
        _weightFilter = "all";
        _searchTerm = "";
        _sortBy = "newest";
        _selectedAttributeFilters.Clear();
        ResetVisibleCount();
    }

    public record AttributeFacetGroup(Guid AttributeId, string Title, string? Unit, List<string> Values);

    private List<AttributeFacetGroup> AvailableAttributeFacets
    {
        get
        {
            var baseProducts = _products.AsEnumerable();
            if (_selectedCategoryId.HasValue)
            {
                baseProducts = baseProducts.Where(p => p.CategoryId == _selectedCategoryId.Value);
            }

            var allAttrs = baseProducts
                .SelectMany(p => p.Attributes ?? Enumerable.Empty<VitrineAttributeValueDto>())
                .Where(a => !string.IsNullOrWhiteSpace(a.Value))
                .GroupBy(a => new { a.AttributeId, a.Title, a.Unit, a.DisplayOrder })
                .OrderBy(g => g.Key.DisplayOrder)
                .ThenBy(g => g.Key.Title)
                .Select(g => new AttributeFacetGroup(
                    g.Key.AttributeId,
                    g.Key.Title,
                    g.Key.Unit,
                    g.Select(x => x.Value.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList()
                ))
                .Where(g => g.Values.Count > 0)
                .ToList();

            return allAttrs;
        }
    }

    private string GetWeightFilterTitle(string weight) => weight switch
    {
        "under_2" => "زیر ۲ گرم",
        "2_to_5" => "۲ تا ۵ گرم",
        "5_to_10" => "۵ تا ۱۰ گرم",
        "over_10" => "بالای ۱۰ گرم",
        _ => "همه وزن‌ها"
    };

    private int ActiveFiltersCount
    {
        get
        {
            int count = 0;
            if (_selectedCategoryId.HasValue) count++;
            if (_selectedProductType.HasValue) count++;
            if (_onlyFeatured) count++;
            if (_onlyAvailable) count++;
            if (_weightFilter != "all") count++;
            if (!string.IsNullOrWhiteSpace(_searchTerm)) count++;
            count += _selectedAttributeFilters.Count;
            return count;
        }
    }

    private bool HasActiveFilters => ActiveFiltersCount > 0;

    private IEnumerable<VitrineProductSummaryDto> VisibleProducts => FilteredProducts.Take(_visibleCount);

    private List<VitrineProductSummaryDto> FilteredProducts
    {
        get
        {
            var result = _products.AsEnumerable();

            if (_onlyAvailable)
            {
                result = result.Where(x => x.IsAvailable);
            }

            if (_selectedCategoryId.HasValue)
            {
                result = result.Where(x => x.CategoryId == _selectedCategoryId.Value);
            }

            if (_selectedProductType.HasValue)
            {
                result = result.Where(x => x.ProductType == _selectedProductType.Value);
            }

            if (_onlyFeatured)
            {
                result = result.Where(x => x.IsFeatured);
            }

            if (_weightFilter == "under_2")
            {
                result = result.Where(x => x.Weight < 2.0m);
            }
            else if (_weightFilter == "2_to_5")
            {
                result = result.Where(x => x.Weight >= 2.0m && x.Weight <= 5.0m);
            }
            else if (_weightFilter == "5_to_10")
            {
                result = result.Where(x => x.Weight > 5.0m && x.Weight <= 10.0m);
            }
            else if (_weightFilter == "over_10")
            {
                result = result.Where(x => x.Weight > 10.0m);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                result = result.Where(x => x.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                           x.Barcode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                           (x.CategoryTitle != null && x.CategoryTitle.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (_selectedAttributeFilters.Count > 0)
            {
                foreach (var (attrId, attrVal) in _selectedAttributeFilters)
                {
                    result = result.Where(x => x.Attributes != null && x.Attributes.Any(a => a.AttributeId == attrId && a.Value.Equals(attrVal, StringComparison.OrdinalIgnoreCase)));
                }
            }

            // Sorting: Always prioritize in-stock items (IsAvailable == true) first, then apply chosen sort order
            result = _sortBy switch
            {
                "price_asc" => result.OrderByDescending(x => x.IsAvailable).ThenBy(x => x.EstimatedPrice),
                "price_desc" => result.OrderByDescending(x => x.IsAvailable).ThenByDescending(x => x.EstimatedPrice),
                "weight_asc" => result.OrderByDescending(x => x.IsAvailable).ThenBy(x => x.Weight),
                "weight_desc" => result.OrderByDescending(x => x.IsAvailable).ThenByDescending(x => x.Weight),
                _ => result.OrderByDescending(x => x.IsAvailable) // newest / default
            };

            return result.ToList();
        }
    }

    private string GetCatalogJsonLd(string canonicalUrl, string storeName, string pageDesc)
    {
        var items = VisibleProducts.Take(12).Select((p, idx) => new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = idx + 1,
            ["url"] = Navigation.ToAbsoluteUri(GetProductUrl(p.Barcode)).ToString(),
            ["name"] = p.Name,
            ["image"] = !string.IsNullOrWhiteSpace(p.MainImageUrl) ? Navigation.ToAbsoluteUri(p.MainImageUrl).ToString() : null
        }).ToList();

        var jsonObject = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "CollectionPage",
            ["name"] = $"کاتالوگ طلا و جواهرات {storeName}",
            ["url"] = canonicalUrl,
            ["description"] = pageDesc,
            ["mainEntity"] = new Dictionary<string, object?>
            {
                ["@type"] = "ItemList",
                ["itemListElement"] = items
            }
        };

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }

    private string GetCatalogBreadcrumbJsonLd(string canonicalUrl, string storeName)
    {
        var jsonObject = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object>
                {
                    ["@type"] = "ListItem",
                    ["position"] = 1,
                    ["name"] = storeName,
                    ["item"] = Navigation.ToAbsoluteUri(HomeUrl).ToString()
                },
                new Dictionary<string, object>
                {
                    ["@type"] = "ListItem",
                    ["position"] = 2,
                    ["name"] = "کاتالوگ طلا و جواهرات",
                    ["item"] = canonicalUrl
                }
            }
        };

        return System.Text.Json.JsonSerializer.Serialize(jsonObject, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
}
