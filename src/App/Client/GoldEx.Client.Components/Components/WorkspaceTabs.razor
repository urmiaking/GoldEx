@using GoldEx.Client.Components.Layouts.Components
@typeparam TKey where TKey : notnull
@implements IAsyncDisposable
@inject IJSRuntime JS

<section @ref="_workspace" class="gex-calculator-workspace @Class" aria-label="@Label">
    <div class="gex-calculator-tabbar" dir="ltr">
        <button type="button" class="gex-calculator-scroll gex-calculator-scroll-left" data-tab-scroll="left"
                aria-label="نمایش تب‌های سمت چپ" hidden disabled><ShellIcon Name="chevron-left" /></button>
        <div class="gex-calculator-tab-viewport" dir="rtl">
            <div class="gex-calculator-tab-track" role="tablist" aria-label="@Label" aria-orientation="horizontal">
                @foreach (var tab in Tabs)
                {
                    var active = IsActive(tab.Key);
                    <button @key="tab.Key" type="button" role="tab" id="@TabId(tab.Key)" aria-controls="@PanelId(tab.Key)"
                            aria-selected="@(active ? "true" : "false")" tabindex="@(active ? 0 : -1)"
                            class="gex-calculator-tab @(active ? "is-active" : null)" @onclick="() => ActivateAsync(tab.Key)">
                        <ShellIcon Name="@tab.Icon" /><span>@tab.Title</span>
                    </button>
                }
            </div>
        </div>
        <button type="button" class="gex-calculator-scroll gex-calculator-scroll-right" data-tab-scroll="right"
                aria-label="نمایش تب‌های سمت راست" hidden disabled><ShellIcon Name="chevron-right" /></button>
    </div>
    @ContextContent
    <div class="gex-calculator-panels">
        @foreach (var tab in Tabs)
        {
            var active = IsActive(tab.Key);
            <section @key="tab.Key" role="tabpanel" id="@PanelId(tab.Key)" aria-labelledby="@TabId(tab.Key)" tabindex="0" hidden="@(!active)">
                @if (active)
                {
                    @PanelContent(tab.Key)
                }
            </section>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<WorkspaceTab<TKey>> Tabs { get; set; } = [];
    [Parameter, EditorRequired] public TKey ActiveKey { get; set; } = default!;
    [Parameter] public EventCallback<TKey> ActiveKeyChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ContextContent { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TKey> PanelContent { get; set; } = default!;

    private readonly string _id = $"gex-tabs-{Guid.NewGuid():N}";
    private ElementReference _workspace;
    private Task? _initialization;
    private IJSObjectReference? _module, _binding;
    private bool _disposed;

    private string TabId(TKey key) => $"{_id}-tab-{key}";
    private string PanelId(TKey key) => $"{_id}-panel-{key}";
    private bool IsActive(TKey key) => EqualityComparer<TKey>.Default.Equals(key, ActiveKey);
    private Task ActivateAsync(TKey key) => IsActive(key) ? Task.CompletedTask : ActiveKeyChanged.InvokeAsync(key);

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? _initialization = BindAsync() : Task.CompletedTask;

    private async Task BindAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GoldEx.Client.Components/js/calculator-tabs.js");
            if (!_disposed)
                _binding = await _module.InvokeAsync<IJSObjectReference>("bind", _workspace);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_initialization is not null)
                await _initialization;
            if (_binding is not null)
            {
                await _binding.InvokeVoidAsync("dispose");
                await _binding.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
