@using GoldEx.Shared.Services.Abstractions
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@implements IDisposable
@inject IStoreContext StoreContext
@inject GoldEx.Client.Components.Services.Abstractions.IThemeService ThemeService
@inject ISnackbar ToastService
@inject IJSRuntime JSRuntime

@if (StoreContext.IsCustomDomain)
{
    @Body
}
else
{
    <PageTitle>گلدکس</PageTitle>
    <MudRTLProvider RightToLeft="true">
        <MudThemeProvider Theme="@ThemeService.CurrentTheme" IsDarkMode="@ThemeService.IsDarkMode" ObserveSystemDarkModeChange="false" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />
        @Body
        <div id="blazor-error-ui" data-nosnippet>
            خطایی در حین اجرای برنامه رخ داد
            <a href="." class="reload">بارگیری مجدد</a>
            <span class="dismiss">🗙</span>
        </div>
    </MudRTLProvider>
}

@code {
    private static ISnackbar? _staticToastService;
    private TaskCompletionSource? _appearanceRendered;

    protected override async Task OnInitializedAsync()
    {
        _staticToastService = ToastService;
        if (!StoreContext.IsCustomDomain)
        {
            await ThemeService.LoadSettingsAsync();
            ThemeService.OnAppearanceChanged += RenderAppearanceAsync;
        }
        await base.OnInitializedAsync();
    }

    private async Task RenderAppearanceAsync()
    {
        var rendered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _appearanceRendered = rendered;
        await InvokeAsync(StateHasChanged);
        await rendered.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _appearanceRendered?.TrySetResult();
        _appearanceRendered = null;
        if (firstRender && !StoreContext.IsCustomDomain)
        {
            try { await ThemeService.SyncBrowserAsync(); }
            catch (JSException) { /* Browser metadata must not prevent the app from starting. */ }
            try { await JSRuntime.InvokeVoidAsync("GoldEx.removeSplash"); }
            catch (JSException) { }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
        ThemeService.OnAppearanceChanged -= RenderAppearanceAsync;
        _appearanceRendered?.TrySetResult();
    }

    [JSInvokable]
    public static Task OnServiceWorkerInstalling()
    {
        _staticToastService?.Add("در حال بروز رسانی و نصب نسخه جدید ...", Severity.Info);
        return Task.CompletedTask;
    }
}
