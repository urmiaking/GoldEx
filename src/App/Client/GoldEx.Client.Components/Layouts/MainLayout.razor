@using GoldEx.Client.Components.Services
@using GoldEx.Shared.DTOs.Licenses
@using GoldEx.Shared.Services.Abstractions
@using Microsoft.JSInterop

@inherits LayoutComponentBase
@implements IDisposable
@layout BaseLayout

@inject IStoreContext StoreContext
@inject NavigationManager Navigation

@if (StoreContext.IsCustomDomain)
{
    @Body
}
else
{
    <div class="goldex-shell" dir="rtl">
        <a class="gex-skip-link" href="#gex-main-content">رفتن به محتوای اصلی</a>
        <Drawer @ref="_navigation" @bind-IsDrawerOpen="_drawerOpen" />
        <div class="gex-workspace">
            <AppBar @bind-DrawerOpen="_drawerOpen" NotificationCount="_unreadCount" OnNotificationsRequested="OpenNotificationsAsync" />
            <main id="gex-main-content" class="goldex-main-content" tabindex="-1">
                <div class="goldex-page-container page-transition">@Body</div>
            </main>
        </div>
        <MobileNav />
        <PalettePicker />
        <AuthorizeView Roles="Administrators,Owners">
            <Notifications @ref="_notifications" ShowTrigger="false" UnreadCountChanged="@((int count) => _unreadCount = count)" />
        </AuthorizeView>
    </div>
}

@code
{
    private bool _drawerOpen;
    private int _unreadCount;
    private Drawer? _navigation;
    private Notifications? _notifications;
    private GetLicenseResponse? _license;

    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;
    [Inject] private ILicenseService LicenceService { get; set; } = default!;
    [Inject] private LicenseState LicenseState { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!StoreContext.IsCustomDomain)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("removeLoadingIndicator");
            }
            catch
            {
                // ignore
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        if (!StoreContext.IsCustomDomain)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity?.IsAuthenticated == true) 
                await GetLicenseAsync();
        }

        await base.OnInitializedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_drawerOpen)
        {
            _drawerOpen = false;
        }
        _ = InvokeAsync(async () => { if (_notifications is not null) await _notifications.CloseAsync(); StateHasChanged(); });
    }

    private async Task OpenNotificationsAsync()
    {
        if (_navigation is not null) await _navigation.CloseAsync();
        if (_notifications is not null) await _notifications.OpenAsync();
    }

    private async Task GetLicenseAsync()
    {
        _license = await LicenceService.GetLicenseAsync();
        LicenseState.Set(_license);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
