<section class="gex-notification-list" aria-label="اعلان‌های خوانده‌نشده" aria-live="polite" aria-busy="@Busy.ToString().ToLowerInvariant()">
    @if (Items.Count == 0)
    {
        <div class="gex-notification-empty">
            <span><ShellIcon Name="check-circle" /></span>
            <p>اعلان خوانده‌نشده‌ای ندارید.</p>
        </div>
    }
    @foreach (var notification in Items)
    {
        <button type="button"
                @key="notification.Id"
                class="gex-notification-item"
                disabled="@Busy"
                aria-label="@($"مشاهده اعلان: {notification.Title}")"
                @onclick="() => OnOpen.InvokeAsync(notification)">
            <span class="gex-notification-item-icon" aria-hidden="true">
                <ShellIcon Name="@(notification.InvoiceId.HasValue ? "file" : "bell")" />
            </span>
            <span class="gex-notification-item-content">
                <span class="gex-notification-item-title">
                    <span>@notification.Title</span>
                    <span class="gex-notification-unread-dot" aria-hidden="true"></span>
                </span>
                <span class="gex-notification-item-preview">@notification.Message</span>
                <time class="gex-notification-item-time" datetime="@notification.CreatedAt.ToString("O")">@notification.CreatedAt.ToString("yyyy/MM/dd · HH:mm")</time>
            </span>
            <span class="gex-notification-item-chevron" aria-hidden="true"><ShellIcon Name="chevron-left" /></span>
        </button>
    }
</section>
