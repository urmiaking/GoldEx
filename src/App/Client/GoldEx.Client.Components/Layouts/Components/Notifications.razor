@inherits GoldExComponentBase

<dialog @ref="_panel" class="gex-notifications" aria-labelledby="gex-notification-title" dir="rtl">
    <header class="gex-notification-heading">
        <div class="gex-notification-heading-title">
            <span class="gex-notification-symbol"><ShellIcon Name="bell" /></span>
            <h2 id="gex-notification-title">اعلان‌ها</h2>
            @if (_unreadCount > 0)
            {
                <span class="gex-notification-unread-count" aria-label="@($"{_unreadCount} اعلان خوانده‌نشده")">@_unreadCount</span>
            }
        </div>
        <div class="gex-notification-heading-actions">
            @if (_unreadCount > 0)
            {
                <button type="button" class="gex-notification-mark-all" disabled="@_working" @onclick="HandleMarkAllAsRead">
                    خواندن همه
                </button>
            }
            <button type="button" class="gex-icon-button" data-notification-close aria-label="بستن اعلان‌ها" autofocus>
                <ShellIcon Name="close" />
            </button>
        </div>
    </header>

    @if (_pushState.Supported && _pushConfiguration.Enabled && !_pushState.Subscribed && _pushState.Permission != "denied")
    {
        <div class="gex-notification-enable">
            <span>اعلان روی دستگاه</span>
            <button type="button" class="gex-notification-enable-button" disabled="@_working" @onclick="EnablePushAsync">
                فعال‌سازی
            </button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_pushFeedback) && !_pushState.Subscribed)
    {
        <p class="gex-notification-feedback" role="status">@_pushFeedback</p>
    }

    <NotificationList Items="_items" Busy="_working" OnDelete="HandleDelete" OnMarkAsRead="HandleMarkAsRead" OnButtonAction="HandleButtonAction" />
</dialog>
@if (ShowTrigger)
{
    <button type="button" class="gex-icon-button" aria-label="اعلان‌ها" aria-haspopup="dialog" @onclick="OpenAsync"><ShellIcon Name="bell" /></button>
}
