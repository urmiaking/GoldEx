<header class="gex-topbar">
    <button type="button" class="gex-icon-button gex-menu-toggle" aria-label="باز کردن منوی اصلی" aria-controls="gex-navigation"
            aria-expanded="@DrawerOpen.ToString().ToLowerInvariant()" @onclick="() => DrawerOpenChanged.InvokeAsync(!DrawerOpen)"><ShellIcon Name="menu" /></button>
    <a class="gex-desktop-mark" href="@ClientRoutes.Home.Index" aria-label="گلدکس، صفحه اصلی">
        <img src="/apple-touch-icon-180x180.png" width="180" height="180" alt="" />
    </a>
    <div class="gex-desktop-route-trail"><RouteBreadcrumbs /></div>
    <a class="gex-desktop-wordmark" href="@ClientRoutes.Home.Index" lang="en" dir="ltr" aria-label="GoldEx">GoldEx</a>
    <div class="gex-mobile-brand"><ShellBrand Compact="true" /></div>
    <div class="gex-topbar-actions">
        <AppearanceControls ModeOnly="true" />
        <div class="gex-topbar-help"><Help /></div>
        <AuthorizeView Roles="Administrators,Owners">
            <button type="button" class="gex-icon-button" aria-label="@NotificationsLabel" title="اعلان‌ها" aria-haspopup="dialog" @onclick="OnNotificationsRequested">
                <ShellIcon Name="bell" />
                @if (NotificationCount > 0) { <span class="gex-unread-dot" aria-hidden="true"></span> }
            </button>
        </AuthorizeView>
        <AuthorizeView><Authorized><Settings /></Authorized></AuthorizeView>
        <AuthorizeView><Authorized><LicenseIndicator /></Authorized></AuthorizeView>
    </div>
    <div class="gex-topbar-date"><Clock /></div>
</header>
<div class="gex-mobile-route-bar"><RouteBreadcrumbs /></div>

@code {
    [Parameter] public bool DrawerOpen { get; set; }
    [Parameter] public EventCallback<bool> DrawerOpenChanged { get; set; }
    [Parameter] public EventCallback OnNotificationsRequested { get; set; }
    [Parameter] public int NotificationCount { get; set; }
    private string NotificationsLabel => NotificationCount > 0 ? $"اعلان‌ها، {NotificationCount} خوانده‌نشده" : "اعلان‌ها";
}
