@using GoldEx.Shared.DTOs.Stores
@using GoldEx.Shared.Services.Abstractions
@inherits GoldExComponentBase

<AuthorizeView>
    @if (_currentStore is not null)
    {
        <button type="button" class="store-switcher-btn" aria-label="@($"انتخاب فروشگاه؛ فروشگاه فعلی: {_currentStore.Name}")" @onclick="OpenAsync">
            <span class="store-switcher-logo">
                @if (!string.IsNullOrWhiteSpace(_currentStore.LogoUrl)) { <img src="@_currentStore.LogoUrl" alt="" /> }
                else { <ShellIcon Name="store" /> }
            </span>
            <span class="store-switcher-name">@_currentStore.Name</span><ShellIcon Name="expand" />
        </button>
    }
</AuthorizeView>

@code {
    [Parameter] public EventCallback OnOpen { get; set; }
    private UserStoreDto? _currentStore;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (User?.Identity?.IsAuthenticated == true)
            await SendRequestAsync<IStoreService, List<UserStoreDto>>((s, ct) => s.GetUserStoresAsync(ct),
                afterSend: stores => _currentStore = stores.FirstOrDefault(s => s.IsCurrent));
    }
    private async Task OpenAsync()
    {
        await OnOpen.InvokeAsync();
        await DialogService.ShowAsync<StoreSelectorDialog>("", new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
    }
}
