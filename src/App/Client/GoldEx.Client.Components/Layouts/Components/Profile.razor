@using GoldEx.Client.Components.Extensions

<div class="gex-profile">
    <AuthorizeView>
        <Authorized Context="auth">
            <a href="@ClientRoutes.UserAccounts.Index" class="gex-profile-trigger" aria-label="مدیریت پروفایل کاربری" title="مدیریت پروفایل کاربری">
                <span class="gex-avatar">@Initials(auth.User.GetDisplayName())</span>
            </a>
        </Authorized>
        <NotAuthorized>
            <a href="@ClientRoutes.Accounts.Login" class="gex-icon-button" aria-label="ورود به حساب" title="ورود"><ShellIcon Name="user" /></a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "گ" :
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));
}
