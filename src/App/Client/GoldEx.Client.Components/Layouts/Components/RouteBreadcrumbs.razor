@using GoldEx.Shared.Routings
@inject NavigationManager Navigation
@implements IDisposable

<nav class="gex-route-trail" aria-label="مسیر صفحه" @key="_location">
    <ol class="gex-route-trail-list">
        @for (var i = 0; i < _items.Count; i++)
        {
            var item = _items[i];
            var last = i == _items.Count - 1;
            <li class="gex-route-trail-item @(last ? "is-current" : "")" @key="item.Href ?? item.Label">
                @if (i > 0)
                {
                    <span class="gex-route-trail-separator" aria-hidden="true">←</span>
                }
                @if (!last && item.Href is not null)
                {
                    <a href="@item.Href" title="@item.Label">
                        @if (i == 0) { <ShellIcon Name="home" /> }
                        <span>@item.Label</span>
                    </a>
                }
                else
                {
                    <span class="gex-route-trail-current" aria-current="page">
                        @if (i == 0) { <ShellIcon Name="home" /> }
                        <span>@item.Label</span>
                    </span>
                }
            </li>
        }
    </ol>
</nav>

