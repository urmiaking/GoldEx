    // Only known, actual destinations are links; dynamic IDs and unknown path
    // segments are never printed or linked into the navigation trail.
    private static readonly HashSet<string> Navigable = new(Labels.Keys, StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Update();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => { Update(); StateHasChanged(); });

    private void Update()
    {
        _location = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var segments = _location.Split('/', StringSplitOptions.RemoveEmptyEntries);
        _items = [new Crumb("صفحه اصلی", segments.Length == 0 ? null : ClientRoutes.Home.Index)];
        if (segments.Length == 0) return;

        var path = "";
        foreach (var segment in segments)
        {
            path += "/" + Uri.UnescapeDataString(segment);
            if (Labels.TryGetValue(path, out var label))
            {
                _items.Add(new Crumb(label, Navigable.Contains(path) ? path : null));
                continue;
            }

            // Dynamic identifiers (invoice number, GUID, report name etc.)
            // belong to the last named destination, not to a raw URL crumb.
            if (_items.Count > 1)
                break;

            _items.Add(new Crumb("صفحه", null));
            break;
        }

        // Distinguish a newly created invoice from an existing one.
        if (path.Equals("/invoices/set", StringComparison.OrdinalIgnoreCase) && segments.Length == 2)
            _items[^1] = new Crumb("فاکتور جدید", null);

        if (_items.Count > 1)
        {
            _items[^1] = _items[^1] with { Href = null };
        }

        // Keep the current title and the nearest useful ancestors on limited
        // desktop widths. The home link remains visible for easy navigation.
        if (_items.Count > 4)
            _items = [_items[0], .. _items.TakeLast(3)];
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
