@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsDrawerOpen)
{
    <button type="button" class="gex-menu-scrim" tabindex="-1" aria-label="بستن منوی اصلی" @onclick="CloseAsync"></button>
}
<aside id="gex-navigation" @ref="_panel" class="gex-sidebar @(IsDrawerOpen ? "mobile-open" : null)" aria-label="ناوبری اصلی" tabindex="-1" @onkeydown="HandleKeyDown">
    <button type="button" class="gex-icon-button gex-menu-close" aria-label="بستن منو" @onclick="CloseAsync"><ShellIcon Name="close" /></button>
    <ShellBrand />
    <AuthorizeView>
        <a class="gex-sidebar-create" href="@ClientRoutes.Invoices.Create" @onclick="CloseAsync"><ShellIcon Name="plus" /><span>فاکتور جدید</span></a>
    </AuthorizeView>
    <div class="gex-menu-scroll"><NavMenu OnNavigate="HandleNavigate" /></div>
    <div class="gex-sidebar-license"><AuthorizeView><LicenseStatusBanner /></AuthorizeView></div>
    <ShellIdentity />
</aside>

@code {
    [Parameter] public bool IsDrawerOpen { get; set; }
    [Parameter] public EventCallback<bool> IsDrawerOpenChanged { get; set; }
    private ElementReference _panel;
    private IJSObjectReference? _module, _menu;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GoldEx.Client.Components/js/navigation.js");
            _menu = await _module.InvokeAsync<IJSObjectReference>("bind", _panel);
        }
        if (_menu is not null) await _menu.InvokeVoidAsync("update", IsDrawerOpen);
    }
    public async Task CloseAsync()
    {
        if (_menu is not null) await _menu.InvokeVoidAsync("update", false);
        await IsDrawerOpenChanged.InvokeAsync(false);
    }
    private Task HandleNavigate(bool _) => CloseAsync();
    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_menu is not null) { await _menu.InvokeVoidAsync("dispose"); await _menu.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
