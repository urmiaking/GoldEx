<AuthorizeView>
    <Authorized>
        <nav class="gex-bottom-nav" aria-label="ناوبری موبایل">
            <NavLink href="@ClientRoutes.Home.Index" Match="NavLinkMatch.All"><ShellIcon Name="home" /><span>خانه</span></NavLink>
            <NavLink href="@ClientRoutes.Calculator.Index"><ShellIcon Name="calculator" /><span>محاسبه‌گر</span></NavLink>
            <AuthorizeView Roles="@($"{BuiltinRoles.Administrators},{BuiltinRoles.Owners}")" Context="createAccess">
                <Authorized><QuickCreateMenu /></Authorized>
                <NotAuthorized><a href="@ClientRoutes.UserAccounts.Index" class="gex-bottom-create"><span class="gex-create-circle"><ShellIcon Name="user" /></span><span>حساب من</span></a></NotAuthorized>
            </AuthorizeView>
            <NavLink href="@ClientRoutes.Customers.Index"><ShellIcon Name="users" /><span>مشتریان</span></NavLink>
            <NavLink href="@ClientRoutes.Invoices.Index" Match="NavLinkMatch.All"><ShellIcon Name="file" /><span>فاکتورها</span></NavLink>
        </nav>
    </Authorized>
    <NotAuthorized>
        <nav class="gex-bottom-nav gex-bottom-nav--guest" aria-label="ناوبری موبایل">
            <NavLink href="@ClientRoutes.Home.Index" Match="NavLinkMatch.All"><ShellIcon Name="home" /><span>خانه</span></NavLink>
            <NavLink href="@ClientRoutes.Calculator.Index"><ShellIcon Name="calculator" /><span>محاسبه‌گر</span></NavLink>
            <a href="@ClientRoutes.Accounts.Login"><ShellIcon Name="user" /><span>ورود</span></a>
            <NavLink href="@ClientRoutes.About.Index"><ShellIcon Name="info" /><span>دربارهٔ ما</span></NavLink>
        </nav>
    </NotAuthorized>
</AuthorizeView>
