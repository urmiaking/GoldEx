@using System.Globalization
@implements IDisposable

<span class="gex-clock"><ShellIcon Name="calendar" /><span>@_currentDate</span><span class="gex-clock-time" dir="ltr">@_currentTime</span></span>

@code {
    private string? _currentDate;
    private string? _currentTime;

    private Timer? _timer;

    protected override void OnInitialized()
    {
        SetCurrentTime();
        _timer = new Timer(_ => InvokeAsync(SetCurrentTime), null, TimeSpan.FromSeconds(1), TimeSpan.FromMinutes(1));
    }

    private void SetCurrentTime()
    {
        var now = DateTime.Now;

        _currentDate = now.ToString("yyyy/MM/dd", CultureInfo.CurrentUICulture);
        _currentTime = now.ToString("HH:mm");

        StateHasChanged();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
