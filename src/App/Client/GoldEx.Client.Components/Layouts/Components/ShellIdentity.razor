@using System.Security.Claims
@using GoldEx.Client.Components.Extensions
@inject NavigationManager Navigation

<div class="gex-sidebar-identity">
    <AuthorizeView>
        <Authorized Context="auth">
            <a href="@ClientRoutes.UserAccounts.Index" class="gex-identity-link" aria-label="حساب کاربری">
                <span class="gex-avatar">@Initials(auth.User.GetDisplayName())</span>
                <span class="gex-identity-copy"><strong>@auth.User.GetDisplayName()</strong><small>@auth.User.Identity?.Name</small></span>
                <span class="gex-identity-arrow" aria-hidden="true"><ShellIcon Name="chevron-left" /></span>
            </a>
            <div class="gex-mobile-license"><MobileLicenseRibbon /></div>
            <a href="@ApiUrls.Account.Logout(Navigation.ToBaseRelativePath(Navigation.Uri))" class="gex-icon-button gex-signout" aria-label="خروج از حساب" title="خروج"><ShellIcon Name="log-out" /><span class="gex-signout-label">خروج از حساب</span></a>
        </Authorized>
        <NotAuthorized>
            <a href="@ClientRoutes.Accounts.Login" class="gex-identity-link"><span class="gex-avatar"><ShellIcon Name="user" /></span><span class="gex-identity-copy"><strong>ورود به گلدکس</strong><small>حساب کاربری شما</small></span></a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "گ" :
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));
}
