@using GoldEx.Client.Components.Services.Abstractions
@using GoldEx.Client.Components.Themes
@implements IAsyncDisposable
@inject IThemeService Theme
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="gex-palette-floating">
    <button type="button" @ref="_trigger" class="gex-palette-edge"
            popovertarget="@_id" aria-controls="@_id" aria-haspopup="dialog" aria-expanded="false"
            aria-label="انتخاب رنگ از کنار صفحه" aria-describedby="@(_id + "-hint")" disabled="@Theme.IsChanging"
            title="رنگ فضای کار؛ برای جابه‌جایی بالا و پایین بکشید"><ShellIcon Name="palette" /></button>
    <span id="@(_id + "-hint")" class="gex-palette-drag-hint">برای جابه‌جایی بکشید یا از کلیدهای بالا و پایین استفاده کنید.</span>
    <section @ref="_popover" id="@_id" popover="auto" role="dialog" aria-labelledby="@(_id + "-title")"
             aria-busy="@Theme.IsChanging.ToString().ToLowerInvariant()" class="gex-palette-sheet" dir="rtl">
        <svg class="gex-palette-sheet-shape" aria-hidden="true" focusable="false"><path /></svg>
        <span class="gex-palette-sheet-mark" aria-hidden="true"><ShellIcon Name="palette" /></span>
        <div class="gex-palette-sheet-content">
            <header class="gex-palette-sheet-heading">
                <div><h2 id="@(_id + "-title")">رنگ فضای کار</h2><p>یک رنگ، در روشنایی و تاریکی</p></div>
                <button type="button" class="gex-appearance-button" popovertarget="@_id" popovertargetaction="hide" aria-label="بستن انتخاب رنگ"><ShellIcon Name="close" /></button>
            </header>
            <div class="gex-palette-options" role="group" aria-label="پالت‌های رنگ">
                @foreach (var option in ColorPalettes.Options)
                {
                    var selected = Theme.CurrentPalette == option.Id;
                    var palette = ColorPalettes.Palettes[option.Id];
                    <button type="button" class="gex-palette-option @(selected ? "selected" : null)" aria-label="@option.Title"
                            aria-pressed="@selected.ToString().ToLowerInvariant()" disabled="@Theme.IsChanging" @onclick="() => Theme.SetPaletteAsync(option.Id, _trigger)">
                        <span class="gex-palette-preview" aria-hidden="true">
                            <span style="@($"background:{palette.PaletteLight.Background};color:{palette.PaletteLight.Primary}")"><i></i><i></i><i></i></span>
                            <span style="@($"background:{palette.PaletteDark.Background};color:{palette.PaletteDark.Primary}")"><i></i><i></i><i></i></span>
                        </span>
                        <span class="gex-palette-name">@option.Title @if (selected) { <ShellIcon Name="check" /> }</span>
                    </button>
                }
            </div>
            <span role="status">رنگ انتخاب‌شده: @ColorPalettes.Options.First(p => p.Id == Theme.CurrentPalette).Title</span>
        </div>
    </section>
</div>

@code {
    private readonly string _id = $"gex-edge-palette-{Guid.NewGuid():N}";
    private ElementReference _trigger, _popover;
    private IJSObjectReference? _module, _binding;
    private bool _disposed;
    protected override void OnInitialized()
    {
        Theme.OnAppearanceChanged += RefreshAsync;
        Navigation.LocationChanged += LocationChanged;
    }
    private Task RefreshAsync() => InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(CloseAsync);
    private async Task CloseAsync()
    {
        if (_disposed || _binding is null) return;
        try { await _binding.InvokeVoidAsync("close"); }
        catch (JSDisconnectedException) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GoldEx.Client.Components/js/palette-picker.js");
        _binding = await _module.InvokeAsync<IJSObjectReference>("bind", _trigger, _popover);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Theme.OnAppearanceChanged -= RefreshAsync;
        Navigation.LocationChanged -= LocationChanged;
        try
        {
            if (_binding is not null) { await _binding.InvokeVoidAsync("dispose"); await _binding.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
