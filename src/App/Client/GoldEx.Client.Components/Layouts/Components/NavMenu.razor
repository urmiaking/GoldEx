@using GoldEx.Shared.Routings
@using Microsoft.JSInterop

@inherits GoldExComponentBase

<MudNavMenu Bordered="true" Margin="Margin.Dense" Color="Color.Primary">
    <MudNavLink Href="@ClientRoutes.Home.Index" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        صفحه اصلی
    </MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="@ClientRoutes.Dashboard.Index" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                داشبورد
            </MudNavLink>
            @if (_currentStore != null)
            {
                <MudNavLink Href="@($"/{_currentStore.Slug}")"
                            Target="_blank"
                            Icon="@Icons.Material.Filled.Storefront"
                            Class="vitrine-nav-link"
                            Match="NavLinkMatch.Prefix">
                    <div class="d-flex align-center justify-space-between w-100">
                        <span>ویترین آنلاین گالری</span>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Style="font-size: 0.65rem; height: 18px; font-weight: 900;">
                            LIVE
                        </MudChip>
                    </div>
                </MudNavLink>
            }
        </Authorized>
    </AuthorizeView>
    <MudNavLink Href="@ClientRoutes.Calculator.Index" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Calculate">
        محاسبه گر
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="@ClientRoutes.Invoices.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.LibraryBooks">
                فاکتور ها
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.InventoryStocks.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Warehouse">
                مدیریت انبار
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.Customers.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.PeopleAlt">
                مشتریان
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.Reporting.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.BarChart">
                گزارش ها
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.Finances.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Payment">
                اسناد مالی
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.UserAccounts.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.ManageAccounts">
                مدیریت حساب
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.Settings.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Settings">
                تنظیمات
            </MudNavLink>
            <MudNavLink Href="@ClientRoutes.Blogs.Index" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Help">
                راهنما
            </MudNavLink>

            @* فقط اگر مرورگر می‌گه «قابل نصب است» دکمه را نشان بده *@
            @if (_canInstall)
            {
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudNavLink Icon="@Icons.Material.Filled.InstallDesktop"
                                OnClick="@InstallPwa"
                                Match="NavLinkMatch.All">
                        نصب اپلیکیشن
                    </MudNavLink>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudNavLink Icon="@Icons.Material.Filled.InstallMobile"
                                OnClick="@InstallPwa"
                                Match="NavLinkMatch.All">
                        نصب اپلیکیشن
                    </MudNavLink>
                </MudHidden>
            }
        </Authorized>
    </AuthorizeView>
    <MudNavLink Href="@ClientRoutes.About.Index" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Info">
        درباره
    </MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="@ApiUrls.Account.Logout(_currentUrl)" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Logout">
                خروج
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private string? _currentUrl;
    private bool _canInstall;
    private GoldEx.Shared.DTOs.Stores.UserStoreDto? _currentStore;

    [Parameter] public EventCallback<bool> OnNavigate { get; set; }
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await LoadCurrentStoreAsync();
        }
    }

    private async Task LoadCurrentStoreAsync()
    {
        var stores = await SendRequestAsync<GoldEx.Shared.Services.Abstractions.IStoreService, List<GoldEx.Shared.DTOs.Stores.UserStoreDto>>(
            (service, token) => service.GetUserStoresAsync(token));

        if (stores != null)
        {
            _currentStore = stores.FirstOrDefault(s => s.IsCurrent);
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _canInstall = await JsRuntime.InvokeAsync<bool>("getPwaState");
                if (_canInstall)
                {
                    StateHasChanged();
                }
            }
            catch
            {
                // اگر JS خراب شد، دکمه پنهان می‌ماند
                _canInstall = false;
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = Navigation.ToBaseRelativePath(e.Location);
        await OnNavigate.InvokeAsync(false);
        StateHasChanged();
    }

    public override ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        return base.DisposeAsync();
    }

    private async Task InstallPwa()
    {
        try
        {
            var installed = await JsRuntime.InvokeAsync<bool>("installPwa");
            if (installed)
            {
                _canInstall = false;
                StateHasChanged();
            }
        }
        catch
        {
            AddErrorToast("خطایی در نصب رخ داد");
        }
    }
}