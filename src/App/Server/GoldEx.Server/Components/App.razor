<!DOCTYPE html>
<html lang="fa">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#daa520" />
    <base href="/" />

    <link href="@Assets["manifest.webmanifest"]" rel="manifest" />

    @if (IsVitrineRoute() && !string.IsNullOrWhiteSpace(StoreLogoUrl))
    {
        <link rel="shortcut icon" href="@StoreLogoUrl" />
        <link rel="icon" type="image/png" href="@StoreLogoUrl" />
        <link rel="apple-touch-icon" href="@StoreLogoUrl" />
    }
    else
    {
        <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
        <link rel="icon" type="image/png" href="/favicon.ico" />
    }

    <link rel="stylesheet" href="@Assets["fonts/Google/google-fonts.css"]" />
    <link rel="stylesheet" href="@Assets["fonts/IRANSANS/IRANSANS-font-face.css"]" />
    <link rel="stylesheet" href="@Assets["css/lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["GoldEx.Server.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />

    <ImportMap />

    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    @if (IsVitrineRoute())
    {
        <link rel="stylesheet" href="/assets/fontawesome/css/all.min.css?v=6.5.1" />
        <link rel="stylesheet" href="/assets/vitrine/css/vitrine.css" />
    }
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>

    @if (ShowSplash)
    {
        <div id="app-loading">
            <div class="splash-screen">
                @if (!string.IsNullOrWhiteSpace(SplashLogoUrl))
                {
                    <img src="@SplashLogoUrl" alt="@SplashTitle" class="splash-logo" />
                }
                else
                {
                    <span class="brand-text @(IsStoreTitle ? "store-title" : "default-title")" dir="@(IsStoreTitle ? "rtl" : "ltr")">@SplashTitle</span>
                }
                <div class="splash-progress-track">
                    <div class="splash-progress-bar"></div>
                </div>
            </div>
        </div>
    }


    @if (Env.IsDevelopment())
    {
        <Routes @rendermode="RenderModeForPage" />
    }
    else
    {
        @if (_license is not null)
        {
            @if (_license.Plan is Shared.Enums.LicensePlan.Unregistered && IsLoggedIn)
            {
                @* <UnregisteredRoute @rendermode="RenderModeForPage" /> *@
                <Routes @rendermode="RenderModeForPage" />
            }
            else
            {
                <Routes @rendermode="RenderModeForPage" />
            }
        }
    }

    <script src=@Assets["app.js"]></script>
    <script src=@Assets["_framework/blazor.web.js"] autostart="false"></script>
    <script>
        Blazor.start({
        webAssembly: {}
        });
    </script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/pwa-helper.js"]"></script>
</body>


</html>