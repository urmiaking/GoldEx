<!DOCTYPE html>
<html lang="fa">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#daa520" />
    <base href="/" />

    @if (!IsVitrineRoute())
    {
        <link href="@Assets["manifest.webmanifest"]" rel="manifest" />
        <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
        <link rel="icon" type="image/png" href="/favicon.ico" />

        <link rel="stylesheet" href="@Assets["fonts/Google/google-fonts.css"]" />
        <link rel="stylesheet" href="@Assets["fonts/IRANSANS/IRANSANS-font-face.css"]" />
        <link rel="stylesheet" href="@Assets["fonts/vazir/Vazirmatn-font-face.css"]" />
        <link rel="stylesheet" href="@Assets["css/lib/bootstrap/dist/css/bootstrap.min.css"]" />
        <link rel="stylesheet" href="@Assets["GoldEx.Server.styles.css"]" />
        <link rel="stylesheet" href="@Assets["css/app.css"]" />
        <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(StoreLogoUrl))
        {
            <link rel="shortcut icon" href="@StoreLogoUrl" />
            <link rel="icon" type="image/png" href="@StoreLogoUrl" />
            <link rel="apple-touch-icon" href="@StoreLogoUrl" />
        }
        else
        {
            <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
            <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
            <link rel="icon" type="image/png" href="/favicon.ico" />
        }

        <link rel="stylesheet" href="@Assets["fonts/IRANSANS/IRANSANS-font-face.css"]" />
        <link rel="stylesheet" href="@Assets["fonts/vazir/Vazirmatn-font-face.css"]" />
        <link rel="stylesheet" href="@Assets["css/lib/bootstrap/dist/css/bootstrap.min.css"]" />
        <meta name="theme-color" content="@GetVitrineThemeColorMeta()" />
        <link rel="stylesheet" href="/assets/fontawesome/css/all.min.css?v=6.5.1" />
        <link rel="stylesheet" href="/assets/vitrine/css/vitrine.css?v=@AppVersion" />
        @if (!string.IsNullOrWhiteSpace(VitrinePrimaryColor) || !string.IsNullOrWhiteSpace(VitrineAccentColor) || !string.IsNullOrWhiteSpace(VitrineBackgroundColor) || !string.IsNullOrWhiteSpace(VitrineSurfaceColor))
        {
            <style>
                .vitrine-root {
                    @if (!string.IsNullOrWhiteSpace(VitrinePrimaryColor)) { <text>--primary-color: @VitrinePrimaryColor; --primary-dark: @VitrinePrimaryColor; </text> }
                    @if (!string.IsNullOrWhiteSpace(VitrineAccentColor)) { <text>--accent-color: @VitrineAccentColor; --accent-hover: @VitrineAccentColor; </text> }
                    @if (!string.IsNullOrWhiteSpace(VitrineBackgroundColor)) { <text>--light-color: @VitrineBackgroundColor; </text> }
                    @if (!string.IsNullOrWhiteSpace(VitrineSurfaceColor)) { <text>--white: @VitrineSurfaceColor; </text> }
                }
            </style>
        }
    }

    @if (!IsVitrineRoute())
    {
        <ImportMap />
    }

    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>

    @if (ShowSplash)
    {
        <div id="app-loading">
            <div class="splash-screen">
                @if (!string.IsNullOrWhiteSpace(SplashLogoUrl))
                {
                    <img src="@SplashLogoUrl" alt="@SplashTitle" class="splash-logo" />
                }
                else
                {
                    <span class="brand-text @(IsStoreTitle ? "store-title" : "default-title")" dir="@(IsStoreTitle ? "rtl" : "ltr")">@SplashTitle</span>
                }
                <div class="splash-progress-track">
                    <div class="splash-progress-bar"></div>
                </div>
            </div>
        </div>
    }


    @if (Env.IsDevelopment())
    {
        <Routes @rendermode="RenderModeForPage" />
    }
    else
    {
        @if (_license is not null)
        {
            @if (_license.Plan is Shared.Enums.LicensePlan.Unregistered && IsLoggedIn)
            {
                @* <UnregisteredRoute @rendermode="RenderModeForPage" /> *@
                <Routes @rendermode="RenderModeForPage" />
            }
            else
            {
                <Routes @rendermode="RenderModeForPage" />
            }
        }
    }

    @if (!IsVitrineRoute())
    {
        <script src=@Assets["app.js"]></script>
    }
    else
    {
        <script src="/assets/vitrine/js/vitrine.js?v=@AppVersion"></script>
    }

    <script src=@Assets["_framework/blazor.web.js"] autostart="false"></script>
    <script>
        (async function () {
            @if (StoreContext.IsCustomDomain)
            {
                <text>
                try {
                    // 1. Unregister active service workers on Vitrine routes & custom domains
                    if ('serviceWorker' in navigator) {
                        const regs = await navigator.serviceWorker.getRegistrations();
                        if (regs.length > 0) {
                            for (const r of regs) {
                                await r.unregister();
                            }
                            const swKey = 'gex_sw_cleared_once';
                            if (navigator.serviceWorker.controller && !sessionStorage.getItem(swKey)) {
                                sessionStorage.setItem(swKey, '1');
                                if ('caches' in window) {
                                    const keys = await caches.keys();
                                    for (const k of keys) {
                                        await caches.delete(k);
                                    }
                                }
                                window.location.reload();
                                return;
                            }
                        }
                    }

                    // 2. Version-based Cache Eviction
                    const serverVer = '@AppVersion';
                    const localVer = localStorage.getItem('gex_vitrine_wasm_ver');
                    if (serverVer && localVer !== serverVer) {
                        if ('caches' in window) {
                            const keys = await caches.keys();
                            for (const k of keys) {
                                await caches.delete(k);
                            }
                        }
                        localStorage.setItem('gex_vitrine_wasm_ver', serverVer);
                    }
                } catch (e) {
                    console.warn('[GoldEx Vitrine Boot] Cache sync warning:', e);
                }
                </text>
            }

            // 3. Start Blazor with guaranteed fresh blazor.boot.json
            Blazor.start({
                webAssembly: {
                    loadBootResource: function (type, name, defaultUri, integrity) {
                        if (type === 'manifest' || name === 'blazor.boot.json') {
                            return fetch(defaultUri, { cache: 'no-store' });
                        }
                        return null;
                    }
                }
            });
        })();
    </script>
    @if (!IsVitrineRoute())
    {
        <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
        <script src="@Assets["js/pwa-helper.js"]"></script>
    }
</body>

</html>
