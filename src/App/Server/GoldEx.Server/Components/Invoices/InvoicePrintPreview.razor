@using GoldEx.Client.Components.Layouts.Components
@using GoldEx.Server.Application.Reporting
@using GoldEx.Shared.DTOs.Settings
@using GoldEx.Shared.Enums
@using static GoldEx.Server.Components.Invoices.InvoicePrintFormat

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@Title @DocumentNumber | GoldEx</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/reports/invoice-print.css" />
    <script src="/js/invoice-print.js" defer></script>
</head>
<body>
    <nav class="print-toolbar" aria-label="ابزارهای چاپ">
        @if (!IsShared)
        {
            <a href="@ClientRoutes.Invoices.Index">بازگشت به فاکتورها</a>
        }
        <div class="print-toolbar-actions">
            <button type="button" data-print-invoice="mono" hidden><ShellIcon Name="print" /> چاپ سیاه‌وسفید</button>
            <button type="button" data-print-invoice="color" hidden><ShellIcon Name="print" /> چاپ رنگی</button>
        </div>
    </nav>

    <main class="invoice-sheet">
        <header class="invoice-header">
            <div class="invoice-letterhead">
                <img class="invoice-letterhead-art" src="/assets/invoices/goldex-engraving.webp" alt="" />
                <div class="invoice-store-identity">
                    <div class="invoice-brand">
                        <img src="@LogoUrl" width="56" height="56" alt="" />
                        <p class="invoice-store">@StoreName</p>
                    </div>
                    @if (Setting is { } setting &&
                         (!string.IsNullOrWhiteSpace(setting.Address) || !string.IsNullOrWhiteSpace(setting.PhoneNumber)))
                    {
                        <ul class="invoice-store-contact" aria-label="راه‌های تماس فروشگاه">
                            @if (!string.IsNullOrWhiteSpace(setting.PhoneNumber))
                            {
                                <li><ShellIcon Name="phone" /> <bdi dir="ltr">@Digits(setting.PhoneNumber)</bdi></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(setting.Address))
                            {
                                <li><ShellIcon Name="pin" /> <span>@Digits(setting.Address)</span></li>
                            }
                        </ul>
                    }
                </div>
                <div class="invoice-header-tools">
                    <div class="invoice-reference">
                        <h1>@Title</h1>
                        <strong><bdi dir="ltr">@DocumentNumber</bdi></strong>
                    </div>
                    @if (ShareUrl is not null && QrImage is not null)
                    {
                        <a class="invoice-qr" href="@ShareUrl" target="_blank" rel="noopener noreferrer" aria-label="باز کردن نسخهٔ مشتری فاکتور">
                            <img src="@QrImage" width="90" height="90" alt="کد QR نسخهٔ مشتری" />
                        </a>
                    }
                </div>
            </div>
            <div class="invoice-header-details">
                <InvoicePrintCounterparty Role="@(IsSale ? "خریدار" : "فروشنده")" Party="@Invoice.Customer" />
                <dl class="invoice-meta">
                    <div><dt>تاریخ فاکتور</dt><dd><bdi dir="ltr">@Date(Invoice.Date)</bdi></dd></div>
                    @if (Invoice.DueDate is { } dueDate)
                    {
                        <div><dt>سررسید</dt><dd><bdi dir="ltr">@Date(dueDate)</bdi></dd></div>
                    }
                    @if (Invoice.GoldRate is { } rate)
                    {
                        <div>
                            <dt>نرخ هر @rate.Unit.GetDisplayName() طلای ۱۸ عیار</dt>
                            <dd><bdi dir="ltr">@Amount(rate.Amount, "تومان")</bdi> تومان</dd>
                        </div>
                    }
                </dl>
            </div>
        </header>

        <div class="invoice-body">
            <InvoicePrintLines Title="اقلام فاکتور" ShowHeading="false" Unit="@Invoice.Unit" Lines="@Invoice.Items"
                               Subtotal="@(Invoice.Subtotal - (IsSale ? 0 : Invoice.UsedGoldAmount))" StoneAmount="@Invoice.Charges.Stones" />
            <InvoicePrintLines Title="@(IsSale ? "طلای دریافتی بابت فاکتور" : "طلای دریافتی در خرید")" Unit="@Invoice.Unit"
                               Lines="@Invoice.UsedGold" Subtotal="@Invoice.UsedGoldAmount" SubtotalLabel="ارزش طلای دریافتی" />

            @if (IsSale && !IsWholesaleSale && Invoice.Items.Any(item => item.ProductType.HasValue))
            {
                <section class="invoice-terms" aria-label="شرایط فروش">
                    <ul class="invoice-sale-terms">
                        <li>@RetailSaleTerms</li>
                        <li>اجناس فروخته شده بدون علت پس گرفته نمی‌شود.</li>
                    </ul>
                </section>
            }

            <div class="invoice-closing">
                @if (Invoice.Payments.Count > 0)
                {
                    <section class="invoice-payments" aria-labelledby="invoice-payments-title">
                        <h2 id="invoice-payments-title" class="invoice-panel-label">تسویه‌ها</h2>
                        <table class="invoice-table payment-table">
                            <thead><tr><th scope="col">تاریخ</th><th scope="col">روش و جزئیات</th><th scope="col" class="amount">مبلغ</th></tr></thead>
                            <tbody>
                                @foreach (var payment in Invoice.Payments)
                                {
                                    <tr>
                                        <td><bdi dir="ltr">@Date(payment.Date)</bdi></td>
                                        <td>
                                            <strong>@payment.Side.GetDisplayTitle()</strong> · @(payment.Type == PaymentType.InternalCash ? "نقدی یا بانکی" : payment.Type.GetDisplayName())
                                            @if (!string.IsNullOrWhiteSpace(payment.Reference))
                                            {
                                                <small>شماره پیگیری <bdi>@Digits(payment.Reference)</bdi></small>
                                            }
                                            @if (payment.CheckDueDate is { } checkDate)
                                            {
                                                <small>سررسید چک <bdi dir="ltr">@Date(checkDate)</bdi></small>
                                            }
                                            @if (payment.GoldFineness is > 0)
                                            {
                                                <small>عیار <bdi dir="ltr">@Number(payment.GoldFineness.Value)</bdi></small>
                                            }
                                            @if (payment.CoinQuantity is > 0)
                                            {
                                                <small><bdi dir="ltr">@Number(payment.CoinQuantity.Value)</bdi> عدد @payment.CoinName</small>
                                            }
                                        </td>
                                        <td class="amount">
                                            <bdi dir="ltr">@Amount(payment.Amount, payment.Unit)</bdi> @payment.Unit
                                            @if (payment.Unit != Invoice.Unit || payment.InvoiceAmount != payment.Amount)
                                            {
                                                <small>معادل <bdi dir="ltr">@Amount(payment.InvoiceAmount, Invoice.Unit)</bdi> @Invoice.Unit</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (Invoice.Received != 0 || Invoice.Paid != 0)
                            {
                                <tfoot>
                                    @if (Invoice.Received != 0)
                                    {
                                        <tr><th scope="row" colspan="2">جمع دریافتی</th><td class="amount"><bdi dir="ltr">@Amount(Invoice.Received, Invoice.Unit)</bdi> @Invoice.Unit</td></tr>
                                    }
                                    @if (Invoice.Paid != 0)
                                    {
                                        <tr><th scope="row" colspan="2">جمع پرداختی</th><td class="amount"><bdi dir="ltr">@Amount(Invoice.Paid, Invoice.Unit)</bdi> @Invoice.Unit</td></tr>
                                    }
                                </tfoot>
                            }
                        </table>
                    </section>
                }
                <section class="invoice-totals" aria-label="جمع‌بندی فاکتور">
                    <dl class="invoice-summary">
                        @foreach (var (label, amount, emphasized) in Totals)
                        {
                            <div class="@(emphasized ? "invoice-total-final" : null)">
                                <dt>@label</dt><dd><bdi dir="ltr">@Amount(amount, Invoice.Unit)</bdi> @Invoice.Unit</dd>
                            </div>
                        }
                    </dl>
                    <div class="invoice-remaining @(Invoice.Remaining == 0 ? "is-settled" : null)">
                        <span>@RemainingLabel</span>
                        <div class="amount">
                            @if (Invoice.Remaining != 0)
                            {
                                <strong><bdi dir="ltr">@Amount(Math.Abs(Invoice.Remaining), Invoice.Unit)</bdi> @Invoice.Unit</strong>
                                @if (Invoice.SecondaryRemaining is { } equivalent && !string.IsNullOrWhiteSpace(Invoice.SecondaryUnit))
                                {
                                    <small>معادل <bdi dir="ltr">@Amount(Math.Abs(equivalent), Invoice.SecondaryUnit)</bdi> @Invoice.SecondaryUnit</small>
                                }
                            }
                        </div>
                    </div>
                    <div class="invoice-signatures" aria-label="محل امضا">
                        <span>@StoreSignature</span>
                        <span>@CustomerSignature</span>
                    </div>
                </section>
                @if (IsWholesaleSale)
                {
                    <section class="invoice-terms invoice-consignment-terms">
                        <h2>شرایط تحویل امانی</h2>
                        <p>کلیهٔ طلاجات مندرج در این قبض جهت بازاریابی به اینجانب @Invoice.Customer.Name به رسم امانت تحویل گردید و شرعاً و قانوناً متعهد و ملزم گردیدم هر آنچه از اقلام اجناس را بابت خود یا دیگری فاکتور نمودم، بهای آن را علاوه بر اجرت نقداً به @StoreName بپردازم و مابقی اجناس را عندالمطالبه مسترد نمایم. چون اجناس مذکور نزد اینجانب امانت بوده و دین است بر ذمهٔ اینجانب و در این خصوص هرگونه کوتاهی، بی‌احتیاطی و غیره به عمل آید، ضامن و مسئول پاسخگو هستم.</p>
                    </section>
                }
            </div>
            <div class="invoice-endmark"><span class="invoice-wordmark" dir="ltr">GoldEx</span></div>
        </div>
    </main>
</body>
</html>

@code {
    [Parameter, EditorRequired] public InvoicePrintDocument Invoice { get; set; } = default!;
    [Parameter] public GetSettingResponse? Setting { get; set; }
    [Parameter, EditorRequired] public string LogoUrl { get; set; } = default!;
    [Parameter] public string? ShareUrl { get; set; }
    [Parameter] public string? QrImage { get; set; }
    [Parameter] public bool IsShared { get; set; }

    private bool IsSale => Invoice.Type == InvoiceType.Sell;
    private bool IsWholesaleSale => IsSale && Invoice.Scale == TradeScale.Wholesale;
    private string StoreName => string.IsNullOrWhiteSpace(Setting?.InstitutionName) ? "فروشگاه طلا و جواهر" : Setting.InstitutionName;
    private string Title => $"فاکتور {Invoice.Type.GetDisplayName()}";
    private string StoreSignature => IsWholesaleSale ? "مهر و امضای تحویل‌دهنده" : IsSale ? "مهر و امضای فروشنده" : "مهر و امضای خریدار";
    private string CustomerSignature => IsWholesaleSale ? "امضای تحویل‌گیرنده" : IsSale ? "امضای خریدار" : "امضای فروشنده";
    private string DocumentNumber => Digits(Invoice.Number.ToString(System.Globalization.CultureInfo.InvariantCulture));
    private string RemainingLabel => Invoice.Remaining == 0 ? "تسویه کامل" :
        IsSale == (Invoice.Remaining > 0) ? "مانده دریافت از مشتری" : "مانده پرداخت به مشتری";

    private string RetailSaleTerms
    {
        get
        {
            var profit = Invoice.Charges.ProfitRates.Count > 0 ? $" و سود {FormatRates(Invoice.Charges.ProfitRates)}" : "";
            var tax = Invoice.Charges.TaxRates.Count > 0 ? $" و مالیات ارزش افزوده {FormatRates(Invoice.Charges.TaxRates)} از اجرت و سود" : "";
            return $"اجناس فوق با اجرت مشخص{profit}{tax} عرضه شده و در موقع فروش با فاکتور و به نرخ روز خریداری خواهد شد.";
        }
    }

    private static string FormatRates(IReadOnlyList<decimal> rates) => string.Join("، ", rates.Select(rate => $"{Number(rate)}٪"));

    private IEnumerable<(string Label, decimal Amount, bool Emphasized)> Totals
    {
        get
        {
            if (Invoice.Discount != 0)
                yield return ("تخفیف", -Invoice.Discount, false);
            if (Invoice.ExtraCost != 0)
                yield return ("هزینه اضافی", Invoice.ExtraCost, false);
            yield return ("مبلغ نهایی فاکتور", Invoice.Total, true);
        }
    }
}
