@using GoldEx.Client.Components.Layouts.Components
@using GoldEx.Server.Application.Reporting
@using static GoldEx.Server.Components.Invoices.InvoicePrintFormat

<section class="invoice-party-card @(IsStore ? "is-store" : null)">
    <h2 class="invoice-panel-label">@Role</h2>
    <div class="invoice-party-heading">
        <span class="invoice-party-icon"><ShellIcon Name="@(IsStore ? "store" : "user")" /></span>
        <strong>@Party.Name</strong>
    </div>
    @if (!string.IsNullOrWhiteSpace(Party.Phone) || !string.IsNullOrWhiteSpace(Party.CustomerCode))
    {
        <dl class="invoice-party-details">
            @if (!string.IsNullOrWhiteSpace(Party.Phone))
            {
                <div>
                    <dt>تلفن</dt>
                    <dd><bdi dir="ltr">@Digits(Party.Phone)</bdi></dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Party.CustomerCode))
            {
                <div>
                    <dt>کد مشتری</dt>
                    <dd><bdi dir="ltr">@Digits(Party.CustomerCode)</bdi></dd>
                </div>
            }
        </dl>
    }
    @if (!string.IsNullOrWhiteSpace(Party.Address))
    {
        <dl class="invoice-party-address">
            <dt>نشانی</dt>
            <dd title="@(IsStore ? Digits(Party.Address) : null)">@Digits(Party.Address)</dd>
        </dl>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = default!;
    [Parameter, EditorRequired] public InvoicePrintParty Party { get; set; } = default!;
    [Parameter] public bool IsStore { get; set; }
}
