@attribute [Route(ClientRoutes.Accounts.ForgotPassword)]

@inject UserManager<AppUser> UserManager
@inject ISmsSender SmsSender
@inject ISmsSecurityService SmsSecurityService
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@layout EmptyBoxLayout

<PageTitle>فراموشی رمز عبور</PageTitle>

<MudStack AlignItems="AlignItems.Center">
    <MudItem>
        <span class="brand-text" dir="ltr">GoldEx</span>
    </MudItem>
    <MudItem>
        <MudText Align="Align.Center" Typo="Typo.h5" GutterBottom="true">فراموشی رمز عبور</MudText>
    </MudItem>
    <MudItem>
        <MudText Typo="Typo.body1" Align="Align.Center">رمز عبور خود را فراموش کرده‌اید؟ لطفاً شماره تلفن همراه خود را در کادر زیر وارد کنید تا کد تایید برای شما پیامک شود.</MudText>
    </MudItem>
</MudStack>

<EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />

    <MudGrid Class="mt-2 mb-2">
        <MudItem xs="12">
            <MudStaticTextField @bind-Value="Input.PhoneNumber" For="@(() => Input.PhoneNumber)"
                                Label="شماره تلفن همراه" Placeholder="09123456789" Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "tel" }, { "aria-required", "true" }, { "dir", "ltr" } } )" />
        </MudItem>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudItem xs="12" Class="mb-0">
                <StatusMessage Message="@_errorMessage" Severity="Severity.Error" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" FormAction="FormAction.Submit">ارسال کد تایید</MudStaticButton>
        </MudItem>
    </MudGrid>
</EditForm>

<MudGrid Class="mt-1">
    <MudItem xs="12" Class="text-center">
        <MudLink Href="@ClientRoutes.Accounts.Login">بازگشت به صفحه ورود</MudLink>
    </MudItem>
</MudGrid>

@code {
    private string? _errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        var phoneNumber = Input.PhoneNumber?.Trim() ?? "";
        var clientIp = HttpContext.Connection.RemoteIpAddress?.ToString();

        // 1. Rate Limiting and Security Check
        var rateCheck = SmsSecurityService.CheckCanSendSms(phoneNumber, clientIp);
        if (!rateCheck.Allowed)
        {
            _errorMessage = rateCheck.ErrorMessage ?? "امکان ارسال پیامک در حال حاضر وجود ندارد.";
            return;
        }

        // 2. Anti-Enumeration: Lookup user
        var user = await UserManager.Users.FirstOrDefaultAsync(u => u.PhoneNumber == phoneNumber);
        if (user is not null)
        {
            var otp = await SmsSecurityService.GenerateAndStoreOtpAsync(phoneNumber, OtpPurpose.PasswordReset, clientIp);
            var sent = await SmsSender.SendAsync(phoneNumber, $"کد بازیابی رمز عبور گلدکس: {otp}");
            if (!sent)
            {
                _errorMessage = "خطا در ارسال پیامک. لطفاً بعداً مجدداً تلاش فرمایید.";
                return;
            }
        }

        // 3. Generic feedback whether user exists or not (concise message: کد تایید ارسال گردید.)
        var resetUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri(ClientRoutes.Accounts.ResetPassword).AbsoluteUri,
            new Dictionary<string, object?> { ["phoneNumber"] = phoneNumber });

        RedirectManager.RedirectToWithStatus(resetUrl, "کد تایید ارسال گردید.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "لطفا {0} را وارد کنید")]
        [Display(Name = "شماره تلفن همراه")]
        [RegularExpression(@"^09\d{9}$", ErrorMessage = "شماره تلفن همراه باید با 09 شروع شده و ۱۱ رقم باشد")]
        public string PhoneNumber { get; set; } = "";
    }
}
