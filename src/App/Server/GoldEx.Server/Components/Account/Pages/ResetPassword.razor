@attribute [Route(ClientRoutes.Accounts.ResetPassword)]

@inject IdentityRedirectManager RedirectManager
@inject UserManager<AppUser> UserManager
@inject ISmsSecurityService SmsSecurityService
@inject NavigationManager NavigationManager
@layout EmptyBoxLayout

<PageTitle>بازنشانی رمز عبور</PageTitle>

<MudStack AlignItems="AlignItems.Center">
    <MudItem>
        <span class="brand-text" dir="ltr">GoldEx</span>
    </MudItem>
    <MudItem>
        <MudText Align="Align.Center" Typo="Typo.h5" GutterBottom="true">بازنشانی رمز عبور</MudText>
    </MudItem>
    <MudItem>
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
            کد تایید ۶ رقمی پیامک‌شده به همراه رمز عبور جدید خود را وارد نمایید.
        </MudText>
    </MudItem>
</MudStack>

<EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password">
    <DataAnnotationsValidator />

    <MudGrid Class="mt-2">
        <MudItem xs="12">
            <MudStaticTextField For="@(() => Input.PhoneNumber)" @bind-Value="Input.PhoneNumber"
                                Label="شماره تلفن همراه" Variant="Variant.Outlined" ReadOnly="@(!string.IsNullOrEmpty(PhoneNumberQuery))"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "tel" }, { "aria-required", "true" }, { "dir", "ltr" } } )" />
        </MudItem>
        <MudItem xs="12">
            <MudStaticTextField For="@(() => Input.Code)" @bind-Value="Input.Code"
                                Label="کد تایید ۶ رقمی" Variant="Variant.Outlined" Placeholder="123456"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "one-time-code" }, { "aria-required", "true" }, { "dir", "ltr" }, { "maxlength", "6" } } )" />
        </MudItem>
        <MudItem xs="12">
            <MudStaticTextField For="@(() => Input.Password)" @bind-Value="Input.Password"
                                Label="رمز عبور جدید" InputType="InputType.Password" Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" }, { "dir", "ltr" } } )" />
        </MudItem>
        <MudItem xs="12">
            <MudStaticTextField For="@(() => Input.ConfirmPassword)" @bind-Value="Input.ConfirmPassword"
                                Label="تکرار رمز عبور جدید" InputType="InputType.Password" Variant="Variant.Outlined"
                                UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "new-password" }, { "aria-required", "true" }, { "dir", "ltr" } } )" />
        </MudItem>

        <MudItem xs="12" Class="mb-0">
            <StatusMessage Message="@ErrorMessage" Severity="Severity.Error" />
        </MudItem>

        <MudItem xs="12" Class="mt-0">
            <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" FormAction="FormAction.Submit">ثبت رمز عبور جدید</MudStaticButton>
        </MudItem>
    </MudGrid>
</EditForm>

<MudGrid Class="mt-2">
    <MudItem xs="6" Class="text-right">
        <MudLink Href="@ClientRoutes.Accounts.ForgotPassword">ارسال مجدد کد تایید</MudLink>
    </MudItem>
    <MudItem xs="6" Class="text-left">
        <MudLink Href="@ClientRoutes.Accounts.Login">ورود به سامانه</MudLink>
    </MudItem>
</MudGrid>

@code {
    private string? _customErrorMessage;
    private IEnumerable<IdentityError>? _identityErrors;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = "phoneNumber")]
    private string? PhoneNumberQuery { get; set; }

    private string? ErrorMessage => _customErrorMessage ?? (_identityErrors is null ? null : $"خطا: {string.Join(", ", _identityErrors.Select(e => e.Description))}");

    protected override void OnInitialized()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !string.IsNullOrEmpty(PhoneNumberQuery))
        {
            Input.PhoneNumber = PhoneNumberQuery;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        _customErrorMessage = null;
        _identityErrors = null;

        var phone = Input.PhoneNumber?.Trim() ?? "";

        // 1. Verify OTP with SmsSecurityService
        var verifyResult = SmsSecurityService.VerifyOtp(phone, Input.Code, OtpPurpose.PasswordReset);
        if (!verifyResult.Success)
        {
            _customErrorMessage = verifyResult.ErrorMessage ?? "کد تایید وارد شده نامعتبر است.";
            return;
        }

        // 2. Lookup user and reset password
        var user = await UserManager.Users.FirstOrDefaultAsync(u => u.PhoneNumber == phone);
        if (user is null)
        {
            // Do not reveal user existence; redirect cleanly
            RedirectManager.RedirectTo(ClientRoutes.Accounts.ResetPasswordConfirmation);
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);

        if (result.Succeeded)
        {
            await UserManager.UpdateSecurityStampAsync(user);
            RedirectManager.RedirectTo(ClientRoutes.Accounts.ResetPasswordConfirmation);
        }
        else
        {
            _identityErrors = result.Errors;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "لطفا {0} را وارد کنید")]
        [Display(Name = "شماره تلفن همراه")]
        [RegularExpression(@"^09\d{9}$", ErrorMessage = "شماره تلفن همراه باید با 09 شروع شده و ۱۱ رقم باشد")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "لطفا {0} را وارد کنید")]
        [Display(Name = "کد تایید")]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "کد تایید باید ۶ رقم باشد")]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "کد تایید باید فقط شامل ارقام انگلیسی باشد")]
        public string Code { get; set; } = "";

        [Required(ErrorMessage = "لطفا {0} را وارد کنید")]
        [Display(Name = "رمز عبور جدید")]
        [StringLength(100, ErrorMessage = "طول {0} حداقل باید {2} و حداکثر {1} حرف باشد.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "تکرار رمز عبور جدید")]
        [Compare("Password", ErrorMessage = "رمز عبور با تکرار آن مطابقت ندارد")]
        public string ConfirmPassword { get; set; } = "";
    }
}
