@attribute [Route(ClientRoutes.Accounts.ForgotPasswordConfirmation)]
@layout EmptyBoxLayout

<PageTitle>تایید فراموشی رمز عبور</PageTitle>

<MudStack AlignItems="AlignItems.Center">
    <MudItem>
        <span class="brand-text" dir="ltr">GoldEx</span>
    </MudItem>
    <MudItem>
        <MudText Align="Align.Center" Typo="Typo.h5" GutterBottom="true">فراموشی رمز عبور</MudText>
    </MudItem>
    <MudItem>
        <MudText Typo="Typo.body1" Align="Align.Center">کد تایید جهت بازنشانی رمز عبور به شماره تلفن همراه شما پیامک شد.</MudText>
    </MudItem>

    <MudItem xs="12" Class="mt-2">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Href="@ClientRoutes.Accounts.ResetPassword">ورود کد تایید و تغییر رمز</MudButton>
    </MudItem>

    <MudItem xs="12" Class="mt-1">
        <MudLink Href="@ClientRoutes.Accounts.Login">بازگشت به صفحه ورود</MudLink>
    </MudItem>
</MudStack>